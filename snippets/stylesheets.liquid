{%- comment -%}
  Final runtime contract. This deliberately lives in an existing core snippet so
  Shopify's GitHub theme sync cannot leave casing/type fixes dependent on stale
  section-editor values. The World archive fallback is generated from the actual
  All collection, so an existing saved five-block About section still renders six.
{%- endcomment -%}
<style id="fp-runtime-contract">
  .fp-hero__world,
  .fp-site-header .fp-nav__links,
  .fp-site-header .fp-nav__links a,
  .fp-site-header .fp-mobile-menu__links,
  .fp-site-header .fp-mobile-menu__links a,
  .fp-footer a{
    text-transform:none!important;
  }
  .fp-site-header .fp-gigi-editor-placeholder{display:none!important;}
  .fp-collection__title,
  .fp-collection__title h2{text-align:center!important;}
  .fp-story__title,
  .fp-films h2,
  .fp-at-home__title,
  .fp-newsletter h2{text-align:left!important;}
</style>

{% if template.name == 'page' and page.handle == 'about' %}
  {% assign fp_world_catalog = collections['all'] %}
  {% if fp_world_catalog != blank and fp_world_catalog.products_count > 0 %}
    <script id="fp-world-catalog-data" type="application/json">
      [
        {% for fp_product in fp_world_catalog.products limit: 20 %}
          {
            "url": {{ fp_product.url | json }},
            "title": {{ fp_product.title | json }},
            "image": {{ fp_product.featured_image | image_url: width: 1400 | json }},
            "alt": {{ fp_product.featured_image.alt | default: fp_product.title | json }},
            "note": {% if fp_product.handle contains '-a3' %}"LIMITED EDITION / A3"{% elsif fp_product.handle contains '-a4' %}"LIMITED EDITION / A4"{% else %}"LIMITED EDITION ART PRINT"{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
{% endif %}

<script>
  (() => {
    const normalizedPath = (value) => {
      try { return new URL(value, window.location.origin).pathname.replace(/\/$/, ''); }
      catch (_) { return String(value || '').replace(/\?.*$/, '').replace(/\/$/, ''); }
    };

    const ensureWorldArchiveSix = () => {
      const gallery = document.querySelector('.fp-content-page--about .fp-world__gallery');
      const source = document.getElementById('fp-world-catalog-data');
      if (!gallery || !source) return;

      let catalog;
      try { catalog = JSON.parse(source.textContent); } catch (_) { return; }
      if (!Array.isArray(catalog) || !catalog.length) return;

      const existingPaths = new Set(
        [...gallery.querySelectorAll('.fp-world-card__link')]
          .map((link) => normalizedPath(link.getAttribute('href')))
          .filter(Boolean)
      );

      while (gallery.querySelectorAll('.fp-world-card').length < 6) {
        const item = catalog.find((candidate) => {
          return candidate?.url && candidate?.title && candidate?.image && !existingPaths.has(normalizedPath(candidate.url));
        });
        if (!item) break;

        const cardNumber = String(gallery.querySelectorAll('.fp-world-card').length + 1).padStart(2, '0');
        const article = document.createElement('article');
        article.className = 'fp-world-card';
        article.dataset.index = cardNumber;

        const link = document.createElement('a');
        link.className = 'fp-world-card__link';
        link.href = item.url;
        link.setAttribute('aria-label', `View ${item.title}`);

        const media = document.createElement('div');
        media.className = 'fp-world-card__media';
        const image = document.createElement('img');
        image.src = item.image;
        image.alt = item.alt || item.title;
        image.loading = 'lazy';
        image.decoding = 'async';
        media.appendChild(image);

        const open = document.createElement('span');
        open.className = 'fp-world-card__open';
        open.textContent = 'view print ↗';
        media.appendChild(open);

        const caption = document.createElement('div');
        caption.className = 'fp-world-card__caption';
        const number = document.createElement('span');
        number.textContent = cardNumber;
        const title = document.createElement('h3');
        title.textContent = item.title;
        const note = document.createElement('p');
        note.textContent = item.note || 'LIMITED EDITION ART PRINT';
        caption.append(number, title, note);

        link.append(media, caption);
        article.appendChild(link);
        gallery.appendChild(article);
        existingPaths.add(normalizedPath(item.url));
      }
    };

    const normalizeFridayRuntime = () => {
      document.querySelectorAll('.fp-site-header a[href*="/pages/about"], .fp-footer a[href*="/pages/about"]').forEach((link) => {
        const text = link.textContent.trim().replace(/\s+/g, ' ');
        if (/^(?:world of )?gigi$/i.test(text)) link.textContent = 'world of GiGi';
      });

      const worldLine = document.querySelector('.fp-hero__world');
      if (worldLine && /^from the world of gigi$/i.test(worldLine.textContent.trim())) {
        worldLine.textContent = 'FROM THE WORLD OF GiGi';
      }

      const newsletterTitle = document.querySelector('.fp-newsletter h2');
      if (newsletterTitle && /^postcards from gigi$/i.test(newsletterTitle.textContent.trim())) {
        newsletterTitle.textContent = 'postcards from GiGi';
      }

      const titleSize = window.innerWidth <= 749 ? '38px' : (window.innerWidth <= 1100 ? '48px' : '52px');
      document.querySelectorAll('.fp-collection__title h2, .fp-story__title, .fp-films h2, .fp-at-home__title, .fp-newsletter h2').forEach((title) => {
        title.style.setProperty('font-family', 'var(--fp-display-font, Georgia, "Times New Roman", serif)', 'important');
        title.style.setProperty('font-style', 'normal', 'important');
        title.style.setProperty('font-weight', '700', 'important');
        title.style.setProperty('font-size', titleSize, 'important');
        title.style.setProperty('line-height', '.92', 'important');
        title.style.setProperty('letter-spacing', '-.045em', 'important');
        title.style.setProperty('text-transform', 'none', 'important');
      });

      ensureWorldArchiveSix();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', normalizeFridayRuntime, { once: true });
    } else {
      normalizeFridayRuntime();
    }

    document.addEventListener('shopify:section:load', normalizeFridayRuntime);
    let fpRuntimeResizeTimer;
    window.addEventListener('resize', () => {
      window.clearTimeout(fpRuntimeResizeTimer);
      fpRuntimeResizeTimer = window.setTimeout(normalizeFridayRuntime, 80);
    }, { passive: true });
  })();
</script>

{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#FFFDF8">

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description

  if seo_description == blank and shop.brand.short_description != blank
    assign seo_description = shop.brand.short_description
  endif

  if request.page_type == 'collection' and collection.handle == 'all'
    assign seo_title = 'Shop All Prints'
    if seo_description == blank
      assign seo_description = 'Shop limited-edition Friday Prints, made to order in Egypt.'
    endif
  elsif request.page_type == 'cart'
    assign seo_title = 'Your Cart'
  elsif request.page_type == 'search'
    assign seo_title = 'Search Prints'
    if seo_description == blank
      assign seo_description = 'Search the Friday Prints collection of limited-edition art prints, made to order in Cairo.'
    endif
  endif

  case request.path
    when '/'
      if seo_description == blank
        assign seo_description = 'Limited-edition art prints, made to order in Egypt. Meet GiGi and shop Friday Prints.'
      endif
    when '/pages/about'
      assign seo_title = 'World of GiGi'
      if seo_description == blank
        assign seo_description = 'Meet GiGi — the long-necked character behind Friday Prints, imagined in Cairo and collected across limited-edition art prints.'
      endif
    when '/pages/info'
      assign seo_title = 'Print Guide'
      if seo_description == blank
        assign seo_description = 'Everything to know about Friday Prints: edition sizes, premium matte paper, removable mounts, tinted borders, care and delivery.'
      endif
    when '/pages/faq'
      assign seo_title = 'FAQ'
      if seo_description == blank
        assign seo_description = 'Answers about Friday Prints editions, paper, mounts, delivery, returns and damaged orders.'
      endif
    when '/pages/contact'
      assign seo_title = 'Contact'
      if seo_description == blank
        assign seo_description = 'Contact Friday Prints about an artwork, an order or choosing the right limited-edition print.'
      endif
  endcase

  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.name
  assign og_image = page_image

  if og_image == blank and shop.brand.cover_image != blank
    assign og_image = shop.brand.cover_image
  elsif og_image == blank and shop.brand.square_logo != blank
    assign og_image = shop.brand.square_logo
  elsif og_image == blank and shop.brand.logo != blank
    assign og_image = shop.brand.logo
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{% if seo_description != blank %}
  <meta name="description" content="{{ seo_description | escape }}">
{% endif %}

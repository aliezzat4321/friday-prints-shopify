<section class="fp-section fp-services" id="FridayServices-{{ section.id }}" style="--fp-services-bg: {{ section.settings.background_color }};">
  <div class="fp-shell fp-services__grid">
    {% for block in section.blocks %}
      <article class="fp-service" {{ block.shopify_attributes }}>
        <div>
          {% if block.settings.icon != blank %}<span class="fp-service__icon" aria-hidden="true">{{ block.settings.icon }}</span>{% endif %}
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Friday services",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FBF1E4" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / symbol", "default": "🚚" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "DELIVERY ACROSS EGYPT" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Standard delivery across Egypt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday services",
      "blocks": [
        { "type": "service", "settings": { "icon": "🚚", "heading": "DELIVERY ACROSS EGYPT", "text": "Standard delivery across Egypt." } },
        { "type": "service", "settings": { "icon": "🎁", "heading": "PERFECT FOR GIFTING", "text": "Wrap happiness. It suits every wall." } },
        { "type": "service", "settings": { "icon": "✉", "heading": "YOU'VE GOT MAIL", "text": "Carefully packed prints, on their way to you." } },
        { "type": "service", "settings": { "icon": "●", "heading": "HERE TO HELP", "text": "Questions? Just send us a message." } }
      ]
    }
  ]
}
{% endschema %}
{% assign footer_column_count = section.blocks.size %}
{% if footer_column_count < 1 %}{% assign footer_column_count = 1 %}{% endif %}
<footer class="fp-footer" id="FridayFooter-{{ section.id }}" style="--fp-footer-gigi-desktop:{{ section.settings.gigi_size_desktop }}px;--fp-footer-gigi-mobile:{{ section.settings.gigi_size_mobile }}px;--fp-footer-columns:{{ footer_column_count }};--fp-footer-link-desktop:{{ section.settings.link_size_desktop }}px;--fp-footer-link-mobile:{{ section.settings.link_size_mobile }}px;--fp-footer-heading-desktop:{{ section.settings.heading_size_desktop }}px;--fp-footer-heading-mobile:{{ section.settings.heading_size_mobile }}px;">
  <style>
    #FridayFooter-{{ section.id }} .fp-footer__grid{grid-template-columns:1.55fr repeat(var(--fp-footer-columns),minmax(0,1fr));gap:34px;padding:52px 46px 44px}
    #FridayFooter-{{ section.id }} .fp-footer__brand{font-size:clamp(48px,4.6vw,72px)}
    #FridayFooter-{{ section.id }} .fp-footer__brand-block>p{font-size:13px;margin-top:20px}
    #FridayFooter-{{ section.id }} .fp-footer__col{gap:13px;padding-top:4px}
    #FridayFooter-{{ section.id }} .fp-footer__col strong{font-size:var(--fp-footer-heading-desktop);margin-bottom:7px}
    #FridayFooter-{{ section.id }} .fp-footer__col a,#FridayFooter-{{ section.id }} .fp-footer__col>span{font-size:var(--fp-footer-link-desktop);line-height:1.45}
    #FridayFooter-{{ section.id }} .fp-footer__social{display:flex;flex-wrap:wrap;gap:16px;margin-top:22px}
    #FridayFooter-{{ section.id }} .fp-footer__social a,#FridayFooter-{{ section.id }} .fp-footer__social>span{display:inline-flex;align-items:center;gap:9px;color:inherit;text-decoration:none;font:700 14px/1 "Courier New",monospace;text-transform:lowercase}
    #FridayFooter-{{ section.id }} .fp-footer__social svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.7;flex:0 0 auto}
    #FridayFooter-{{ section.id }} .fp-footer__social a:hover span{text-decoration:underline;text-underline-offset:4px}
    #FridayFooter-{{ section.id }} .fp-footer__email{display:inline-block;margin-top:15px;color:inherit;text-decoration:none;font:12px/1.4 "Courier New",monospace}
    #FridayFooter-{{ section.id }} .fp-footer__email:hover{text-decoration:underline;text-underline-offset:4px}
    #FridayFooter-{{ section.id }} .fp-footer__gigi-wrap{margin-top:26px;min-height:88px}
    #FridayFooter-{{ section.id }} .fp-footer__gigi-wrap span{font-size:10.5px}
    #FridayFooter-{{ section.id }} .fp-footer__bottom{font-size:10px}
    @media(max-width:1100px) and (min-width:750px){
      #FridayFooter-{{ section.id }} .fp-footer__grid{grid-template-columns:1.25fr repeat(2,minmax(0,1fr));row-gap:32px;padding:46px 28px 40px}
      #FridayFooter-{{ section.id }} .fp-footer__brand-block{grid-row:span 2}
    }
    @media(max-width:749px){
      #FridayFooter-{{ section.id }} .fp-footer__grid{grid-template-columns:1fr 1fr;gap:0;padding:36px 20px 26px}
      #FridayFooter-{{ section.id }} .fp-footer__brand-block{grid-column:1/-1;grid-row:auto;border-bottom:1px solid var(--fp-line);padding-bottom:26px;margin-bottom:4px}
      #FridayFooter-{{ section.id }} .fp-footer__brand{font-size:48px}
      #FridayFooter-{{ section.id }} .fp-footer__brand-block>p{font-size:11px;margin-top:16px}
      #FridayFooter-{{ section.id }} .fp-footer__social{margin-top:18px}
      #FridayFooter-{{ section.id }} .fp-footer__social a,#FridayFooter-{{ section.id }} .fp-footer__social>span{font-size:13px;gap:8px}
      #FridayFooter-{{ section.id }} .fp-footer__social svg{width:22px;height:22px}
      #FridayFooter-{{ section.id }} .fp-footer__email{font-size:11px;margin-top:13px}
      #FridayFooter-{{ section.id }} .fp-footer__gigi-wrap{margin-top:20px;min-height:78px}
      #FridayFooter-{{ section.id }} .fp-footer__col{min-height:132px;padding:21px 12px 18px 0}
      #FridayFooter-{{ section.id }} .fp-footer__col strong{font-size:var(--fp-footer-heading-mobile)}
      #FridayFooter-{{ section.id }} .fp-footer__col a,#FridayFooter-{{ section.id }} .fp-footer__col>span{font-size:var(--fp-footer-link-mobile);line-height:1.5}
      #FridayFooter-{{ section.id }} .fp-footer__bottom{font-size:9px}
    }
  </style>
  <div class="fp-shell fp-footer__grid">
    <div class="fp-footer__brand-block">
      {% if section.settings.brand_text != blank %}<div class="fp-footer__brand">{{ section.settings.brand_text }}</div>{% endif %}
      {% if section.settings.tagline != blank %}<p>{{ section.settings.tagline }}</p>{% endif %}
      {% if section.settings.show_instagram %}
        <div class="fp-footer__social">
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.instagram_label | escape }}">{% else %}<span>{% endif %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.4" cy="6.7" r="1"></circle></svg>
            <span>{{ section.settings.instagram_label }}</span>
          {% if section.settings.instagram_url != blank %}</a>{% else %}</span>{% endif %}
        </div>
      {% endif %}
      {% if section.settings.support_email != blank %}<a class="fp-footer__email" href="mailto:{{ section.settings.support_email | escape }}">{{ section.settings.email_label }} → {{ section.settings.support_email }}</a>{% endif %}
      {% if section.settings.gigi_icon != blank or section.settings.location_text != blank or request.design_mode %}
        <div class="fp-footer__gigi-wrap">
          {% if section.settings.gigi_icon != blank %}
            {{ section.settings.gigi_icon | image_url: width: 460 | image_tag: class: 'fp-footer__gigi', loading: 'lazy', widths: '100,160,240,340,460', sizes: '(max-width: 749px) 90px, 130px', alt: section.settings.gigi_alt }}
          {% elsif request.design_mode %}
            <span class="fp-gigi-editor-placeholder">Add GiGi</span>
          {% endif %}
          {% if section.settings.location_text != blank %}<span>{{ section.settings.location_text }}</span>{% endif %}
        </div>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      <nav class="fp-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
        {% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong>{% endif %}
        {% if block.settings.menu != blank %}
          {% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
        {% else %}
          {% if block.settings.link_1_label != blank %}{% if block.settings.link_1_url != blank %}<a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a>{% else %}<span>{{ block.settings.link_1_label }}</span>{% endif %}{% endif %}
          {% if block.settings.link_2_label != blank %}{% if block.settings.link_2_url != blank %}<a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a>{% else %}<span>{{ block.settings.link_2_label }}</span>{% endif %}{% endif %}
          {% if block.settings.link_3_label != blank %}{% if block.settings.link_3_url != blank %}<a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a>{% else %}<span>{{ block.settings.link_3_label }}</span>{% endif %}{% endif %}
          {% if block.settings.link_4_label != blank %}{% if block.settings.link_4_url != blank %}<a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a>{% else %}<span>{{ block.settings.link_4_label }}</span>{% endif %}{% endif %}
        {% endif %}
      </nav>
    {% endfor %}
  </div>

  <div class="fp-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name }}</span>
    <span>{{ section.settings.bottom_center }}</span>
    <span>{{ section.settings.bottom_right }}</span>
  </div>
</footer>
{% schema %}
{
  "name": "Friday footer",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "textarea", "id": "brand_text", "label": "Brand text", "default": "friday\nprints :)" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "made for long weekends & loud lines." },
    { "type": "text", "id": "location_text", "label": "GiGi caption / location", "default": "CAIRO → EVERYWHERE" },
    { "type": "image_picker", "id": "gigi_icon", "label": "GiGi image" },
    { "type": "text", "id": "gigi_alt", "label": "GiGi alt text", "default": "GiGi" },
    { "type": "range", "id": "gigi_size_desktop", "label": "GiGi size — desktop", "min": 50, "max": 130, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "gigi_size_mobile", "label": "GiGi size — mobile", "min": 40, "max": 90, "step": 5, "unit": "px", "default": 65 },
    { "type": "header", "content": "Contact" },
    { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram", "default": true },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "@fridayprints.art" },
    { "type": "text", "id": "support_email", "label": "Support email" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "questions" },
    { "type": "header", "content": "Footer typography" },
    { "type": "range", "id": "heading_size_desktop", "label": "Column heading — desktop", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_mobile", "label": "Column heading — mobile", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "link_size_desktop", "label": "Links — desktop", "min": 14, "max": 19, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "link_size_mobile", "label": "Links — mobile", "min": 12, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "FRIDAY PRINTS" },
    { "type": "text", "id": "bottom_center", "label": "Center text", "default": "MADE IN CAIRO" },
    { "type": "text", "id": "bottom_right", "label": "Right text", "default": "WITH ♥ & LOUD LINES" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Footer column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP" },
        { "type": "link_list", "id": "menu", "label": "Shopify navigation menu", "info": "Preferred handoff control. If blank, fallback links below are used." },
        { "type": "text", "id": "link_1_label", "label": "Fallback link 1 label" },
        { "type": "url", "id": "link_1_url", "label": "Fallback link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Fallback link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Fallback link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Fallback link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Fallback link 3 URL" },
        { "type": "text", "id": "link_4_label", "label": "Fallback link 4 label" },
        { "type": "url", "id": "link_4_url", "label": "Fallback link 4 URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "SHOP", "link_1_label": "shop all prints" } },
        { "type": "column", "settings": { "heading": "EXPLORE", "link_1_label": "world of GiGi" } },
        { "type": "column", "settings": { "heading": "HELP", "link_1_label": "print guide", "link_2_label": "faq", "link_3_label": "shipping" } },
        { "type": "column", "settings": { "heading": "LEGAL", "link_1_label": "privacy" } }
      ]
    }
  ]
}
{% endschema %}
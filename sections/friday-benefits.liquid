<section class="fp-section fp-benefits" id="FridayBenefits-{{ section.id }}" style="background:{{ section.settings.background_color }};">
  <div class="fp-shell fp-benefits__grid">
    {% for block in section.blocks %}
      <article class="fp-benefit" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}<div class="fp-benefit__icon" aria-hidden="true">{{ block.settings.icon }}</div>{% endif %}
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
        {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Friday benefits",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFDF8" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / symbol", "default": "✹" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "LIMITED EDITIONS" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Each print is part of a limited numbered run." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "✹", "heading": "LIMITED EDITIONS", "text": "Each print is part of a limited numbered run." } },
        { "type": "benefit", "settings": { "icon": "✌", "heading": "MADE TO ORDER", "text": "Printed especially for you, with love and care." } },
        { "type": "benefit", "settings": { "icon": "♥", "heading": "MADE IN EGYPT", "text": "Locally printed. Thoughtfully packaged." } },
        { "type": "benefit", "settings": { "icon": "▣", "heading": "MADE TO LAST", "text": "Printed on premium matte paper with a removable mount." } }
      ]
    }
  ]
}
{% endschema %}

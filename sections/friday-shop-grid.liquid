{% liquid
  assign products_per_page = section.settings.products_per_page
  assign shop_heading = section.settings.heading
  if shop_heading == blank
    assign shop_heading = collection.title
  endif
%}

<section
  class="fp-shop"
  id="FridayShop-{{ section.id }}"
  style="--fp-shop-bg:{{ section.settings.background_color }};--fp-shop-accent:{{ section.settings.accent_color }};--fp-shop-heading:{{ section.settings.heading_size_desktop }}px;--fp-shop-heading-mobile:{{ section.settings.heading_size_mobile }}px;--fp-shop-columns:{{ section.settings.columns_desktop }};"
>
  <style>
    #FridayShop-{{ section.id }}{background:var(--fp-shop-bg);color:var(--fp-ink);min-height:60vh}
    #FridayShop-{{ section.id }} *{box-sizing:border-box}

    /* The catalogue should arrive quickly: on non-home pages the navigation is
       deliberately tighter so artwork enters the first viewport sooner. */
    @media(min-width:750px){
      body:has(#FridayShop-{{ section.id }}) .fp-nav{height:96px!important}
    }

    #FridayShop-{{ section.id }} .fp-shop__head{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:44px;align-items:end;padding:40px var(--fp-page-gutter,46px) 28px;border-bottom:1px solid var(--fp-line)}
    #FridayShop-{{ section.id }} .fp-shop__eyebrow{margin:0 0 10px;color:var(--fp-red-text,var(--fp-red));font:700 11px/1 "Courier New",monospace;letter-spacing:.08em;text-transform:uppercase}
    #FridayShop-{{ section.id }} h1{margin:0;font-family:Georgia,"Times New Roman",serif;font-weight:700;font-size:min(var(--fp-shop-heading),clamp(80px,6.1vw,88px));line-height:.84;letter-spacing:-.055em;text-transform:lowercase}
    #FridayShop-{{ section.id }} .fp-shop__intro{justify-self:end;max-width:39ch;padding-bottom:3px;font:13px/1.5 "Courier New",monospace}
    #FridayShop-{{ section.id }} .fp-shop__intro p{margin:0}

    #FridayShop-{{ section.id }} .fp-shop__tools{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:46px;padding:10px var(--fp-page-gutter,46px);border-bottom:1px solid var(--fp-line);font:700 10px/1 "Courier New",monospace;text-transform:uppercase;letter-spacing:.065em}
    #FridayShop-{{ section.id }} .fp-shop__count{white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop__sort{display:flex;align-items:center;gap:7px}
    #FridayShop-{{ section.id }} .fp-shop__sort label{white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop__sort select{appearance:none;-webkit-appearance:none;border:0;border-bottom:1px solid color-mix(in srgb,var(--fp-ink) 55%,transparent);border-radius:0;background:transparent;color:inherit;padding:4px 20px 4px 2px;font:700 10px/1.2 "Courier New",monospace;text-transform:uppercase;letter-spacing:.035em;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 8px) 50%,calc(100% - 4px) 50%;background-size:4px 4px,4px 4px;background-repeat:no-repeat}

    #FridayShop-{{ section.id }} .fp-shop__grid{display:grid;grid-template-columns:repeat(var(--fp-shop-columns),minmax(0,1fr));column-gap:28px;row-gap:44px;padding:34px var(--fp-page-gutter,46px) 60px}
    #FridayShop-{{ section.id }} .fp-shop-card{display:block;min-width:0;color:inherit;text-decoration:none}
    #FridayShop-{{ section.id }} .fp-shop-card__media{position:relative;aspect-ratio:.707;overflow:hidden;background:color-mix(in srgb,var(--fp-shop-bg) 85%,#fff)}
    #FridayShop-{{ section.id }} .fp-shop-card__media img,#FridayShop-{{ section.id }} .fp-shop-card__media svg{display:block;width:100%;height:100%;object-fit:contain;transition:transform .35s ease}
    #FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__media img{transform:scale(1.012)}
    #FridayShop-{{ section.id }} .fp-shop-card__badge{position:absolute;top:11px;left:11px;padding:7px 9px;background:var(--fp-red-text,var(--fp-shop-accent));color:#fff;font:700 9px/1 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
    #FridayShop-{{ section.id }} .fp-shop-card__meta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:start;padding-top:11px;border-top:1px solid transparent;transition:border-color .2s ease}
    #FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__meta{border-top-color:var(--fp-ink)}
    #FridayShop-{{ section.id }} .fp-shop-card__info{min-width:0}
    #FridayShop-{{ section.id }} .fp-shop-card h2{margin:0;font:700 12px/1.35 "Courier New",monospace;text-transform:lowercase}
    #FridayShop-{{ section.id }} .fp-shop-card__sizes{display:block;margin-top:4px;color:color-mix(in srgb,var(--fp-ink) 58%,transparent);font:700 9px/1.3 "Courier New",monospace;text-transform:uppercase;letter-spacing:.055em}
    #FridayShop-{{ section.id }} .fp-shop-card__price{margin:0;font:11px/1.35 "Courier New",monospace;white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop-card__edition{grid-column:1/-1;margin-top:-5px;color:color-mix(in srgb,var(--fp-ink) 56%,transparent);font:9px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.04em}

    #FridayShop-{{ section.id }} .fp-shop__pagination{display:flex;justify-content:center;align-items:center;gap:8px;padding:0 24px 56px;font:700 12px/1 "Courier New",monospace}
    #FridayShop-{{ section.id }} .fp-shop__pagination a,#FridayShop-{{ section.id }} .fp-shop__pagination span{min-width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--fp-ink);color:inherit;text-decoration:none}
    #FridayShop-{{ section.id }} .fp-shop__pagination .is-current{background:var(--fp-ink);color:#fff}
    #FridayShop-{{ section.id }} .fp-shop__empty{padding:80px 46px;text-align:center;font:14px/1.5 "Courier New",monospace}

    /* Small desktop / landscape tablet: keep four columns so cards do not become
       larger as the screen becomes narrower. */
    @media(max-width:1100px) and (min-width:901px){
      body:has(#FridayShop-{{ section.id }}) .fp-nav{height:88px!important}
      #FridayShop-{{ section.id }} .fp-shop__head{gap:28px;padding:36px 30px 26px}
      #FridayShop-{{ section.id }} h1{font-size:min(var(--fp-shop-heading),72px)}
      #FridayShop-{{ section.id }} .fp-shop__intro{font-size:12px;max-width:34ch}
      #FridayShop-{{ section.id }} .fp-shop__tools{padding-inline:30px}
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:repeat(4,minmax(0,1fr));column-gap:18px;row-gap:36px;padding:30px 30px 56px}
      #FridayShop-{{ section.id }} .fp-shop-card__meta{grid-template-columns:1fr;gap:3px;padding-top:9px}
      #FridayShop-{{ section.id }} .fp-shop-card h2{font-size:11px}
      #FridayShop-{{ section.id }} .fp-shop-card__sizes{font-size:8.5px;margin-top:3px}
      #FridayShop-{{ section.id }} .fp-shop-card__price{font-size:10px}
      #FridayShop-{{ section.id }} .fp-shop-card__edition{margin-top:2px}
    }

    /* Portrait tablet: three calm columns, smaller masthead, stacked metadata. */
    @media(max-width:900px) and (min-width:750px){
      body:has(#FridayShop-{{ section.id }}) .fp-nav{height:82px!important}
      #FridayShop-{{ section.id }} .fp-shop__head{grid-template-columns:minmax(0,1.25fr) minmax(220px,.75fr);gap:24px;padding:34px 28px 24px}
      #FridayShop-{{ section.id }} h1{font-size:min(var(--fp-shop-heading),68px)}
      #FridayShop-{{ section.id }} .fp-shop__eyebrow{font-size:10px;margin-bottom:8px}
      #FridayShop-{{ section.id }} .fp-shop__intro{font-size:11px;max-width:30ch;padding-bottom:2px}
      #FridayShop-{{ section.id }} .fp-shop__tools{min-height:44px;padding:9px 28px;font-size:9px}
      #FridayShop-{{ section.id }} .fp-shop__sort select{font-size:9px}
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:repeat(3,minmax(0,1fr));column-gap:20px;row-gap:34px;padding:28px 28px 54px}
      #FridayShop-{{ section.id }} .fp-shop-card__meta{grid-template-columns:1fr;gap:3px;padding-top:9px}
      #FridayShop-{{ section.id }} .fp-shop-card h2{font-size:10.5px}
      #FridayShop-{{ section.id }} .fp-shop-card__sizes{font-size:8.5px;margin-top:3px}
      #FridayShop-{{ section.id }} .fp-shop-card__price{font-size:9.5px}
      #FridayShop-{{ section.id }} .fp-shop-card__edition{font-size:8px;margin-top:2px}
    }

    /* Mobile remains a true catalogue: two columns even at 320px. */
    @media(max-width:749px){
      #FridayShop-{{ section.id }} .fp-shop__head{grid-template-columns:1fr;gap:14px;padding:32px 20px 22px}
      #FridayShop-{{ section.id }} h1{font-size:min(var(--fp-shop-heading-mobile),clamp(54px,14vw,58px))}
      #FridayShop-{{ section.id }} .fp-shop__eyebrow{font-size:9px;margin-bottom:8px}
      #FridayShop-{{ section.id }} .fp-shop__intro{justify-self:start;max-width:32ch;font-size:11px;line-height:1.45;padding-bottom:0}
      #FridayShop-{{ section.id }} .fp-shop__tools{min-height:44px;padding:10px var(--fp-page-gutter,20px);font-size:9.5px}
      #FridayShop-{{ section.id }} .fp-shop__sort{gap:5px}
      #FridayShop-{{ section.id }} .fp-shop__sort label{font-size:0}
      #FridayShop-{{ section.id }} .fp-shop__sort label::after{content:'SORT —';font-size:9.5px}
      #FridayShop-{{ section.id }} .fp-shop__sort select{font-size:9.5px;max-width:138px;padding-right:18px}
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:10px;row-gap:28px;padding:22px 10px 46px}
      #FridayShop-{{ section.id }} .fp-shop-card__meta{grid-template-columns:1fr;gap:3px;padding-top:8px}
      #FridayShop-{{ section.id }} .fp-shop-card h2{font-size:11px;line-height:1.3}
      #FridayShop-{{ section.id }} .fp-shop-card__sizes{font-size:8.5px;margin-top:3px}
      #FridayShop-{{ section.id }} .fp-shop-card__price{font-size:10px}
      #FridayShop-{{ section.id }} .fp-shop-card__edition{font-size:9px;margin-top:2px}
      #FridayShop-{{ section.id }} .fp-shop-card__badge{top:6px;left:6px;font-size:8px;padding:6px 7px}
      #FridayShop-{{ section.id }} .fp-shop__pagination{padding-bottom:46px}
    }

    @media(prefers-reduced-motion:reduce){#FridayShop-{{ section.id }} .fp-shop-card__media img{transition:none}#FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__media img{transform:none}}
  </style>

  <div class="fp-shop__head">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="fp-shop__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ shop_heading }}</h1>
    </div>
    {% if section.settings.intro != blank %}<div class="fp-shop__intro">{{ section.settings.intro }}</div>{% endif %}
  </div>

  {% if collection.products_count > 0 %}
    <div class="fp-shop__tools">
      {% if section.settings.show_product_count %}<span class="fp-shop__count">{{ collection.products_count }} prints</span>{% else %}<span></span>{% endif %}
      {% if section.settings.show_sort %}
        <form class="fp-shop__sort" method="get">
          <label for="SortBy-{{ section.id }}">sort —</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            {% for option in collection.sort_options %}
              {% liquid
                assign fp_sort_label = option.name
                case option.value
                  when 'manual'
                    assign fp_sort_label = 'featured'
                  when 'best-selling'
                    assign fp_sort_label = 'popular'
                  when 'title-ascending'
                    assign fp_sort_label = 'title a–z'
                  when 'title-descending'
                    assign fp_sort_label = 'title z–a'
                  when 'price-ascending'
                    assign fp_sort_label = 'price low–high'
                  when 'price-descending'
                    assign fp_sort_label = 'price high–low'
                  when 'created-ascending'
                    assign fp_sort_label = 'oldest'
                  when 'created-descending'
                    assign fp_sort_label = 'newest'
                endcase
              %}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ fp_sort_label }}</option>
            {% endfor %}
          </select>
        </form>
      {% endif %}
    </div>

    {% paginate collection.products by products_per_page %}
      <div class="fp-shop__grid">
        {% for product in collection.products %}
          {% liquid
            assign fp_alt = product.featured_image.alt | default: product.title
            assign fp_has_a4 = false
            assign fp_has_a3 = false
            for option in product.options_with_values
              assign fp_option_name = option.name | downcase
              if fp_option_name contains 'size'
                for value in option.values
                  assign fp_size_value = value | upcase | strip
                  if fp_size_value contains 'A4'
                    assign fp_has_a4 = true
                  endif
                  if fp_size_value contains 'A3'
                    assign fp_has_a3 = true
                  endif
                endfor
              endif
            endfor
            if fp_has_a4 == false and fp_has_a3 == false
              for variant in product.variants
                assign fp_variant_title = variant.title | upcase
                if fp_variant_title contains 'A4'
                  assign fp_has_a4 = true
                endif
                if fp_variant_title contains 'A3'
                  assign fp_has_a3 = true
                endif
              endfor
            endif
            if fp_has_a4 == false and fp_has_a3 == false
              assign fp_description = product.description | strip_html | upcase
              if fp_description contains 'SIZE: A4'
                assign fp_has_a4 = true
              endif
              if fp_description contains 'SIZE: A3'
                assign fp_has_a3 = true
              endif
            endif
            assign fp_size_label = ''
            if fp_has_a4 and fp_has_a3
              assign fp_size_label = 'A4 · A3'
            elsif fp_has_a4
              assign fp_size_label = 'A4'
            elsif fp_has_a3
              assign fp_size_label = 'A3'
            endif
          %}
          <a class="fp-shop-card" href="{{ product.url }}">
            <div class="fp-shop-card__media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '240,320,420,560,700,900,1200', sizes: '(max-width: 749px) 50vw, (max-width: 900px) 33vw, 25vw', alt: fp_alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              {% unless product.available %}<span class="fp-shop-card__badge">sold out</span>{% endunless %}
            </div>
            <div class="fp-shop-card__meta">
              <div class="fp-shop-card__info">
                <h2>{{ product.title }}</h2>
                {% if fp_size_label != blank %}<span class="fp-shop-card__sizes">{{ fp_size_label }}</span>{% endif %}
              </div>
              {% if section.settings.show_prices %}<p class="fp-shop-card__price">{% if product.price_varies %}from {% endif %}{{ product.price | money }}</p>{% endif %}
              {% if section.settings.show_card_note and section.settings.card_note != blank %}<span class="fp-shop-card__edition">{{ section.settings.card_note }}</span>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="fp-shop__pagination" aria-label="Pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span class="is-current" aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}
          {% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  {% elsif request.design_mode %}
    <div class="fp-shop__empty">Add products to this collection to preview the Friday shop grid.</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Friday shop grid",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LIMITED EDITION PRINTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "all prints" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Small fragments from GiGi’s world, printed in limited numbered editions.</p>" },
    { "type": "header", "content": "Catalogue" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 20 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices", "default": true },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "checkbox", "id": "show_card_note", "label": "Show repeated card note", "default": false },
    { "type": "text", "id": "card_note", "label": "Card note", "default": "limited edition art print" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFDF8" },
    { "type": "color", "id": "accent_color", "label": "Sold-out badge", "default": "#E53F36" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 64, "max": 96, "step": 2, "unit": "px", "default": 88 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 48, "max": 64, "step": 2, "unit": "px", "default": 58 }
  ],
  "presets": [{ "name": "Friday shop grid" }]
}
{% endschema %}
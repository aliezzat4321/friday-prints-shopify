{% liquid
  assign products_per_page = section.settings.products_per_page
  assign shop_heading = section.settings.heading
  if shop_heading == blank
    assign shop_heading = collection.title
  endif
%}

<section
  class="fp-shop"
  id="FridayShop-{{ section.id }}"
  style="--fp-shop-bg:{{ section.settings.background_color }};--fp-shop-accent:{{ section.settings.accent_color }};--fp-shop-heading:{{ section.settings.heading_size_desktop }}px;--fp-shop-heading-mobile:{{ section.settings.heading_size_mobile }}px;--fp-shop-columns:{{ section.settings.columns_desktop }};"
>
  <style>
    #FridayShop-{{ section.id }}{background:var(--fp-shop-bg);color:var(--fp-ink);min-height:60vh}
    #FridayShop-{{ section.id }} *{box-sizing:border-box}
    #FridayShop-{{ section.id }} .fp-shop__head{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:48px;align-items:end;padding:72px 46px 42px;border-bottom:1px solid var(--fp-line)}
    #FridayShop-{{ section.id }} .fp-shop__eyebrow{margin:0 0 14px;color:var(--fp-red);font:700 12px/1 "Courier New",monospace;letter-spacing:.08em;text-transform:uppercase}
    #FridayShop-{{ section.id }} h1{margin:0;font:700 var(--fp-shop-heading)/.84 Georgia,"Times New Roman",serif;letter-spacing:-.055em;text-transform:lowercase}
    #FridayShop-{{ section.id }} .fp-shop__intro{justify-self:end;max-width:42ch;padding-bottom:5px;font:14px/1.55 "Courier New",monospace}
    #FridayShop-{{ section.id }} .fp-shop__intro p{margin:0}
    #FridayShop-{{ section.id }} .fp-shop__tools{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 46px;border-bottom:1px solid var(--fp-line);font:700 11px/1 "Courier New",monospace;text-transform:uppercase;letter-spacing:.055em}
    #FridayShop-{{ section.id }} .fp-shop__count{white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop__sort{display:flex;align-items:center;gap:10px}
    #FridayShop-{{ section.id }} .fp-shop__sort label{white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop__sort select{appearance:none;-webkit-appearance:none;border:0;border-bottom:1px solid var(--fp-ink);border-radius:0;background:transparent;color:inherit;padding:5px 22px 5px 2px;font:700 11px/1.2 "Courier New",monospace;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 9px) 50%,calc(100% - 5px) 50%;background-size:4px 4px,4px 4px;background-repeat:no-repeat}
    #FridayShop-{{ section.id }} .fp-shop__grid{display:grid;grid-template-columns:repeat(var(--fp-shop-columns),minmax(0,1fr));column-gap:30px;row-gap:54px;padding:44px 46px 76px}
    #FridayShop-{{ section.id }} .fp-shop-card{display:block;min-width:0;color:inherit;text-decoration:none}
    #FridayShop-{{ section.id }} .fp-shop-card__media{position:relative;aspect-ratio:.707;overflow:hidden;background:color-mix(in srgb,var(--fp-shop-bg) 85%,#fff)}
    #FridayShop-{{ section.id }} .fp-shop-card__media img,#FridayShop-{{ section.id }} .fp-shop-card__media svg{display:block;width:100%;height:100%;object-fit:contain;transition:transform .35s ease}
    #FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__media img{transform:scale(1.012)}
    #FridayShop-{{ section.id }} .fp-shop-card__badge{position:absolute;top:12px;left:12px;padding:7px 9px;background:var(--fp-shop-accent);color:#fff;font:700 9px/1 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
    #FridayShop-{{ section.id }} .fp-shop-card__meta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start;padding-top:13px;border-top:1px solid transparent;transition:border-color .2s ease}
    #FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__meta{border-top-color:var(--fp-ink)}
    #FridayShop-{{ section.id }} .fp-shop-card h2{margin:0;font:700 13px/1.35 "Courier New",monospace;text-transform:lowercase}
    #FridayShop-{{ section.id }} .fp-shop-card__price{margin:0;font:12px/1.35 "Courier New",monospace;white-space:nowrap}
    #FridayShop-{{ section.id }} .fp-shop-card__edition{grid-column:1/-1;margin-top:-7px;color:color-mix(in srgb,var(--fp-ink) 58%,transparent);font:10px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.04em}
    #FridayShop-{{ section.id }} .fp-shop__pagination{display:flex;justify-content:center;align-items:center;gap:8px;padding:0 24px 68px;font:700 12px/1 "Courier New",monospace}
    #FridayShop-{{ section.id }} .fp-shop__pagination a,#FridayShop-{{ section.id }} .fp-shop__pagination span{min-width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--fp-ink);color:inherit;text-decoration:none}
    #FridayShop-{{ section.id }} .fp-shop__pagination .is-current{background:var(--fp-ink);color:#fff}
    #FridayShop-{{ section.id }} .fp-shop__empty{padding:90px 46px;text-align:center;font:14px/1.5 "Courier New",monospace}
    @media(max-width:1100px){
      #FridayShop-{{ section.id }} .fp-shop__head{padding-inline:30px;gap:30px}
      #FridayShop-{{ section.id }} .fp-shop__tools{padding-inline:30px}
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:42px 22px;padding:36px 30px 64px}
    }
    @media(max-width:749px){
      #FridayShop-{{ section.id }} .fp-shop__head{grid-template-columns:1fr;gap:22px;padding:46px 20px 28px}
      #FridayShop-{{ section.id }} h1{font-size:var(--fp-shop-heading-mobile)}
      #FridayShop-{{ section.id }} .fp-shop__eyebrow{font-size:10px;margin-bottom:10px}
      #FridayShop-{{ section.id }} .fp-shop__intro{justify-self:start;max-width:32ch;font-size:12px;padding-bottom:0}
      #FridayShop-{{ section.id }} .fp-shop__tools{padding:14px 20px;font-size:9px}
      #FridayShop-{{ section.id }} .fp-shop__sort label{display:none}
      #FridayShop-{{ section.id }} .fp-shop__sort select{font-size:9px;max-width:150px}
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 12px;padding:26px 12px 52px}
      #FridayShop-{{ section.id }} .fp-shop-card__meta{grid-template-columns:1fr;gap:3px;padding-top:9px}
      #FridayShop-{{ section.id }} .fp-shop-card h2{font-size:10px;line-height:1.3}
      #FridayShop-{{ section.id }} .fp-shop-card__price{font-size:9px}
      #FridayShop-{{ section.id }} .fp-shop-card__edition{font-size:8px;margin-top:3px}
      #FridayShop-{{ section.id }} .fp-shop-card__badge{top:7px;left:7px;font-size:7px;padding:5px 6px}
    }
    @media(max-width:350px){
      #FridayShop-{{ section.id }} .fp-shop__grid{grid-template-columns:1fr;gap:38px;padding-inline:20px}
      #FridayShop-{{ section.id }} .fp-shop-card h2{font-size:12px}
      #FridayShop-{{ section.id }} .fp-shop-card__price{font-size:10px}
    }
    @media(prefers-reduced-motion:reduce){#FridayShop-{{ section.id }} .fp-shop-card__media img{transition:none}#FridayShop-{{ section.id }} .fp-shop-card:hover .fp-shop-card__media img{transform:none}}
  </style>

  <div class="fp-shop__head">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="fp-shop__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ shop_heading }}</h1>
    </div>
    {% if section.settings.intro != blank %}<div class="fp-shop__intro">{{ section.settings.intro }}</div>{% endif %}
  </div>

  {% if collection.products_count > 0 %}
    <div class="fp-shop__tools">
      {% if section.settings.show_product_count %}<span class="fp-shop__count">{{ collection.products_count }} prints</span>{% else %}<span></span>{% endif %}
      {% if section.settings.show_sort %}
        <form class="fp-shop__sort" method="get">
          <label for="SortBy-{{ section.id }}">sort</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
          </select>
        </form>
      {% endif %}
    </div>

    {% paginate collection.products by products_per_page %}
      <div class="fp-shop__grid">
        {% for product in collection.products %}
          {% assign fp_alt = product.featured_image.alt | default: product.title %}
          <a class="fp-shop-card" href="{{ product.url }}">
            <div class="fp-shop-card__media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '280,420,560,700,900,1200', sizes: '(max-width: 749px) 50vw, (max-width: 1100px) 33vw, 25vw', alt: fp_alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              {% unless product.available %}<span class="fp-shop-card__badge">sold out</span>{% endunless %}
            </div>
            <div class="fp-shop-card__meta">
              <h2>{{ product.title }}</h2>
              {% if section.settings.show_prices %}<p class="fp-shop-card__price">{{ product.price | money }}</p>{% endif %}
              {% if section.settings.card_note != blank %}<span class="fp-shop-card__edition">{{ section.settings.card_note }}</span>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="fp-shop__pagination" aria-label="Pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span class="is-current" aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}
          {% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  {% elsif request.design_mode %}
    <div class="fp-shop__empty">Add products to this collection to preview the Friday shop grid.</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Friday shop grid",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LIMITED EDITION PRINTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "all prints" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Small fragments from GiGi’s world, printed in limited numbered editions.</p>" },
    { "type": "header", "content": "Catalogue" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 20 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices", "default": true },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "text", "id": "card_note", "label": "Card note", "default": "limited edition art print" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF1E4" },
    { "type": "color", "id": "accent_color", "label": "Sold-out badge", "default": "#E53F36" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 64, "max": 120, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 48, "max": 76, "step": 2, "unit": "px", "default": 62 }
  ],
  "presets": [{ "name": "Friday shop grid" }]
}
{% endschema %}
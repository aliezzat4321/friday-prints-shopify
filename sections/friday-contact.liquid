<section class="fp-contact" id="FridayContact-{{ section.id }}">
  <style>
    #FridayContact-{{ section.id }}{background:var(--fp-cream);color:var(--fp-ink);border-bottom:1px solid var(--fp-line)}
    #FridayContact-{{ section.id }} *{box-sizing:border-box}
    #FridayContact-{{ section.id }} .fp-contact__inner{padding-top:clamp(48px,7vw,104px);padding-bottom:clamp(64px,8vw,120px)}
    #FridayContact-{{ section.id }} .fp-contact__intro{display:grid;grid-template-columns:minmax(0,.76fr) minmax(300px,.44fr);align-items:end;gap:56px;padding-bottom:clamp(38px,5vw,66px);border-bottom:1px solid var(--fp-ink)}
    #FridayContact-{{ section.id }} .fp-contact__eyebrow{margin:0 0 14px;color:var(--fp-red-text,var(--fp-red));font:700 10px/1 "Courier New",monospace;letter-spacing:.09em;text-transform:uppercase}
    #FridayContact-{{ section.id }} h1{margin:0;font:700 var(--fp-page-title,clamp(72px,8vw,112px))/.8 Georgia,"Times New Roman",serif;letter-spacing:-.06em;text-transform:lowercase;text-wrap:balance}
    #FridayContact-{{ section.id }} .fp-contact__intro-copy{margin:0;max-width:34ch;font:14px/1.65 "Courier New",monospace}
    #FridayContact-{{ section.id }} .fp-contact__grid{display:grid;grid-template-columns:minmax(240px,.56fr) minmax(0,1.44fr);gap:clamp(44px,7vw,110px);padding-top:clamp(38px,5vw,66px)}
    #FridayContact-{{ section.id }} .fp-contact__aside{display:flex;flex-direction:column;gap:30px}
    #FridayContact-{{ section.id }} .fp-contact__aside-block{display:grid;gap:7px}
    #FridayContact-{{ section.id }} .fp-contact__aside-block small{color:color-mix(in srgb,var(--fp-ink) 58%,transparent);font:700 9px/1 "Courier New",monospace;letter-spacing:.08em;text-transform:uppercase}
    #FridayContact-{{ section.id }} .fp-contact__aside-block a,#FridayContact-{{ section.id }} .fp-contact__aside-block span{color:inherit;font:700 13px/1.5 "Courier New",monospace;overflow-wrap:anywhere;text-underline-offset:4px}
    #FridayContact-{{ section.id }} .fp-contact__note{margin-top:auto;padding-top:22px;border-top:1px solid var(--fp-line);font:11px/1.55 "Courier New",monospace}
    #FridayContact-{{ section.id }} .fp-contact__form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 18px}
    #FridayContact-{{ section.id }} .fp-contact__field{display:grid;gap:8px;min-width:0}
    #FridayContact-{{ section.id }} .fp-contact__field--wide{grid-column:1/-1}
    #FridayContact-{{ section.id }} label{font:700 9px/1 "Courier New",monospace;letter-spacing:.07em;text-transform:uppercase}
    #FridayContact-{{ section.id }} input,#FridayContact-{{ section.id }} textarea{width:100%;min-width:0;border:0;border-bottom:1px solid var(--fp-ink);border-radius:0;background:transparent;color:inherit;padding:12px 0;font:14px/1.4 "Courier New",monospace;box-shadow:none;outline:none}
    #FridayContact-{{ section.id }} textarea{min-height:150px;resize:vertical}
    #FridayContact-{{ section.id }} input:focus,#FridayContact-{{ section.id }} textarea:focus{border-bottom-color:var(--fp-red);box-shadow:0 2px 0 var(--fp-red)}
    #FridayContact-{{ section.id }} input::placeholder,#FridayContact-{{ section.id }} textarea::placeholder{color:color-mix(in srgb,var(--fp-ink) 40%,transparent)}
    #FridayContact-{{ section.id }} .fp-contact__actions{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:8px}
    #FridayContact-{{ section.id }} .fp-contact__actions p{margin:0;max-width:32ch;color:color-mix(in srgb,var(--fp-ink) 59%,transparent);font:9px/1.45 "Courier New",monospace}
    #FridayContact-{{ section.id }} button{min-width:190px;min-height:54px;border:1px solid var(--fp-ink);border-radius:0;background:var(--fp-ink);color:#fff;padding:0 24px;cursor:pointer;font:700 11px/1 "Courier New",monospace;text-transform:lowercase;transition:background-color .18s ease,border-color .18s ease,transform .18s ease}
    #FridayContact-{{ section.id }} button:hover{background:var(--fp-red);border-color:var(--fp-red);transform:translateY(-1px)}
    #FridayContact-{{ section.id }} .fp-contact__status{grid-column:1/-1;margin:0 0 8px;padding:16px;border:1px solid var(--fp-ink);font:700 11px/1.5 "Courier New",monospace}
    #FridayContact-{{ section.id }} .fp-contact__status--success{border-color:var(--fp-green);color:var(--fp-green)}
    #FridayContact-{{ section.id }} .fp-contact__status--error{border-color:var(--fp-red);color:var(--fp-red)}
    #FridayContact-{{ section.id }} .fp-contact__status--error ul{margin:8px 0 0;padding-left:18px}
    @media(max-width:899px){
      #FridayContact-{{ section.id }} .fp-contact__intro{grid-template-columns:1fr;gap:24px}
      #FridayContact-{{ section.id }} .fp-contact__intro-copy{max-width:52ch}
      #FridayContact-{{ section.id }} .fp-contact__grid{grid-template-columns:minmax(190px,.48fr) minmax(0,1fr);gap:42px}
    }
    @media(max-width:649px){
      #FridayContact-{{ section.id }} .fp-contact__inner{padding-inline:20px;padding-top:42px;padding-bottom:72px}
      #FridayContact-{{ section.id }} h1{font-size:clamp(58px,18vw,72px)}
      #FridayContact-{{ section.id }} .fp-contact__intro{gap:20px;padding-bottom:32px}
      #FridayContact-{{ section.id }} .fp-contact__intro-copy{font-size:12px;line-height:1.6}
      #FridayContact-{{ section.id }} .fp-contact__grid{grid-template-columns:1fr;gap:40px;padding-top:34px}
      #FridayContact-{{ section.id }} .fp-contact__aside{display:grid;grid-template-columns:1fr 1fr;gap:22px 16px}
      #FridayContact-{{ section.id }} .fp-contact__note{grid-column:1/-1;margin:0}
      #FridayContact-{{ section.id }} .fp-contact__form{grid-template-columns:1fr;gap:20px}
      #FridayContact-{{ section.id }} .fp-contact__field--wide,#FridayContact-{{ section.id }} .fp-contact__actions,#FridayContact-{{ section.id }} .fp-contact__status{grid-column:1}
      #FridayContact-{{ section.id }} .fp-contact__actions{align-items:stretch;flex-direction:column}
      #FridayContact-{{ section.id }} button{width:100%;min-width:0;min-height:54px}
    }
    @media(max-width:350px){
      #FridayContact-{{ section.id }} .fp-contact__inner{padding-inline:16px}
      #FridayContact-{{ section.id }} .fp-contact__aside{grid-template-columns:1fr}
      #FridayContact-{{ section.id }} .fp-contact__note{grid-column:1}
    }
    @media(prefers-reduced-motion:reduce){#FridayContact-{{ section.id }} button{transition:none}#FridayContact-{{ section.id }} button:hover{transform:none}}
  </style>

  <div class="fp-shell fp-contact__inner">
    <header class="fp-contact__intro">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="fp-contact__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1>{{ section.settings.heading }}</h1>
      </div>
      {% if section.settings.intro != blank %}<p class="fp-contact__intro-copy">{{ section.settings.intro }}</p>{% endif %}
    </header>

    <div class="fp-contact__grid">
      <aside class="fp-contact__aside" aria-label="Contact details">
        {% if section.settings.contact_email != blank %}
          <div class="fp-contact__aside-block"><small>email</small><a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email }}</a></div>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <div class="fp-contact__aside-block"><small>instagram</small><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.instagram_label }}</a></div>
        {% endif %}
        {% if section.settings.response_note != blank %}<p class="fp-contact__note">{{ section.settings.response_note }}</p>{% endif %}
      </aside>

      {% form 'contact', class: 'fp-contact__form', id: 'FridayContactForm' %}
        {% if form.posted_successfully? %}<p class="fp-contact__status fp-contact__status--success" role="status">{{ section.settings.success_message }}</p>{% endif %}
        {% if form.errors %}<div class="fp-contact__status fp-contact__status--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}

        <div class="fp-contact__field">
          <label for="FridayContactName-{{ section.id }}">name</label>
          <input id="FridayContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" placeholder="your name">
        </div>
        <div class="fp-contact__field">
          <label for="FridayContactEmail-{{ section.id }}">email <span aria-hidden="true">*</span></label>
          <input id="FridayContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" placeholder="you@example.com" required aria-required="true">
        </div>
        <div class="fp-contact__field fp-contact__field--wide">
          <label for="FridayContactOrder-{{ section.id }}">order number <span aria-hidden="true">— optional</span></label>
          <input id="FridayContactOrder-{{ section.id }}" type="text" name="contact[order number]" autocomplete="off" placeholder="#1001">
        </div>
        <div class="fp-contact__field fp-contact__field--wide">
          <label for="FridayContactBody-{{ section.id }}">message <span aria-hidden="true">*</span></label>
          <textarea id="FridayContactBody-{{ section.id }}" name="contact[body]" placeholder="Tell us what you need help with…" required aria-required="true">{{ form.body }}</textarea>
        </div>
        <div class="fp-contact__actions">
          <p>{{ section.settings.privacy_note }}</p>
          <button type="submit">{{ section.settings.button_label }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friday contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 · CONTACT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "say hello" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Questions about an artwork, your order, or finding the right print? Send us a note and we’ll get back to you." },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "info@fridayprints.art" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "@fridayprints.art" },
    { "type": "textarea", "id": "response_note", "label": "Response note", "default": "We usually reply within 1–2 working days from Cairo." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "send message →" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Message received. We’ll be in touch soon." },
    { "type": "textarea", "id": "privacy_note", "label": "Form note", "default": "Your details are used only to reply to this message." }
  ],
  "presets": [{ "name": "Friday contact" }]
}
{% endschema %}

{% assign fp_collection = section.settings.collection %}
<section
  class="fp-section fp-collection"
  id="FridayCollection-{{ section.id }}"
  style="--fp-collection-bg:{{ section.settings.background_color }};--fp-collection-heading-size:{{ section.settings.heading_size_desktop }}px;--fp-collection-heading-mobile:{{ section.settings.heading_size_mobile }}px;"
>
  <style>
    #FridayCollection-{{ section.id }}{background:var(--fp-collection-bg)}
    #FridayCollection-{{ section.id }} .fp-collection__inner{padding:36px 0}
    #FridayCollection-{{ section.id }} .fp-collection__title{margin-bottom:22px;padding:0 28px;text-align:center}
    #FridayCollection-{{ section.id }} .fp-collection__title h2{
      font-family:var(--fp-display-font,Georgia,"Times New Roman",serif)!important;
      font-style:normal!important;
      font-weight:700!important;
      font-size:min(var(--fp-collection-heading-size),var(--fp-section-title,56px))!important;
      line-height:.95!important;
      letter-spacing:-.045em!important;
      text-transform:none!important;
    }
    #FridayCollection-{{ section.id }} .fp-collection__rail{gap:20px;padding:0 46px 12px}
    #FridayCollection-{{ section.id }} .fp-product{flex:0 0 clamp(196px,17vw,242px);max-width:242px;transition:transform .25s ease}
    #FridayCollection-{{ section.id }} .fp-product:hover{transform:translateY(-4px)}
    #FridayCollection-{{ section.id }} .fp-product__media{aspect-ratio:.707;border:0;padding:0;background:transparent;overflow:hidden}
    #FridayCollection-{{ section.id }} .fp-product__media img,
    #FridayCollection-{{ section.id }} .fp-product__media svg{width:100%;height:100%;object-fit:contain;display:block;transition:transform .35s ease}
    #FridayCollection-{{ section.id }} .fp-product:hover .fp-product__media img{transform:scale(1.012)}
    #FridayCollection-{{ section.id }} .fp-product h3{margin:10px 0 4px;text-align:left;font-size:12px;text-transform:none!important}
    #FridayCollection-{{ section.id }} .fp-product__sizes{display:block;margin:-1px 0 3px;text-align:left;color:color-mix(in srgb,var(--fp-ink) 58%,transparent);font:700 9px/1.3 "Courier New",monospace;text-transform:uppercase;letter-spacing:.055em}
    #FridayCollection-{{ section.id }} .fp-product p{margin:0;text-align:left;font-size:11.5px}
    #FridayCollection-{{ section.id }} .fp-collection__cta{margin-top:11px}
    #FridayCollection-{{ section.id }} .fp-collection__cta a{min-height:44px;padding:0 24px}
    #FridayCollection-{{ section.id }} .fp-arrow{transition:opacity .18s ease,visibility .18s ease}
    #FridayCollection-{{ section.id }} .fp-arrow:disabled{opacity:0;visibility:hidden;pointer-events:none}
    @media(max-width:1100px) and (min-width:750px){
      #FridayCollection-{{ section.id }} .fp-collection__inner{padding:32px 0}
      #FridayCollection-{{ section.id }} .fp-collection__rail{gap:17px;padding-inline:32px}
      #FridayCollection-{{ section.id }} .fp-product{flex-basis:210px;max-width:210px}
      #FridayCollection-{{ section.id }} .fp-collection__title h2{font-size:min(var(--fp-collection-heading-size),52px)!important}
    }
    @media(max-width:749px){
      #FridayCollection-{{ section.id }} .fp-collection__inner{padding:32px 0 30px}
      #FridayCollection-{{ section.id }} .fp-collection__title{margin-bottom:20px;padding:0 20px}
      #FridayCollection-{{ section.id }} .fp-collection__title h2{font-size:min(var(--fp-collection-heading-mobile),var(--fp-section-title,38px))!important}
      #FridayCollection-{{ section.id }} .fp-collection__title-deco{font-size:24px;margin-inline:6px}
      #FridayCollection-{{ section.id }} .fp-collection__rail{gap:12px;padding:0 20px 12px}
      #FridayCollection-{{ section.id }} .fp-product{flex:0 0 min(68vw,244px);max-width:min(68vw,244px)}
      #FridayCollection-{{ section.id }} .fp-product h3{font-size:12px;margin-top:9px}
      #FridayCollection-{{ section.id }} .fp-product__sizes{font-size:8.5px;margin-bottom:3px}
      #FridayCollection-{{ section.id }} .fp-product p{font-size:11px}
      #FridayCollection-{{ section.id }} .fp-arrow{display:none}
      #FridayCollection-{{ section.id }} .fp-collection__cta{margin-top:11px}
    }
    @media(prefers-reduced-motion:reduce){
      #FridayCollection-{{ section.id }} .fp-product,
      #FridayCollection-{{ section.id }} .fp-product__media img{transition:none}
      #FridayCollection-{{ section.id }} .fp-product:hover{transform:none}
      #FridayCollection-{{ section.id }} .fp-product:hover .fp-product__media img{transform:none}
    }
  </style>

  <div class="fp-shell fp-collection__inner">
    {% if section.settings.heading != blank %}
      <div class="fp-collection__title">
        {% if section.settings.title_decoration != blank %}<span class="fp-collection__title-deco" aria-hidden="true">{{ section.settings.title_decoration }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.title_decoration != blank %}<span class="fp-collection__title-deco" aria-hidden="true">{{ section.settings.title_decoration }}</span>{% endif %}
      </div>
    {% endif %}

    {% if fp_collection != blank and fp_collection.products_count > 0 %}
      {% if section.settings.show_arrows %}<button class="fp-arrow fp-arrow--prev" type="button" aria-label="{{ section.settings.previous_label | escape }}" data-fp-prev disabled>‹</button>{% endif %}
      <div class="fp-collection__rail" data-fp-rail>
        {% for product in fp_collection.products limit: section.settings.product_limit %}
          {% liquid
            assign fp_product_alt = product.featured_image.alt | default: product.title
            assign fp_has_a4 = false
            assign fp_has_a3 = false
            for option in product.options_with_values
              assign fp_option_name = option.name | downcase
              if fp_option_name contains 'size'
                for value in option.values
                  assign fp_size_value = value | upcase | strip
                  if fp_size_value contains 'A4'
                    assign fp_has_a4 = true
                  endif
                  if fp_size_value contains 'A3'
                    assign fp_has_a3 = true
                  endif
                endfor
              endif
            endfor
            if fp_has_a4 == false and fp_has_a3 == false
              for variant in product.variants
                assign fp_variant_title = variant.title | upcase
                if fp_variant_title contains 'A4'
                  assign fp_has_a4 = true
                endif
                if fp_variant_title contains 'A3'
                  assign fp_has_a3 = true
                endif
              endfor
            endif
            assign fp_description = product.description | strip_html | upcase
            if fp_description contains 'SIZE: A4'
              assign fp_has_a4 = true
            endif
            if fp_description contains 'SIZE: A3'
              assign fp_has_a3 = true
            endif
            assign fp_size_label = ''
            if fp_has_a4 and fp_has_a3
              assign fp_size_label = 'A4 · A3'
            elsif fp_has_a4
              assign fp_size_label = 'A4'
            elsif fp_has_a3
              assign fp_size_label = 'A3'
            endif
          %}
          <a class="fp-product" href="{{ product.url }}">
            <div class="fp-product__media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '240,360,480,600,750,900,1000', sizes: '(max-width: 749px) 68vw, (max-width: 1100px) 210px, 242px', alt: fp_product_alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <h3>{{ product.title }}</h3>
            {% if fp_size_label != blank %}<span class="fp-product__sizes">{{ fp_size_label }}</span>{% endif %}
            {% if section.settings.show_prices %}<p>{% if product.price_varies %}from {% endif %}{{ product.price | money }}</p>{% endif %}
          </a>
        {% endfor %}
      </div>
      {% if section.settings.show_arrows %}<button class="fp-arrow fp-arrow--next" type="button" aria-label="{{ section.settings.next_label | escape }}" data-fp-next>›</button>{% endif %}

      {% assign fp_button_link = section.settings.button_link %}
      {% if fp_button_link == blank %}{% assign fp_button_link = fp_collection.url %}{% endif %}
      {% if section.settings.button_label != blank and fp_button_link != blank %}<div class="fp-collection__cta"><a href="{{ fp_button_link }}">{{ section.settings.button_label }}</a></div>{% endif %}
    {% elsif request.design_mode %}
      <div class="fp-collection__empty">{{ section.settings.empty_message }}</div>
    {% endif %}
  </div>
</section>
<script>
  (() => {
    const init = (root) => {
      if (!root || root.dataset.fpCollectionReady === 'true') return;
      const rail = root.querySelector('[data-fp-rail]');
      if (!rail) return;
      const prev = root.querySelector('[data-fp-prev]');
      const next = root.querySelector('[data-fp-next]');
      const edge = 3;
      const updateArrows = () => {
        const styles = getComputedStyle(rail);
        const startOffset = parseFloat(styles.paddingLeft) || 0;
        const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
        if (prev) prev.disabled = maxScroll <= edge || rail.scrollLeft <= startOffset + edge;
        if (next) next.disabled = maxScroll <= edge || rail.scrollLeft >= maxScroll - edge;
      };
      root.dataset.fpCollectionReady = 'true';
      prev?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * .72, behavior: 'smooth' }));
      next?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * .72, behavior: 'smooth' }));
      rail.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      requestAnimationFrame(updateArrows);
    };
    init(document.getElementById('FridayCollection-{{ section.id }}'));
    if (!window.__fridayCollectionEditorListener) {
      window.__fridayCollectionEditorListener = true;
      document.addEventListener('shopify:section:load', (event) => {
        const root = event.target.querySelector?.('[id^="FridayCollection-"]');
        if (!root) return;
        root.dataset.fpCollectionReady = 'false';
        init(root);
      });
    }
  })();
</script>
{% schema %}
{
  "name": "Friday collection",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "the prints" },
    { "type": "text", "id": "title_decoration", "label": "Heading decoration", "default": "≈" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Maximum products", "min": 3, "max": 12, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show desktop arrows", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop all prints" },
    { "type": "url", "id": "button_link", "label": "Button link (optional — defaults to selected collection)" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3CF78" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 44, "max": 60, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 34, "max": 46, "step": 1, "unit": "px", "default": 38 },
    { "type": "header", "content": "Accessibility / editor" },
    { "type": "text", "id": "previous_label", "label": "Previous button accessibility label", "default": "Previous prints" },
    { "type": "text", "id": "next_label", "label": "Next button accessibility label", "default": "Next prints" },
    { "type": "text", "id": "empty_message", "label": "Editor placeholder text", "default": "Choose a collection in this section." }
  ],
  "presets": [{ "name": "Friday collection" }]
}
{% endschema %}
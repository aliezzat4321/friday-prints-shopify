{% assign fr_collection = section.settings.collection %}{% if fr_collection == blank %}{% assign fr_collection = collections['all'] %}{% endif %}
<section class="fr-section fr-collection" id="FridayCollection-{{ section.id }}">
  <div class="fr-shell fr-collection__inner">
    <div class="fr-collection__title"><h2>{{ section.settings.heading }}</h2></div>
    <button class="fr-arrow fr-arrow--prev" type="button" aria-label="Previous prints" data-fr-prev>‹</button>
    <div class="fr-collection__rail" data-fr-rail>
      {% if fr_collection != blank and fr_collection.products_count > 0 %}
        {% for product in fr_collection.products limit: 7 %}
          <a class="fr-product" href="{{ product.url }}">
            <div class="fr-product__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading:'lazy', widths:'220,360,480,600', sizes:'(max-width:749px) 58vw, 14vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>
            <h3>{{ product.title }}</h3><p>{{ product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% assign names = "the collector|sunday’s best|daydreamer|tea for one|keep moving|confidence|wild at heart" | split: "|" %}
        {% for name in names %}<div class="fr-product"><div class="fr-product__media">{{ 'product-1' | placeholder_svg_tag }}</div><h3>{{ name }}</h3><p>add product</p></div>{% endfor %}
      {% endif %}
    </div>
    <button class="fr-arrow fr-arrow--next" type="button" aria-label="Next prints" data-fr-next>›</button>
    <div class="fr-collection__button"><a class="fr-btn fr-btn--green" href="{{ fr_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></div>
  </div>
</section>
<script>(()=>{const r=document.getElementById('FridayCollection-{{ section.id }}');if(!r)return;const rail=r.querySelector('[data-fr-rail]');r.querySelector('[data-fr-prev]')?.addEventListener('click',()=>rail.scrollBy({left:-rail.clientWidth*.7,behavior:'smooth'}));r.querySelector('[data-fr-next]')?.addEventListener('click',()=>rail.scrollBy({left:rail.clientWidth*.7,behavior:'smooth'}));})();</script>
{% schema %}
{"name":"Friday collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"the collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"button_label","label":"Button label","default":"view all prints"}],"presets":[{"name":"Friday collection"}]}
{% endschema %}
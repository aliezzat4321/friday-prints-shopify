<section class="fp-search-page" id="FridaySearch-{{ section.id }}" style="--fp-search-bg:{{ section.settings.background_color }};--fp-search-accent:{{ section.settings.accent_color }};">
  <style>
    #FridaySearch-{{ section.id }}{min-height:65vh;background:var(--fp-search-bg);color:var(--fp-ink)}
    #FridaySearch-{{ section.id }} *{box-sizing:border-box}
    #FridaySearch-{{ section.id }} .fp-search-page__head{padding:68px 46px 42px;border-bottom:1px solid var(--fp-line)}
    #FridaySearch-{{ section.id }} .fp-search-page__eyebrow{margin:0 0 15px;color:var(--fp-search-accent);font:700 11px/1 "Courier New",monospace;letter-spacing:.09em;text-transform:uppercase}
    #FridaySearch-{{ section.id }} h1{margin:0 0 34px;font:700 clamp(72px,8vw,118px)/.82 Georgia,"Times New Roman",serif;letter-spacing:-.055em;text-transform:lowercase}
    #FridaySearch-{{ section.id }} .fp-search-page__form{display:grid;grid-template-columns:minmax(0,1fr) auto;width:min(100%,1080px);border-bottom:2px solid var(--fp-ink)}
    #FridaySearch-{{ section.id }} .fp-search-page__input{min-width:0;border:0!important;border-radius:0!important;outline:0;background:transparent!important;color:var(--fp-ink);padding:12px 0 15px;font:700 clamp(22px,2.6vw,38px)/1 "Courier New",monospace;box-shadow:none!important}
    #FridaySearch-{{ section.id }} .fp-search-page__input::placeholder{color:color-mix(in srgb,var(--fp-ink) 38%,transparent)}
    #FridaySearch-{{ section.id }} .fp-search-page__submit{width:58px;border:0;background:transparent;color:var(--fp-ink);cursor:pointer;display:grid;place-items:center}
    #FridaySearch-{{ section.id }} .fp-search-page__submit svg{width:30px;height:30px;fill:none;stroke:currentColor;stroke-width:1.6}
    #FridaySearch-{{ section.id }} .fp-search-page__status{display:flex;justify-content:space-between;gap:20px;padding:18px 46px;border-bottom:1px solid var(--fp-line);font:700 10px/1.4 "Courier New",monospace;text-transform:uppercase;letter-spacing:.055em}
    #FridaySearch-{{ section.id }} .fp-search-page__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:54px 30px;padding:44px 46px 76px}
    #FridaySearch-{{ section.id }} .fp-search-card{display:block;min-width:0;color:inherit;text-decoration:none}
    #FridaySearch-{{ section.id }} .fp-search-card__media{aspect-ratio:.707;overflow:hidden;background:color-mix(in srgb,var(--fp-search-bg) 82%,#fff)}
    #FridaySearch-{{ section.id }} .fp-search-card__media img,#FridaySearch-{{ section.id }} .fp-search-card__media svg{display:block;width:100%;height:100%;object-fit:contain;transition:transform .3s ease}
    #FridaySearch-{{ section.id }} .fp-search-card:hover .fp-search-card__media img{transform:scale(1.012)}
    #FridaySearch-{{ section.id }} .fp-search-card__meta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding-top:12px}
    #FridaySearch-{{ section.id }} .fp-search-card h2{margin:0;font:700 13px/1.35 "Courier New",monospace;text-transform:lowercase}
    #FridaySearch-{{ section.id }} .fp-search-card p{margin:0;font:12px/1.35 "Courier New",monospace;white-space:nowrap}
    #FridaySearch-{{ section.id }} .fp-search-page__empty{padding:76px 46px 100px}
    #FridaySearch-{{ section.id }} .fp-search-page__empty strong{display:block;margin-bottom:12px;font:italic 32px/1 Georgia,"Times New Roman",serif;color:var(--fp-search-accent)}
    #FridaySearch-{{ section.id }} .fp-search-page__empty p{max-width:42ch;margin:0;font:13px/1.55 "Courier New",monospace}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination{display:flex;justify-content:center;gap:8px;padding:0 24px 70px;font:700 11px/1 "Courier New",monospace}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination a,#FridaySearch-{{ section.id }} .fp-search-page__pagination span{min-width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--fp-ink);color:inherit;text-decoration:none}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination .is-current{background:var(--fp-ink);color:#fff}
    @media(max-width:1100px){#FridaySearch-{{ section.id }} .fp-search-page__grid{grid-template-columns:repeat(3,minmax(0,1fr));padding-inline:30px;gap:42px 22px}#FridaySearch-{{ section.id }} .fp-search-page__head,#FridaySearch-{{ section.id }} .fp-search-page__status{padding-inline:30px}}
    @media(max-width:749px){
      #FridaySearch-{{ section.id }} .fp-search-page__head{padding:46px 20px 30px}
      #FridaySearch-{{ section.id }} h1{font-size:62px;margin-bottom:26px}
      #FridaySearch-{{ section.id }} .fp-search-page__eyebrow{font-size:9px}
      #FridaySearch-{{ section.id }} .fp-search-page__input{font-size:20px;padding-bottom:11px}
      #FridaySearch-{{ section.id }} .fp-search-page__submit{width:45px}
      #FridaySearch-{{ section.id }} .fp-search-page__submit svg{width:25px;height:25px}
      #FridaySearch-{{ section.id }} .fp-search-page__status{padding:13px 20px;font-size:8px}
      #FridaySearch-{{ section.id }} .fp-search-page__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 12px;padding:25px 12px 54px}
      #FridaySearch-{{ section.id }} .fp-search-card__meta{grid-template-columns:1fr;gap:2px;padding-top:9px}
      #FridaySearch-{{ section.id }} .fp-search-card h2{font-size:10px}
      #FridaySearch-{{ section.id }} .fp-search-card p{font-size:9px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty{padding:54px 20px 76px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty strong{font-size:27px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty p{font-size:11px}
    }
    @media(max-width:350px){#FridaySearch-{{ section.id }} .fp-search-page__grid{grid-template-columns:1fr;padding-inline:20px}}
    @media(prefers-reduced-motion:reduce){#FridaySearch-{{ section.id }} .fp-search-card__media img{transition:none}#FridaySearch-{{ section.id }} .fp-search-card:hover .fp-search-card__media img{transform:none}}
  </style>

  <div class="fp-search-page__head">
    {% if section.settings.eyebrow != blank %}<p class="fp-search-page__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    <form class="fp-search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input class="fp-search-page__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" aria-label="{{ section.settings.input_label | escape }}" autocomplete="off">
      <button class="fp-search-page__submit" type="submit" aria-label="{{ section.settings.submit_label | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></svg></button>
    </form>
  </div>

  {% if search.performed %}
    {% paginate search.results by section.settings.results_per_page %}
      <div class="fp-search-page__status"><span>{{ search.results_count }} result{% unless search.results_count == 1 %}s{% endunless %}</span><span>“{{ search.terms }}”</span></div>
      {% if search.results_count > 0 %}
        <div class="fp-search-page__grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign fp_alt = item.featured_image.alt | default: item.title %}
              <a class="fp-search-card" href="{{ item.url }}">
                <div class="fp-search-card__media">{% if item.featured_image %}{{ item.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '280,420,560,700,900,1000', sizes: '(max-width:749px) 50vw, (max-width:1100px) 33vw, 25vw', alt: fp_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>
                <div class="fp-search-card__meta"><h2>{{ item.title }}</h2><p>{{ item.price | money }}</p></div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="fp-search-page__pagination" aria-label="Search pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">←</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span class="is-current" aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">→</a>{% endif %}</nav>{% endif %}
      {% else %}
        <div class="fp-search-page__empty"><strong>{{ section.settings.no_results_heading }}</strong><p>{{ section.settings.no_results_text }}</p></div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <div class="fp-search-page__empty"><strong>{{ section.settings.start_heading }}</strong><p>{{ section.settings.start_text }}</p></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Friday search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LOOKING FOR SOMETHING?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "find a print" },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "type a title, mood, anything..." },
    { "type": "text", "id": "input_label", "label": "Search accessibility label", "default": "Search Friday Prints" },
    { "type": "text", "id": "submit_label", "label": "Submit accessibility label", "default": "Search" },
    { "type": "text", "id": "start_heading", "label": "Initial message heading", "default": "go on, have a look." },
    { "type": "textarea", "id": "start_text", "label": "Initial message", "default": "Search by print title or whatever you remember from GiGi’s world." },
    { "type": "text", "id": "no_results_heading", "label": "No results heading", "default": "nothing here yet." },
    { "type": "textarea", "id": "no_results_text", "label": "No results text", "default": "Try another word, or head back to Shop All and browse the whole wall." },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 24, "step": 4, "default": 20 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF1E4" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E53F36" }
  ],
  "presets": [{ "name": "Friday search" }]
}
{% endschema %}
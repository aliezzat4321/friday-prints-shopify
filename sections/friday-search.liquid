<section
  class="fp-search-page"
  id="FridaySearch-{{ section.id }}"
  style="--fp-search-bg:{{ section.settings.background_color }};--fp-search-accent:{{ section.settings.accent_color }};"
>
  <style>
    #FridaySearch-{{ section.id }}{min-height:62vh;background:var(--fp-search-bg);color:var(--fp-ink,#15110f)}
    #FridaySearch-{{ section.id }} *{box-sizing:border-box}
    #FridaySearch-{{ section.id }} .fp-search-page__head{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(420px,1.28fr);align-items:end;gap:clamp(54px,8vw,140px);padding:54px var(--fp-page-gutter,46px) 36px;border-bottom:1px solid var(--fp-line,rgb(21 17 15/.22))}
    #FridaySearch-{{ section.id }} .fp-search-page__eyebrow{margin:0 0 11px;color:var(--fp-red-text,var(--fp-search-accent));font:700 10px/1 "Courier New",monospace;letter-spacing:.09em;text-transform:uppercase}
    #FridaySearch-{{ section.id }} h1{margin:0;font:700 clamp(58px,6.7vw,92px)/.84 Georgia,"Times New Roman",serif;letter-spacing:-.055em;text-transform:lowercase}
    #FridaySearch-{{ section.id }} .fp-search-page__form{display:grid;grid-template-columns:minmax(0,1fr) auto;width:100%;border-bottom:2px solid var(--fp-ink,#15110f)}
    #FridaySearch-{{ section.id }} .fp-search-page__input{min-width:0;border:0!important;border-radius:0!important;outline:0;background:transparent!important;color:inherit;padding:13px 0 14px;font:700 clamp(18px,1.8vw,25px)/1.2 "Courier New",monospace;letter-spacing:-.025em;box-shadow:none!important}
    #FridaySearch-{{ section.id }} .fp-search-page__input::placeholder{color:rgb(21 17 15/.4);opacity:1}
    #FridaySearch-{{ section.id }} .fp-search-page__submit{min-width:96px;border:0;background:transparent;color:inherit;cursor:pointer;font:700 10px/1 "Courier New",monospace;letter-spacing:.07em;text-align:right;text-transform:uppercase}
    #FridaySearch-{{ section.id }} .fp-search-page__submit:hover{color:var(--fp-search-accent)}
    #FridaySearch-{{ section.id }} .fp-search-page__status{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:17px var(--fp-page-gutter,46px);border-bottom:1px solid var(--fp-line,rgb(21 17 15/.22));font:700 10px/1.4 "Courier New",monospace;letter-spacing:.055em;text-transform:uppercase}
    #FridaySearch-{{ section.id }} .fp-search-page__status a{color:inherit;text-decoration:none}
    #FridaySearch-{{ section.id }} .fp-search-page__status a:hover{color:var(--fp-search-accent)}
    #FridaySearch-{{ section.id }} .fp-search-page__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:54px 28px;padding:42px var(--fp-page-gutter,46px) 76px}
    #FridaySearch-{{ section.id }} .fp-search-card{display:block;min-width:0;color:inherit;text-decoration:none}
    #FridaySearch-{{ section.id }} .fp-search-card__media{aspect-ratio:.707;overflow:hidden;background:rgb(255 255 255/.28)}
    #FridaySearch-{{ section.id }} .fp-search-card__media img,#FridaySearch-{{ section.id }} .fp-search-card__media svg{display:block;width:100%;height:100%;object-fit:contain;transition:transform .3s ease}
    #FridaySearch-{{ section.id }} .fp-search-card:hover .fp-search-card__media img{transform:scale(1.012)}
    #FridaySearch-{{ section.id }} .fp-search-card__meta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding-top:12px}
    #FridaySearch-{{ section.id }} .fp-search-card h2{margin:0;font:700 13px/1.35 "Courier New",monospace;text-transform:lowercase}
    #FridaySearch-{{ section.id }} .fp-search-card p{margin:0;font:12px/1.35 "Courier New",monospace;white-space:nowrap}
    #FridaySearch-{{ section.id }} .fp-search-page__empty{display:flex;align-items:flex-start;justify-content:space-between;gap:36px;padding:54px var(--fp-page-gutter,46px) 86px;border-bottom:1px solid var(--fp-line,rgb(21 17 15/.22))}
    #FridaySearch-{{ section.id }} .fp-search-page__empty-copy{max-width:560px}
    #FridaySearch-{{ section.id }} .fp-search-page__empty strong{display:block;margin-bottom:10px;font:italic 30px/1.05 Georgia,"Times New Roman",serif;color:var(--fp-search-accent)}
    #FridaySearch-{{ section.id }} .fp-search-page__empty p{max-width:52ch;margin:0;font:12px/1.6 "Courier New",monospace}
    #FridaySearch-{{ section.id }} .fp-search-page__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:22px}
    #FridaySearch-{{ section.id }} .fp-search-page__actions a{display:inline-flex;align-items:center;min-height:44px;padding:4px 0;border-bottom:1px solid currentColor;color:inherit;font:700 10px/1.4 "Courier New",monospace;letter-spacing:.06em;text-decoration:none;text-transform:uppercase}
    #FridaySearch-{{ section.id }} .fp-search-page__actions a:hover{color:var(--fp-search-accent)}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination{display:flex;justify-content:center;gap:8px;padding:0 24px 70px;font:700 11px/1 "Courier New",monospace}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination a,#FridaySearch-{{ section.id }} .fp-search-page__pagination span{min-width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--fp-ink,#15110f);color:inherit;text-decoration:none}
    #FridaySearch-{{ section.id }} .fp-search-page__pagination .is-current{background:var(--fp-ink,#15110f);color:var(--fp-search-bg)}
    @media(max-width:1100px){
      #FridaySearch-{{ section.id }} .fp-search-page__head{grid-template-columns:1fr;gap:32px;padding-inline:30px}
      #FridaySearch-{{ section.id }} .fp-search-page__status{padding-inline:30px}
      #FridaySearch-{{ section.id }} .fp-search-page__grid{grid-template-columns:repeat(3,minmax(0,1fr));padding-inline:30px;gap:42px 22px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty{padding-inline:30px}
    }
    @media(max-width:749px){
      #FridaySearch-{{ section.id }} .fp-search-page__head{gap:28px;padding:38px 20px 28px}
      #FridaySearch-{{ section.id }} h1{font-size:57px}
      #FridaySearch-{{ section.id }} .fp-search-page__eyebrow{font-size:10px}
      #FridaySearch-{{ section.id }} .fp-search-page__input{padding:11px 0 12px;font-size:17px}
      #FridaySearch-{{ section.id }} .fp-search-page__submit{min-width:82px;font-size:9px}
      #FridaySearch-{{ section.id }} .fp-search-page__status{align-items:flex-start;padding:13px 20px;font-size:9px}
      #FridaySearch-{{ section.id }} .fp-search-page__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 12px;padding:25px 12px 54px}
      #FridaySearch-{{ section.id }} .fp-search-card__meta{grid-template-columns:1fr;gap:3px;padding-top:9px}
      #FridaySearch-{{ section.id }} .fp-search-card h2{font-size:12px}
      #FridaySearch-{{ section.id }} .fp-search-card p{font-size:11px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty{align-items:flex-start;flex-direction:column;gap:28px;padding:42px 20px 64px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty strong{font-size:26px}
      #FridaySearch-{{ section.id }} .fp-search-page__empty p{font-size:11px}
      #FridaySearch-{{ section.id }} .fp-search-page__actions{justify-content:flex-start}
    }
    @media(prefers-reduced-motion:reduce){#FridaySearch-{{ section.id }} .fp-search-card__media img{transition:none}#FridaySearch-{{ section.id }} .fp-search-card:hover .fp-search-card__media img{transform:none}}
  </style>

  <div class="fp-search-page__head">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="fp-search-page__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
    </div>
    <form class="fp-search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input class="fp-search-page__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" aria-label="{{ section.settings.input_label | escape }}" autocomplete="off">
      <button class="fp-search-page__submit" type="submit">search&nbsp;&nbsp;→</button>
    </form>
  </div>

  {% if search.performed %}
    {% paginate search.results by section.settings.results_per_page %}
      {% if search.results_count > 0 %}
        <div class="fp-search-page__status" role="status">
          <span>{{ search.results_count }} print{% unless search.results_count == 1 %}s{% endunless %} found for “{{ search.terms }}”</span>
          <a href="{{ routes.search_url }}">clear search&nbsp;&nbsp;×</a>
        </div>
        <div class="fp-search-page__grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign fp_alt = item.featured_image.alt | default: item.title %}
              <a class="fp-search-card" href="{{ item.url }}">
                <div class="fp-search-card__media">
                  {% if item.featured_image %}
                    {{ item.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '280,420,560,700,900,1000', sizes: '(max-width:749px) 50vw, (max-width:1100px) 33vw, 25vw', alt: fp_alt }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="fp-search-card__meta"><h2>{{ item.title }}</h2><p>{{ item.price | money }}</p></div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="fp-search-page__pagination" aria-label="Search pagination">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span class="is-current" aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}
            {% endfor %}
            {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="fp-search-page__empty">
          <div class="fp-search-page__empty-copy"><strong>{{ section.settings.no_results_heading }} “{{ search.terms }}”.</strong><p>{{ section.settings.no_results_text }}</p></div>
          <div class="fp-search-page__actions"><a href="{{ routes.search_url }}">clear search</a><a href="{{ collections['all'].url | default: routes.collections_url }}">browse all prints&nbsp;&nbsp;→</a></div>
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <div class="fp-search-page__empty">
      <div class="fp-search-page__empty-copy"><strong>{{ section.settings.start_heading }}</strong><p>{{ section.settings.start_text }}</p></div>
      <div class="fp-search-page__actions"><a href="{{ collections['all'].url | default: routes.collections_url }}">browse all prints&nbsp;&nbsp;→</a></div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Friday search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEARCH THE ARCHIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "search prints" },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "what are you looking for?" },
    { "type": "text", "id": "input_label", "label": "Search accessibility label", "default": "Search Friday Prints" },
    { "type": "text", "id": "start_heading", "label": "Initial message heading", "default": "looking for something?" },
    { "type": "textarea", "id": "start_text", "label": "Initial message", "default": "Search by title or keyword." },
    { "type": "text", "id": "no_results_heading", "label": "No results heading", "default": "nothing found for" },
    { "type": "textarea", "id": "no_results_text", "label": "No results text", "default": "Try another word or browse the complete collection." },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 24, "step": 4, "default": 20 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFDF8" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E53F36" }
  ],
  "presets": [{ "name": "Friday search" }]
}
{% endschema %}

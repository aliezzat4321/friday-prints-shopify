{% assign art_mode = section.settings.art_mode | default: 'legacy_curated' %}
{% assign stack_primary_product = section.settings.stack_primary %}
{% assign stack_left_product = section.settings.stack_left %}
{% assign stack_right_product = section.settings.stack_right %}
{% if stack_primary_product == blank %}{% assign stack_primary_product = all_products['friday-in-kyoto'] %}{% endif %}
{% if stack_left_product == blank %}{% assign stack_left_product = all_products['gigi-goes-to-the-jimjilbang'] %}{% endif %}
{% if stack_right_product == blank %}{% assign stack_right_product = all_products['small-car-big-plans-a4'] %}{% endif %}
{% assign stack_primary_alt = stack_primary_product.featured_image.alt | default: stack_primary_product.title %}
{% assign stack_left_alt = stack_left_product.featured_image.alt | default: stack_left_product.title %}
{% assign stack_right_alt = stack_right_product.featured_image.alt | default: stack_right_product.title %}

<section class="fp-section fp-hero{% if section.settings.height_mode == 'viewport' %} fp-hero--viewport{% endif %}" id="FridayHero-{{ section.id }}" data-art-mode="{{ art_mode }}" style="--fp-hero-title-desktop:{{ section.settings.title_size_desktop }}px;--fp-hero-title-mobile:{{ section.settings.title_size_mobile }}px;--fp-hero-kicker-desktop:{{ section.settings.kicker_size_desktop }}px;--fp-hero-kicker-mobile:{{ section.settings.kicker_size_mobile }}px;--fp-hero-sub-desktop:{{ section.settings.subtitle_size_desktop }}px;--fp-hero-sub-mobile:{{ section.settings.subtitle_size_mobile }}px;--fp-hero-button-desktop:{{ section.settings.button_size_desktop }}px;--fp-hero-button-mobile:{{ section.settings.button_size_mobile }}px;">
  <style>
    #FridayHero-{{ section.id }} .fp-hero__kicker{font-size:var(--fp-hero-kicker-desktop)}
    #FridayHero-{{ section.id }} .fp-hero h1{font-size:clamp(74px,6.6vw,var(--fp-hero-title-desktop))}
    #FridayHero-{{ section.id }} .fp-hero__sub{font-size:var(--fp-hero-sub-desktop)}
    #FridayHero-{{ section.id }} .fp-btn{font-size:var(--fp-hero-button-desktop);text-transform:none}
    #FridayHero-{{ section.id }} .fp-hero__scene--curated{display:flex;align-items:center;justify-content:center;padding:20px 0}
    #FridayHero-{{ section.id }} .fp-hero__scene--curated img{display:block;width:auto;max-width:100%;height:auto;max-height:calc(100% - 40px);object-fit:contain;object-position:center center;margin:auto}

    /* Approved composite artwork mode: shadows, perspective and frame depth live in the artwork itself. */
    #FridayHero-{{ section.id }} .fp-hero__scene--composite{
      display:flex;
      align-items:center;
      justify-content:center;
      align-self:stretch;
      min-width:0;
      height:100%;
      overflow:visible;
    }
    #FridayHero-{{ section.id }} .fp-hero__scene--composite picture{
      display:block;
      width:min(100%,780px);
      transform:translate3d(1.5%,-1%,0);
    }
    #FridayHero-{{ section.id }} .fp-hero__scene--composite img{
      display:block;
      width:100%;
      height:auto;
      max-height:min(70vh,680px);
      object-fit:contain;
      object-position:center;
    }

    /* Editable layered-stack fallback. */
    #FridayHero-{{ section.id }} .fp-hero__scene--stack{
      position:relative;
      display:block;
      align-self:stretch;
      min-width:0;
      height:100%;
      overflow:visible;
      isolation:isolate;
    }
    #FridayHero-{{ section.id }} .fp-hero-stack__card{
      --fp-card-transform:rotate(0deg);
      position:absolute;
      display:block;
      color:inherit;
      text-decoration:none;
      transform:var(--fp-card-transform);
      transform-origin:50% 82%;
      transition:transform .42s cubic-bezier(.2,.7,.2,1),filter .42s ease;
      will-change:transform;
    }
    #FridayHero-{{ section.id }} .fp-hero-stack__card:focus-visible{outline:2px solid var(--fp-ink,#17120f);outline-offset:5px}
    #FridayHero-{{ section.id }} .fp-hero-stack__frame{
      background:var(--fp-red-text,#c9362e);
      padding:9px;
      box-shadow:0 14px 30px rgba(23,18,15,.08);
      animation:fpHeroStackSettle .72s cubic-bezier(.2,.7,.2,1) both;
    }
    #FridayHero-{{ section.id }} .fp-hero-stack__mat{background:var(--fp-cream,#fffdf8);padding:9px}
    #FridayHero-{{ section.id }} .fp-hero-stack__card img{
      display:block;
      width:100%;
      height:auto;
      aspect-ratio:.707;
      object-fit:contain;
      background:var(--fp-cream,#fffdf8);
    }
    #FridayHero-{{ section.id }} .fp-hero-stack__card--left{--fp-card-transform:rotate(-1.6deg);width:min(36%,300px);left:5%;top:28%;z-index:1}
    #FridayHero-{{ section.id }} .fp-hero-stack__card--primary{--fp-card-transform:rotate(.7deg);width:min(49%,420px);left:34%;top:5%;z-index:3}
    #FridayHero-{{ section.id }} .fp-hero-stack__card--right{--fp-card-transform:rotate(1.7deg);width:min(32%,275px);right:2%;top:31%;z-index:2}
    #FridayHero-{{ section.id }} .fp-hero-stack__card--left .fp-hero-stack__frame{animation-delay:.08s}
    #FridayHero-{{ section.id }} .fp-hero-stack__card--primary .fp-hero-stack__frame{animation-delay:.14s}
    #FridayHero-{{ section.id }} .fp-hero-stack__card--right .fp-hero-stack__frame{animation-delay:.2s}

    @keyframes fpHeroStackSettle{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

    @media(hover:hover) and (pointer:fine){
      #FridayHero-{{ section.id }} .fp-hero-stack__card:hover{transform:var(--fp-card-transform) translateY(-4px) scale(1.012);filter:saturate(1.025)}
    }

    @media(max-width:1100px) and (min-width:901px){
      #FridayHero-{{ section.id }} .fp-hero__scene--composite picture{width:min(102%,680px);transform:translate3d(1%,-1%,0)}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--left{width:min(35%,250px);left:3%;top:31%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--primary{width:min(50%,350px);left:32%;top:7%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--right{width:min(31%,220px);right:1%;top:34%}
    }

    @media(max-width:900px) and (min-width:750px){
      #FridayHero-{{ section.id }} .fp-hero h1{font-size:clamp(66px,7.2vw,84px)}
      #FridayHero-{{ section.id }} .fp-hero__kicker{font-size:14px}
      #FridayHero-{{ section.id }} .fp-hero__sub{font-size:14px}
      #FridayHero-{{ section.id }} .fp-btn{font-size:12px}
      #FridayHero-{{ section.id }} .fp-hero__scene--composite{min-height:500px}
      #FridayHero-{{ section.id }} .fp-hero__scene--composite picture{width:min(104%,610px);transform:none}
      #FridayHero-{{ section.id }} .fp-hero__scene--stack{height:100%;min-height:520px}
      #FridayHero-{{ section.id }} .fp-hero-stack__frame{padding:7px;box-shadow:0 12px 24px rgba(23,18,15,.07)}
      #FridayHero-{{ section.id }} .fp-hero-stack__mat{padding:7px}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--left{width:44%;left:0;top:36%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--primary{width:57%;left:29%;top:9%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--right{width:40%;right:-2%;top:39%}
    }

    @media(max-width:749px){
      #FridayHero-{{ section.id }} .fp-hero__kicker{font-size:var(--fp-hero-kicker-mobile)}
      #FridayHero-{{ section.id }} .fp-hero h1{font-size:clamp(58px,18vw,var(--fp-hero-title-mobile));max-width:360px}
      #FridayHero-{{ section.id }} .fp-hero__sub{font-size:var(--fp-hero-sub-mobile)}
      #FridayHero-{{ section.id }} .fp-btn{font-size:var(--fp-hero-button-mobile)}
      #FridayHero-{{ section.id }} .fp-hero__scene--curated{width:100vw;margin-left:calc(50% - 50vw);padding:0;overflow:hidden}
      #FridayHero-{{ section.id }} .fp-hero__scene--curated picture{display:block;width:100%;aspect-ratio:6/5;overflow:hidden}
      #FridayHero-{{ section.id }} .fp-hero__scene--curated img{width:100%;max-width:none;height:100%;max-height:none;margin:0;object-fit:cover;object-position:center 50%}

      #FridayHero-{{ section.id }} .fp-hero__scene--composite{
        width:calc(100% + 24px);
        height:auto;
        min-height:0;
        margin:8px 0 0 -12px;
        padding:0;
        overflow:visible;
      }
      #FridayHero-{{ section.id }} .fp-hero__scene--composite picture{width:min(100%,430px);transform:none;margin:0 auto}
      #FridayHero-{{ section.id }} .fp-hero__scene--composite img{width:100%;max-height:none;height:auto}

      #FridayHero-{{ section.id }} .fp-hero__scene--stack{width:calc(100% + 40px);height:min(79vw,310px);min-height:270px;margin:2px 0 0 -20px;overflow:hidden}
      #FridayHero-{{ section.id }} .fp-hero-stack__frame{padding:5px;box-shadow:0 8px 18px rgba(23,18,15,.065)}
      #FridayHero-{{ section.id }} .fp-hero-stack__mat{padding:5px}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--left{--fp-card-transform:rotate(-2deg);width:41%;left:2%;top:25%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--primary{--fp-card-transform:translateX(-50%) rotate(.6deg);width:54%;max-width:222px;left:50%;top:5%}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--right{--fp-card-transform:rotate(2deg);width:39%;right:1%;top:29%}
    }

    @media(max-width:360px){
      #FridayHero-{{ section.id }} .fp-hero__scene--composite{width:calc(100% + 16px);margin-left:-8px}
      #FridayHero-{{ section.id }} .fp-hero__scene--stack{height:282px;min-height:250px}
      #FridayHero-{{ section.id }} .fp-hero-stack__card--primary{width:55%;max-width:190px}
    }

    @media(prefers-reduced-motion:reduce){
      #FridayHero-{{ section.id }} .fp-hero-stack__card,
      #FridayHero-{{ section.id }} .fp-hero-stack__frame{transition:none;animation:none}
      #FridayHero-{{ section.id }} .fp-hero-stack__card:hover{transform:var(--fp-card-transform);filter:none}
    }
  </style>

  <div class="fp-shell fp-hero__grid">
    <div class="fp-hero__copy">
      {% if section.settings.kicker != blank %}<p class="fp-hero__kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.title_top != blank or section.settings.title_bottom != blank %}
        <h1>{{ section.settings.title_top }}{% if section.settings.title_bottom != blank %}<span>{{ section.settings.title_bottom }}</span>{% endif %}</h1>
      {% endif %}
      {% if section.settings.subtitle != blank %}<p class="fp-hero__sub">{{ section.settings.subtitle }}</p>{% endif %}
      {% if section.settings.world_line != blank %}<p class="fp-hero__world">{{ section.settings.world_line }}</p>{% endif %}
      {% if section.settings.shop_label != blank or section.settings.collection_label != blank %}
        <div class="fp-hero__buttons">
          {% if section.settings.shop_label != blank and section.settings.shop_link != blank %}<a class="fp-btn fp-btn--solid" href="{{ section.settings.shop_link }}">{{ section.settings.shop_label }}</a>{% endif %}
          {% if section.settings.collection_label != blank and section.settings.collection_link != blank %}<a class="fp-btn" href="{{ section.settings.collection_link }}">{{ section.settings.collection_label }}</a>{% endif %}
        </div>
      {% endif %}
    </div>

    {% if art_mode == 'composite_image' and section.settings.composite_desktop != blank %}
      <div class="fp-hero__scene fp-hero__scene--composite" aria-label="Featured Friday Prints">
        <picture>
          {% if section.settings.composite_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.composite_mobile | image_url: width: 1200 }}">{% endif %}
          {{ section.settings.composite_desktop | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1500,1800', sizes: '(max-width: 749px) 100vw, 58vw', alt: section.settings.hero_alt }}
        </picture>
      </div>
    {% elsif art_mode == 'print_stack' %}
      <div class="fp-hero__scene fp-hero__scene--stack" aria-label="Featured Friday Prints">
        {% if stack_left_product != blank and stack_left_product.featured_image != blank %}
          <a class="fp-hero-stack__card fp-hero-stack__card--left" href="{{ stack_left_product.url }}" aria-label="View {{ stack_left_product.title | escape }}">
            <span class="fp-hero-stack__frame"><span class="fp-hero-stack__mat">{{ stack_left_product.featured_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '240,360,480,600,720', sizes: '(max-width: 749px) 41vw, (max-width: 900px) 25vw, 22vw', alt: stack_left_alt }}</span></span>
          </a>
        {% endif %}
        {% if stack_primary_product != blank and stack_primary_product.featured_image != blank %}
          <a class="fp-hero-stack__card fp-hero-stack__card--primary" href="{{ stack_primary_product.url }}" aria-label="View {{ stack_primary_product.title | escape }}">
            <span class="fp-hero-stack__frame"><span class="fp-hero-stack__mat">{{ stack_primary_product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '320,480,640,800,1000', sizes: '(max-width: 749px) 54vw, (max-width: 900px) 33vw, 30vw', alt: stack_primary_alt }}</span></span>
          </a>
        {% endif %}
        {% if stack_right_product != blank and stack_right_product.featured_image != blank %}
          <a class="fp-hero-stack__card fp-hero-stack__card--right" href="{{ stack_right_product.url }}" aria-label="View {{ stack_right_product.title | escape }}">
            <span class="fp-hero-stack__frame"><span class="fp-hero-stack__mat">{{ stack_right_product.featured_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '240,360,480,600,720', sizes: '(max-width: 749px) 39vw, (max-width: 900px) 23vw, 20vw', alt: stack_right_alt }}</span></span>
          </a>
        {% endif %}
      </div>
    {% elsif art_mode == 'custom_image' and section.settings.hero_scene != blank %}
      <div class="fp-hero__scene">
        {{ section.settings.hero_scene | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1200,1500,1800', sizes: '(max-width: 749px) 100vw, 62vw', alt: section.settings.hero_alt }}
      </div>
    {% else %}
      <div class="fp-hero__scene fp-hero__scene--curated">
        <picture>
          <source media="(max-width: 749px)" srcset="{{ 'friday-hero-clean-mobile.webp' | asset_url }}">
          <img src="{{ 'friday-hero-clean.webp' | asset_url }}" width="1448" height="1086" loading="eager" fetchpriority="high" decoding="async" alt="{{ section.settings.hero_alt | escape }}">
        </picture>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Friday hero",
  "settings": [
    { "type": "select", "id": "height_mode", "label": "Hero height", "default": "viewport", "options": [
      { "value": "viewport", "label": "Fill first screen" },
      { "value": "content", "label": "Fit content" }
    ] },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "title_size_desktop", "label": "Title size — desktop", "min": 90, "max": 126, "step": 2, "unit": "px", "default": 108 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size — mobile", "min": 60, "max": 82, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "kicker_size_desktop", "label": "Kicker size — desktop", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "kicker_size_mobile", "label": "Kicker size — mobile", "min": 11, "max": 15, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Subtitle size — desktop", "min": 15, "max": 21, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "subtitle_size_mobile", "label": "Subtitle size — mobile", "min": 11, "max": 15, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "button_size_desktop", "label": "Button text — desktop", "min": 12, "max": 17, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "button_size_mobile", "label": "Button text — mobile", "min": 9, "max": 13, "step": 1, "unit": "px", "default": 10 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "LIMITED-EDITION ART PRINTS" },
    { "type": "text", "id": "title_top", "label": "Title line 1", "default": "friday" },
    { "type": "text", "id": "title_bottom", "label": "Title line 2", "default": "prints" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Art prints made for long weekends & loud lines." },
    { "type": "text", "id": "world_line", "label": "World line", "default": "FROM THE WORLD OF GiGi" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "shop_label", "label": "Primary button label", "default": "shop prints" },
    { "type": "url", "id": "shop_link", "label": "Primary button link" },
    { "type": "text", "id": "collection_label", "label": "Secondary button label", "default": "Meet GiGi" },
    { "type": "url", "id": "collection_link", "label": "Secondary button link" },
    { "type": "header", "content": "Artwork" },
    { "type": "select", "id": "art_mode", "label": "Hero artwork layout", "default": "print_stack", "options": [
      { "value": "composite_image", "label": "Composite artwork — approved" },
      { "value": "print_stack", "label": "Layered print stack — editable" },
      { "value": "legacy_curated", "label": "Single framed print — legacy" },
      { "value": "custom_image", "label": "Custom single image" }
    ] },
    { "type": "image_picker", "id": "composite_desktop", "label": "Composite artwork — desktop / tablet" },
    { "type": "image_picker", "id": "composite_mobile", "label": "Composite artwork — mobile" },
    { "type": "product", "id": "stack_primary", "label": "Print stack — main print" },
    { "type": "product", "id": "stack_left", "label": "Print stack — left print" },
    { "type": "product", "id": "stack_right", "label": "Print stack — right print" },
    { "type": "checkbox", "id": "use_curated_scene", "label": "Legacy compatibility — curated scene", "default": true },
    { "type": "image_picker", "id": "hero_scene", "label": "Custom / legacy hero artwork" },
    { "type": "text", "id": "hero_alt", "label": "Hero artwork alt text", "default": "Friday Prints hero artwork" },
    { "type": "text", "id": "empty_message", "label": "Editor placeholder text", "default": "Select the hero artwork in this section." }
  ],
  "presets": [{ "name": "Friday hero" }]
}
{% endschema %}
<section class="fp-hero" id="FPHero-{{ section.id }}">
  <div class="fp-hero__inner">
    <h1 class="fp-hero__title" aria-label="{{ section.settings.title | escape }}">
      <span class="fp-hero__title-line">FRIDAY</span>
      <span class="fp-hero__title-line">PRINTS :)</span>
    </h1>

    {% if section.settings.hero_image != blank %}
      <div class="fp-hero__art" aria-hidden="true">
        {{
          section.settings.hero_image
          | image_url: width: 1600
          | image_tag:
            class: 'fp-hero__gigi',
            widths: '360, 480, 640, 800, 1000, 1200, 1600',
            sizes: '(max-width: 749px) 72vw, (max-width: 1100px) 48vw, 42vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </div>
    {% endif %}

    <div class="fp-hero__bottom">
      {% if section.settings.tagline != blank %}
        <p class="fp-hero__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="fp-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.button_label }}</span><span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friday Prints hero",
  "tag": "section",
  "class": "fp-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Accessible title", "default": "FRIDAY PRINTS :)" },
    { "type": "image_picker", "id": "hero_image", "label": "GiGi transparent PNG" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "MADE FOR LONG WEEKENDS & LOUD LINES." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP PRINTS" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Friday Prints hero" } ]
}
{% endschema %}

<section class="fr-section fr-hero" id="FridayHero-{{ section.id }}">
  <div class="fr-shell fr-hero__grid">
    <div class="fr-hero__copy">
      <p class="fr-kicker"><b>01</b> — MEET GiGi</p>
      <h1>{{ section.settings.title_top }}<span>{{ section.settings.title_bottom }}<i>.</i></span></h1>
      <p class="fr-hero__sub">{{ section.settings.subtitle }}</p>
      <a class="fr-hero__link" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }} <span aria-hidden="true">→</span></a>
      <div class="fr-hero__scroll" aria-hidden="true">scroll</div>
    </div>
    <div class="fr-hero__scene" aria-label="Meet GiGi">
      <div class="fr-hero__panel" aria-hidden="true"></div>
      <img class="fr-hero__art" src="{{ 'friday-gigi-hero.png' | asset_url }}" width="520" height="520" alt="GiGi" loading="eager" fetchpriority="high" onerror="this.onerror=null;this.src='{{ 'friday-gigi-nav.png' | asset_url }}';this.classList.add('fr-hero__art--fallback');">
      <div class="fr-hero__note" aria-hidden="true">GiGi x</div>
    </div>
    <div class="fr-hero__numbers" aria-hidden="true"><b>01</b><span>02</span><span>03</span><span>04</span><span>05</span><span>06</span></div>
  </div>
</section>
{% schema %}
{"name":"Friday hero","settings":[{"type":"text","id":"title_top","label":"Title line 1","default":"GiGi’s"},{"type":"text","id":"title_bottom","label":"Title line 2","default":"journey"},{"type":"textarea","id":"subtitle","label":"Subtitle","default":"Art prints made for long weekends & loud lines."},{"type":"text","id":"shop_label","label":"Shop link","default":"explore prints"},{"type":"url","id":"shop_link","label":"Shop URL"}],"presets":[{"name":"Friday hero"}]}
{% endschema %}
<section class="fr-section fr-hero" id="FridayHero-{{ section.id }}">
  <div class="fr-shell fr-hero__grid">
    <div class="fr-hero__copy">
      <p class="fr-kicker">{{ section.settings.kicker }}</p>
      <h1>{{ section.settings.title_top }}<span>{{ section.settings.title_bottom }}</span></h1>
      <p class="fr-hero__sub">{{ section.settings.subtitle }}</p>
      <div class="fr-actions">
        <a class="fr-btn fr-btn--solid" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }} <span aria-hidden="true">→</span></a>
        <a class="fr-btn" href="{{ section.settings.collection_link | default: routes.collections_url }}">{{ section.settings.collection_label }}</a>
      </div>
      <div class="fr-hero__stamp" aria-hidden="true"><span>made for long weekends</span><b>✳</b><span>&amp; loud lines</span></div>
    </div>
    <div class="fr-hero__scene">
      <img src="{{ 'friday-hero-verified.jpg' | asset_url }}" width="480" height="432" alt="Framed seated GiGi print with striped mug, floral vase and limited edition badge" loading="eager" fetchpriority="high">
    </div>
  </div>
  <div class="fr-scallop" aria-hidden="true"></div>
</section>
{% schema %}
{"name":"Friday hero","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"welcome to"},{"type":"text","id":"title_top","label":"Title line 1","default":"GiGi’s"},{"type":"text","id":"title_bottom","label":"Title line 2","default":"journey"},{"type":"textarea","id":"subtitle","label":"Subtitle","default":"Art prints made for long weekends & loud lines."},{"type":"text","id":"shop_label","label":"Shop button","default":"shop prints"},{"type":"url","id":"shop_link","label":"Shop link"},{"type":"text","id":"collection_label","label":"Collection button","default":"explore the collection"},{"type":"url","id":"collection_link","label":"Collection link"}],"presets":[{"name":"Friday hero"}]}
{% endschema %}
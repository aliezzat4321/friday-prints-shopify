{% liquid
  assign fp_handle = page.handle | downcase
  assign all_prints = collections['all']
  assign fallback_gigi = images['F5B43C2C-B0F3-4A1F-863E-388E114DCF02_2.png']
  assign gigi_image = section.settings.about_gigi | default: fallback_gigi
%}

<section class="fp-content-page fp-content-page--{{ fp_handle }}" id="FridayPage-{{ section.id }}">
  <style>
    #FridayPage-{{ section.id }}{background:var(--fp-cream);color:var(--fp-ink)}
    #FridayPage-{{ section.id }} *{box-sizing:border-box}
    #FridayPage-{{ section.id }} .fp-page-hero{position:relative;overflow:hidden;padding:58px var(--fp-page-gutter,46px) 42px;border-bottom:1px solid var(--fp-line)}
    #FridayPage-{{ section.id }} .fp-page-eyebrow{margin:0 0 12px;color:var(--fp-red-text,var(--fp-red));font:700 10px/1 var(--fp-ui-font,"Courier New",monospace);letter-spacing:.09em;text-transform:uppercase}
    #FridayPage-{{ section.id }} .fp-page-title{max-width:12ch;margin:0;font:700 var(--fp-page-title,clamp(72px,8vw,112px))/.8 var(--fp-display-font,Georgia,"Times New Roman",serif);letter-spacing:-.055em;text-transform:none;text-wrap:balance}
    #FridayPage-{{ section.id }} .fp-page-intro{max-width:58ch;margin:24px 0 0;font:13px/1.62 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-page-intro p{margin:0}

    #FridayPage-{{ section.id }}.fp-content-page--info .fp-page-hero{background:var(--fp-yellow)}
    #FridayPage-{{ section.id }} .fp-guide__edition{display:grid;grid-template-columns:1.15fr repeat(3,1fr);border-bottom:1px solid var(--fp-ink)}
    #FridayPage-{{ section.id }} .fp-guide__edition>div{min-height:200px;padding:30px 28px;border-right:1px solid var(--fp-ink);display:flex;flex-direction:column;justify-content:space-between}
    #FridayPage-{{ section.id }} .fp-guide__edition>div:last-child{border-right:0}
    #FridayPage-{{ section.id }} .fp-guide__edition h2{margin:0;font:italic 34px/1 var(--fp-display-font,Georgia,"Times New Roman",serif);color:var(--fp-red)}
    #FridayPage-{{ section.id }} .fp-guide__edition strong{display:block;font:700 50px/.9 var(--fp-display-font,Georgia,"Times New Roman",serif);letter-spacing:-.04em}
    #FridayPage-{{ section.id }} .fp-guide__edition span{font:10px/1.4 var(--fp-ui-font,"Courier New",monospace);text-transform:uppercase;letter-spacing:.055em}
    #FridayPage-{{ section.id }} .fp-guide__cards{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--fp-ink)}
    #FridayPage-{{ section.id }} .fp-guide-card{min-height:310px;padding:38px 32px;border-right:1px solid var(--fp-ink);position:relative;overflow:hidden}
    #FridayPage-{{ section.id }} .fp-guide-card:last-child{border-right:0}
    #FridayPage-{{ section.id }} .fp-guide-card:nth-child(1){background:var(--fp-cream)}
    #FridayPage-{{ section.id }} .fp-guide-card:nth-child(2){background:var(--fp-pink)}
    #FridayPage-{{ section.id }} .fp-guide-card:nth-child(3){background:var(--fp-green-text,var(--fp-green));color:#fff}
    #FridayPage-{{ section.id }} .fp-guide-card__num{position:absolute;right:20px;top:15px;font:700 58px/.8 var(--fp-display-font,Georgia,serif);opacity:.14}
    #FridayPage-{{ section.id }} .fp-guide-card h3{margin:0 0 22px;font:700 26px/.95 var(--fp-display-font,Georgia,"Times New Roman",serif);letter-spacing:-.035em}
    #FridayPage-{{ section.id }} .fp-guide-card .rte{max-width:37ch;font:12px/1.62 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-guide-card .rte p{margin:0 0 13px}
    #FridayPage-{{ section.id }} .fp-guide__care{display:grid;grid-template-columns:.75fr 1.25fr;gap:64px;padding:58px var(--fp-page-gutter,46px) 64px;background:var(--fp-cream)}
    #FridayPage-{{ section.id }} .fp-guide__care h2{margin:0;font:italic 40px/1 var(--fp-display-font,Georgia,"Times New Roman",serif);color:var(--fp-red)}
    #FridayPage-{{ section.id }} .fp-guide__care-copy{display:grid;grid-template-columns:1fr 1fr;gap:22px 40px}
    #FridayPage-{{ section.id }} .fp-guide__care-copy div{padding-top:13px;border-top:1px solid var(--fp-ink)}
    #FridayPage-{{ section.id }} .fp-guide__care-copy strong{display:block;margin-bottom:8px;font:700 10px/1 var(--fp-ui-font,"Courier New",monospace);text-transform:uppercase;letter-spacing:.06em}
    #FridayPage-{{ section.id }} .fp-guide__care-copy p{margin:0;font:11px/1.55 var(--fp-ui-font,"Courier New",monospace)}

    #FridayPage-{{ section.id }}.fp-content-page--faq .fp-page-hero{background:var(--fp-green-text,var(--fp-green));color:#fff}
    #FridayPage-{{ section.id }}.fp-content-page--faq .fp-page-eyebrow{color:var(--fp-yellow)}
    #FridayPage-{{ section.id }} .fp-faq{display:grid;grid-template-columns:.6fr 1.4fr;gap:64px;padding:60px var(--fp-page-gutter,46px) 72px;background:var(--fp-cream)}
    #FridayPage-{{ section.id }} .fp-faq__aside{position:sticky;top:28px;align-self:start}
    #FridayPage-{{ section.id }} .fp-faq__aside strong{display:block;margin-bottom:12px;color:var(--fp-red);font:italic 32px/1 var(--fp-display-font,Georgia,"Times New Roman",serif)}
    #FridayPage-{{ section.id }} .fp-faq__aside p{max-width:28ch;margin:0;font:11px/1.55 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-faq__aside a{color:inherit;text-underline-offset:3px}
    #FridayPage-{{ section.id }} .fp-faq__list{border-top:1px solid var(--fp-ink)}
    #FridayPage-{{ section.id }} .fp-faq details{border-bottom:1px solid var(--fp-ink)}
    #FridayPage-{{ section.id }} .fp-faq summary{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px;cursor:pointer;list-style:none;font:700 13px/1.35 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-faq summary::-webkit-details-marker{display:none}
    #FridayPage-{{ section.id }} .fp-faq summary:after{content:"+";flex:0 0 auto;color:var(--fp-red);font:400 24px/1 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-faq details[open] summary:after{content:"−"}
    #FridayPage-{{ section.id }} .fp-faq__answer{max-width:68ch;padding:0 48px 24px 0;font:12px/1.65 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-faq__answer p{margin:0 0 10px}

    #FridayPage-{{ section.id }} .fp-generic-page{padding:58px var(--fp-page-gutter,46px) 82px;background:var(--fp-cream)}
    #FridayPage-{{ section.id }} .fp-generic-page h1{max-width:12ch;margin:0 0 34px;font:700 clamp(62px,7vw,100px)/.82 var(--fp-display-font,Georgia,"Times New Roman",serif);letter-spacing:-.055em;text-transform:lowercase}
    #FridayPage-{{ section.id }} .fp-generic-page__content{max-width:760px;font:13px/1.7 var(--fp-ui-font,"Courier New",monospace)}
    #FridayPage-{{ section.id }} .fp-generic-page__content a{color:inherit;text-underline-offset:3px}

    @media(max-width:1000px){
      #FridayPage-{{ section.id }} .fp-guide__care,#FridayPage-{{ section.id }} .fp-faq{gap:40px;padding-inline:var(--fp-page-gutter,28px)}
      #FridayPage-{{ section.id }} .fp-page-hero{padding-inline:var(--fp-page-gutter,28px)}
      #FridayPage-{{ section.id }} .fp-guide__edition{grid-template-columns:1fr 1fr}
      #FridayPage-{{ section.id }} .fp-guide__edition>div:nth-child(1),#FridayPage-{{ section.id }} .fp-guide__edition>div:nth-child(2){border-bottom:1px solid var(--fp-ink)}
      #FridayPage-{{ section.id }} .fp-guide__edition>div:nth-child(2n){border-right:0}
    }
    @media(max-width:749px){
      #FridayPage-{{ section.id }} .fp-page-hero{padding:42px var(--fp-page-gutter,20px) 32px}
      #FridayPage-{{ section.id }} .fp-page-title{font-size:60px}
      #FridayPage-{{ section.id }} .fp-page-intro{font-size:12px;margin-top:18px}
      #FridayPage-{{ section.id }} .fp-guide__edition{grid-template-columns:1fr 1fr}
      #FridayPage-{{ section.id }} .fp-guide__edition>div{min-height:154px;padding:22px 20px}
      #FridayPage-{{ section.id }} .fp-guide__edition h2{font-size:27px}
      #FridayPage-{{ section.id }} .fp-guide__edition strong{font-size:40px}
      #FridayPage-{{ section.id }} .fp-guide__cards{grid-template-columns:1fr}
      #FridayPage-{{ section.id }} .fp-guide-card{min-height:0;padding:34px 20px 40px;border-right:0;border-bottom:1px solid var(--fp-ink)}
      #FridayPage-{{ section.id }} .fp-guide-card:last-child{border-bottom:0}
      #FridayPage-{{ section.id }} .fp-guide__care{grid-template-columns:1fr;gap:28px;padding:42px var(--fp-page-gutter,20px) 50px}
      #FridayPage-{{ section.id }} .fp-guide__care h2{font-size:34px}
      #FridayPage-{{ section.id }} .fp-guide__care-copy{grid-template-columns:1fr;gap:18px}
      #FridayPage-{{ section.id }} .fp-faq{grid-template-columns:1fr;gap:32px;padding:42px var(--fp-page-gutter,20px) 58px}
      #FridayPage-{{ section.id }} .fp-faq__aside{position:relative;top:auto}
      #FridayPage-{{ section.id }} .fp-faq summary{min-height:64px;font-size:12px}
      #FridayPage-{{ section.id }} .fp-faq__answer{padding-right:22px;font-size:11px}
      #FridayPage-{{ section.id }} .fp-generic-page{padding:42px var(--fp-page-gutter,20px) 66px}
      #FridayPage-{{ section.id }} .fp-generic-page h1{font-size:56px}
      #FridayPage-{{ section.id }} .fp-generic-page__content{font-size:12px}
    }
  </style>

  {% case fp_handle %}
    {% when 'about' %}
      <div class="fp-page-hero">
        <div class="fp-page-hero__copy">
          {% if section.settings.about_eyebrow != blank %}<p class="fp-page-eyebrow">{{ section.settings.about_eyebrow }}</p>{% endif %}
          <h1 class="fp-page-title">{{ section.settings.about_title }}</h1>
          {% if section.settings.about_intro != blank %}<div class="fp-page-intro"><p>{{ section.settings.about_intro }}</p></div>{% endif %}
        </div>
        <figure class="fp-world__gigi">
          {% if gigi_image %}
            {{ gigi_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '320,480,640,760,900', sizes: '(max-width:749px) 78vw, (max-width:1000px) 38vw, 430px', alt: section.settings.about_gigi_alt }}
          {% endif %}
          <figcaption style="text-transform:none"><span>GiGi / CHARACTER 001 / CAIRO</span><em>still wandering.</em></figcaption>
        </figure>
      </div>
      {% if section.settings.about_ticker != blank %}
        {% assign ticker_items = section.settings.about_ticker | split: ',' %}
        <div class="fp-world__ticker" aria-hidden="true"><div class="fp-world__ticker-track">{% for repeat in (1..2) %}{% for item in ticker_items %}<span>{{ item | strip }}</span>{% endfor %}{% endfor %}</div></div>
      {% endif %}
      <div class="fp-world__story">
        <div class="fp-world__story-lead">
          <h2>{{ section.settings.about_story_title }}</h2>
          <dl class="fp-world__facts">
            <div><dt>ORIGIN</dt><dd>CAIRO</dd></div>
            <div><dt>ARRIVED</dt><dd>A QUIET FRIDAY NIGHT</dd></div>
            <div><dt>COLLECTS</dt><dd>MOODS, QUIRKS &amp; ADVENTURES</dd></div>
          </dl>
        </div>
        <div class="fp-world__copy rte">{{ section.settings.about_story }}</div>
      </div>
      <section class="fp-world__archive" aria-labelledby="FridayWorldArchive-{{ section.id }}">
        <div class="fp-world__gallery-head">
          <div><p>THE ARCHIVE / CURATED FIELD NOTES</p><h2 id="FridayWorldArchive-{{ section.id }}">{{ section.settings.about_gallery_title }}</h2></div>
          {% if all_prints != blank %}<a href="{{ all_prints.url }}">{{ section.settings.about_gallery_cta }}</a>{% endif %}
        </div>
        <div class="fp-world__gallery">
          {% assign archive_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'world_product' and block.settings.product != blank %}
              {% assign archive_product = block.settings.product %}
              {% assign archive_index = archive_index | plus: 1 %}
              {% capture archive_number %}{% if archive_index < 10 %}0{% endif %}{{ archive_index }}{% endcapture %}
              {% assign archive_note = block.settings.note %}
              {% assign archive_alt = archive_product.featured_image.alt | default: archive_product.title %}
              {% if archive_note == blank %}
                {% if archive_product.handle contains '-a3' %}{% assign archive_note = 'LIMITED EDITION / A3' %}
                {% elsif archive_product.handle contains '-a4' %}{% assign archive_note = 'LIMITED EDITION / A4' %}
                {% else %}{% assign archive_note = 'LIMITED EDITION ART PRINT' %}{% endif %}
              {% endif %}
              <article class="fp-world-card" data-index="{{ archive_number | strip }}" {{ block.shopify_attributes }}>
                <a class="fp-world-card__link" href="{{ archive_product.url }}" aria-label="View {{ archive_product.title | escape }}">
                  <div class="fp-world-card__media">
                    {{ archive_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000,1200,1400', sizes: '(max-width:749px) 78vw, (max-width:1000px) 44vw, 48vw', alt: archive_alt }}
                    <span class="fp-world-card__open" aria-hidden="true">VIEW PRINT ↗</span>
                  </div>
                  <div class="fp-world-card__caption"><span>{{ archive_number }}</span><h3>{{ archive_product.title }}</h3><p>{{ archive_note }}</p></div>
                </a>
              </article>
            {% endif %}
          {% endfor %}

          {% if archive_index == 0 and all_prints != blank %}
            {% for archive_product in all_prints.products limit: 5 %}
              {% assign archive_index = archive_index | plus: 1 %}
              {% capture archive_number %}{% if archive_index < 10 %}0{% endif %}{{ archive_index }}{% endcapture %}
              {% assign archive_alt = archive_product.featured_image.alt | default: archive_product.title %}
              <article class="fp-world-card" data-index="{{ archive_number | strip }}">
                <a class="fp-world-card__link" href="{{ archive_product.url }}" aria-label="View {{ archive_product.title | escape }}">
                  <div class="fp-world-card__media">
                    {{ archive_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000,1200,1400', sizes: '(max-width:749px) 78vw, (max-width:1000px) 44vw, 48vw', alt: archive_alt }}
                    <span class="fp-world-card__open" aria-hidden="true">VIEW PRINT ↗</span>
                  </div>
                  <div class="fp-world-card__caption"><span>{{ archive_number }}</span><h3>{{ archive_product.title }}</h3><p>LIMITED EDITION ART PRINT</p></div>
                </a>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </section>
      <div class="fp-world__closing">
        <p>GiGi is still wandering.</p>
        {% if all_prints != blank %}<a href="{{ all_prints.url }}">follow the journey <span aria-hidden="true">→</span></a>{% endif %}
      </div>

    {% when 'info' %}
      <div class="fp-page-hero">
        {% if section.settings.info_eyebrow != blank %}<p class="fp-page-eyebrow">{{ section.settings.info_eyebrow }}</p>{% endif %}
        <h1 class="fp-page-title">{{ section.settings.info_title }}</h1>
        {% if section.settings.info_intro != blank %}<div class="fp-page-intro"><p>{{ section.settings.info_intro }}</p></div>{% endif %}
      </div>
      <div class="fp-guide__edition">
        <div><h2>{{ section.settings.info_limited_title }}</h2><span>{{ section.settings.info_limited_note }}</span></div>
        <div><strong>{{ section.settings.info_a3_number }}</strong><span>{{ section.settings.info_a3_label }}</span></div>
        <div><strong>{{ section.settings.info_a4_number }}</strong><span>{{ section.settings.info_a4_label }}</span></div>
        <div><strong>{{ section.settings.info_postcard_number }}</strong><span>{{ section.settings.info_postcard_label }}</span></div>
      </div>
      <div class="fp-guide__cards">
        <article class="fp-guide-card"><span class="fp-guide-card__num">01</span><h3>{{ section.settings.guide_card_1_title }}</h3><div class="rte">{{ section.settings.guide_card_1_body }}</div></article>
        <article class="fp-guide-card"><span class="fp-guide-card__num">02</span><h3>{{ section.settings.guide_card_2_title }}</h3><div class="rte">{{ section.settings.guide_card_2_body }}</div></article>
        <article class="fp-guide-card"><span class="fp-guide-card__num">03</span><h3>{{ section.settings.guide_card_3_title }}</h3><div class="rte">{{ section.settings.guide_card_3_body }}</div></article>
      </div>
      <div class="fp-guide__care">
        <h2>{{ section.settings.guide_care_title }}</h2>
        <div class="fp-guide__care-copy">
          <div><strong>{{ section.settings.care_1_title }}</strong><p>{{ section.settings.care_1_body }}</p></div>
          <div><strong>{{ section.settings.care_2_title }}</strong><p>{{ section.settings.care_2_body }}</p></div>
          <div><strong>{{ section.settings.care_3_title }}</strong><p>{{ section.settings.care_3_body }}</p></div>
          <div><strong>{{ section.settings.care_4_title }}</strong><p>{{ section.settings.care_4_body }}</p></div>
        </div>
      </div>

    {% when 'faq' %}
      <div class="fp-page-hero">
        {% if section.settings.faq_eyebrow != blank %}<p class="fp-page-eyebrow">{{ section.settings.faq_eyebrow }}</p>{% endif %}
        <h1 class="fp-page-title">{{ section.settings.faq_title }}</h1>
        {% if section.settings.faq_intro != blank %}<div class="fp-page-intro"><p>{{ section.settings.faq_intro }}</p></div>{% endif %}
      </div>
      <div class="fp-faq">
        <aside class="fp-faq__aside"><strong>{{ section.settings.faq_aside_title }}</strong><p>Email <a href="mailto:{{ section.settings.support_email | escape }}">{{ section.settings.support_email }}</a>{% if section.settings.instagram_url != blank %} or message <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>{% endif %}.</p></aside>
        <div class="fp-faq__list">
          {% for block in section.blocks %}{% if block.type == 'faq_item' %}<details {{ block.shopify_attributes }}{% if block.settings.open_by_default %} open{% endif %}><summary>{{ block.settings.question }}</summary><div class="fp-faq__answer rte">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}
        </div>
      </div>

    {% else %}
      <div class="fp-generic-page"><h1>{{ page.title }}</h1>{% if page.content != blank %}<div class="fp-generic-page__content rte">{{ page.content }}</div>{% endif %}</div>
  {% endcase %}
</section>

{% schema %}
{
  "name": "Friday page system",
  "settings": [
    { "type": "paragraph", "content": "Controls World of GiGi, Print Guide and FAQ. Other page handles use normal Shopify page content." },
    { "type": "header", "content": "World of GiGi" },
    { "type": "text", "id": "about_eyebrow", "label": "Eyebrow", "default": "MEET THE GIRL WITH THE LONG NECK" },
    { "type": "text", "id": "about_title", "label": "Title", "default": "world of GiGi" },
    { "type": "textarea", "id": "about_intro", "label": "Intro", "default": "One character, many moods, a growing collection of imagined places and unexpected company." },
    { "type": "image_picker", "id": "about_gigi", "label": "GiGi image" },
    { "type": "text", "id": "about_gigi_alt", "label": "GiGi image alt text", "default": "GiGi, the long-necked character behind Friday Prints" },
    { "type": "text", "id": "about_ticker", "label": "Ticker words", "info": "Separate items with commas.", "default": "moods, quirks, adventures, new friends, imagined worlds, loud lines" },
    { "type": "text", "id": "about_story_title", "label": "Story heading", "default": "how GiGi got here" },
    { "type": "richtext", "id": "about_story", "label": "Story", "default": "<p>friday prints began in Cairo on a quiet Friday night.</p><p>GiGi was created as a way to personify friends, their moods, quirks and adventures. Over time she became a character of her own, travelling through imagined worlds and collecting stories along the way.</p><p>Along the way she meets new friends, unexpected companions and curious characters, each bringing their own stories to the journey.</p><p>These prints are small fragments of that world.</p>" },
    { "type": "text", "id": "about_gallery_title", "label": "Gallery heading", "default": "fragments from the world" },
    { "type": "text", "id": "about_gallery_cta", "label": "Gallery link label", "default": "shop all prints →" },

    { "type": "header", "content": "Print Guide" },
    { "type": "text", "id": "info_eyebrow", "label": "Eyebrow", "default": "EVERYTHING BEFORE IT HITS THE WALL" },
    { "type": "text", "id": "info_title", "label": "Title", "default": "print guide" },
    { "type": "textarea", "id": "info_intro", "label": "Intro", "default": "What your Friday Print is made of, how the editions work, and how to keep it looking good." },
    { "type": "text", "id": "info_limited_title", "label": "Edition heading", "default": "limited, always." },
    { "type": "text", "id": "info_limited_note", "label": "Edition note", "default": "every Friday Print is part of a numbered edition" },
    { "type": "text", "id": "info_a3_number", "label": "A3 edition number", "default": "100" },
    { "type": "text", "id": "info_a3_label", "label": "A3 label", "default": "A3 editions per design" },
    { "type": "text", "id": "info_a4_number", "label": "A4 edition number", "default": "150" },
    { "type": "text", "id": "info_a4_label", "label": "A4 label", "default": "A4 editions per design" },
    { "type": "text", "id": "info_postcard_number", "label": "Postcard edition number", "default": "250" },
    { "type": "text", "id": "info_postcard_label", "label": "Postcard label", "default": "postcard editions per design" },
    { "type": "text", "id": "guide_card_1_title", "label": "Card 1 heading", "default": "premium matte paper" },
    { "type": "richtext", "id": "guide_card_1_body", "label": "Card 1 text", "default": "<p>Chosen for its rich colours and soft finish.</p><p>Matte paper can be sensitive, so it likes a little care before framing.</p>" },
    { "type": "text", "id": "guide_card_2_title", "label": "Card 2 heading", "default": "removable mount" },
    { "type": "richtext", "id": "guide_card_2_body", "label": "Card 2 text", "default": "<p>Each print comes with a cardboard mount that holds it securely and helps protect it.</p><p>Keep it on for a clean, classic look or remove it to frame the work your own way.</p>" },
    { "type": "text", "id": "guide_card_3_title", "label": "Card 3 heading", "default": "tinted border" },
    { "type": "richtext", "id": "guide_card_3_body", "label": "Card 3 text", "default": "<p>There is a tinted coloured border around the artwork.</p><p>Remove the mount and the border is revealed, adding a subtle framed look.</p>" },
    { "type": "text", "id": "guide_care_title", "label": "Care heading", "default": "handle with care" },
    { "type": "text", "id": "care_1_title", "label": "Care 1 heading", "default": "edition number" },
    { "type": "textarea", "id": "care_1_body", "label": "Care 1 text", "default": "You’ll find the edition number for your piece on the back of the print." },

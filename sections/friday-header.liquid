<header class="fp-site-header" id="FridayHeader-{{ section.id }}">
  <div class="fp-announcement">✦ {{ section.settings.announcement }} ✦</div>
  <div class="fp-nav-wrap" data-fp-nav-wrap>
    <div class="fp-shell fp-nav">
      <a class="fp-logo" href="{{ routes.root_url }}" aria-label="Friday Prints home"><span>friday</span><small>prints.art</small></a>
      <nav class="fp-nav__links" aria-label="Main navigation">
        <a href="{{ routes.root_url }}">home</a>
        <a href="{{ routes.collections_url }}">collections</a>
        <a href="/pages/about">about</a>
        <a href="/pages/info">info</a>
        <a href="/pages/faq">faq</a>
        <a href="/pages/contact">contact</a>
      </nav>
      <div class="fp-nav__actions">
        <a class="fp-instagram" href="{{ section.settings.instagram_url | default: '#' }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></a>
        <a class="fp-gigi-link" href="/pages/about" aria-label="Meet GiGi">
          {% if section.settings.gigi_icon != blank %}
            {{ section.settings.gigi_icon | image_url: width: 180 | image_tag: class: 'fp-nav__gigi', loading: 'eager', widths: '50,80,120,180', sizes: '44px', alt: 'GiGi' }}
          {% else %}
            <span class="fp-gigi-empty" aria-hidden="true">✦</span>
          {% endif %}
        </a>
        <a class="fp-cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><b>{{ cart.item_count }}</b></a>
        <details class="fp-menu"><summary aria-label="Open menu"><i></i><i></i></summary><nav class="fp-mobile-menu"><a href="{{ routes.root_url }}">home</a><a href="{{ routes.collections_url }}">collections</a><a href="/pages/about">about</a><a href="/pages/info">info</a><a href="/pages/faq">faq</a><a href="/pages/contact">contact</a></nav></details>
      </div>
    </div>
  </div>
  <div class="fp-nav-spacer" data-fp-nav-spacer aria-hidden="true"></div>
</header>
<script>
(()=>{
  const header=document.getElementById('FridayHeader-{{ section.id }}');
  if(!header)return;
  const wrap=header.querySelector('[data-fp-nav-wrap]');
  const spacer=header.querySelector('[data-fp-nav-spacer]');
  const menu=header.querySelector('.fp-menu');
  if(!wrap||!spacer)return;
  let lastY=window.scrollY;
  let ticking=false;
  const sync=()=>{
    const y=window.scrollY;
    const floating=y>110;
    wrap.classList.toggle('is-floating',floating);
    spacer.classList.toggle('is-active',floating);
    if(floating){
      spacer.style.height=wrap.offsetHeight+'px';
      const menuOpen=menu&&menu.open;
      if(menuOpen||y<lastY-4){wrap.classList.remove('is-hidden');}
      else if(y>lastY+5&&y>160){wrap.classList.add('is-hidden');}
    }else{
      wrap.classList.remove('is-hidden');
      spacer.style.height='0px';
    }
    lastY=y;
    ticking=false;
  };
  window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(sync);ticking=true;}},{passive:true});
  window.addEventListener('resize',sync,{passive:true});
  if(menu)menu.addEventListener('toggle',()=>{if(menu.open)wrap.classList.remove('is-hidden');});
  sync();
})();
</script>
{% schema %}
{"name":"Friday header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"LIMITED EDITION ART PRINTS, MADE TO ORDER IN EGYPT"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"image_picker","id":"gigi_icon","label":"GiGi icon","info":"Upload/select the original GiGi artwork used in the navigation."}],"presets":[{"name":"Friday header"}]}
{% endschema %}
{{ 'friday-production.css' | asset_url | stylesheet_tag }}
<style>
  :root {
    --fp-cream: {{ section.settings.color_cream }};
    --fp-pink: {{ section.settings.color_pink }};
    --fp-red: {{ section.settings.color_red }};
    --fp-yellow: {{ section.settings.color_yellow }};
    --fp-green: {{ section.settings.color_green }};
    --fp-ink: {{ section.settings.color_ink }};
    --fp-newsletter: {{ section.settings.color_newsletter }};
  }
  #FridayHeader-{{ section.id }} {
    --fp-header-gigi-desktop: {{ section.settings.gigi_size_desktop }}px;
    --fp-header-gigi-mobile: {{ section.settings.gigi_size_mobile }}px;
    --fp-logo-image-width: {{ section.settings.logo_image_width }}px;
    position: relative;
    z-index: 90;
  }
  #FridayHeader-{{ section.id }} .fp-nav-wrap {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    transform: none !important;
    box-shadow: none !important;
  }
  #FridayHeader-{{ section.id }} .fp-search{display:grid;place-items:center;width:34px;height:34px;color:var(--fp-ink);text-decoration:none;flex:0 0 auto}
  #FridayHeader-{{ section.id }} .fp-search svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.7}

  /* Full-screen Friday menu — intentionally lives after friday-production.css so it wins the cascade. */
  @media (max-width: 900px) {
    html.fp-mobile-menu-open,
    body.fp-mobile-menu-open{overflow:hidden!important;overscroll-behavior:none}

    #FridayHeader-{{ section.id }} .fp-menu{position:static!important}
    #FridayHeader-{{ section.id }} .fp-menu>summary{
      position:relative;
      z-index:1003;
      width:38px;
      height:38px;
      display:grid;
      place-items:center;
      border:0;
      background:transparent;
      cursor:pointer;
    }
    #FridayHeader-{{ section.id }} .fp-menu>summary i{
      position:absolute;
      left:8px;
      width:22px;
      height:2px;
      margin:0!important;
      background:var(--fp-ink)!important;
      border:0!important;
      border-radius:99px;
      transition:transform .28s ease,top .28s ease;
    }
    #FridayHeader-{{ section.id }} .fp-menu>summary i:first-child{top:13px}
    #FridayHeader-{{ section.id }} .fp-menu>summary i:last-child{top:22px}
    #FridayHeader-{{ section.id }} .fp-menu[open]>summary{
      position:fixed!important;
      left:var(--fp-menu-button-left)!important;
      top:var(--fp-menu-button-top)!important;
      width:var(--fp-menu-button-width)!important;
      height:var(--fp-menu-button-height)!important;
      z-index:1004!important;
    }
    #FridayHeader-{{ section.id }}:has(.fp-menu[open]) .fp-logo{
      position:relative;
      z-index:1004!important;
    }
    #FridayHeader-{{ section.id }} .fp-menu[open]>summary i:first-child{top:18px;transform:rotate(45deg)}
    #FridayHeader-{{ section.id }} .fp-menu[open]>summary i:last-child{top:18px;transform:rotate(-45deg)}

    #FridayHeader-{{ section.id }} .fp-mobile-menu{
      display:flex!important;
      position:fixed!important;
      inset:0!important;
      width:100vw!important;
      max-width:none!important;
      height:100dvh!important;
      max-height:none!important;
      margin:0!important;
      padding:20px 22px 24px!important;
      overflow-y:auto!important;
      flex-direction:column!important;
      background:var(--fp-cream)!important;
      color:var(--fp-ink)!important;
      border:0!important;
      box-shadow:none!important;
      z-index:1002!important;
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:opacity .18s ease,visibility 0s linear .18s;
    }
    #FridayHeader-{{ section.id }} .fp-menu[open] .fp-mobile-menu{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
      transition:opacity .18s ease,visibility 0s;
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu{
      padding-top:112px!important;
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links{
      display:flex;
      flex:1 0 auto;
      flex-direction:column;
      justify-content:center;
      padding:24px 0 18px;
      counter-reset:fpMenuLink;
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links>a{
      counter-increment:fpMenuLink;
      position:relative;
      display:grid!important;
      grid-template-columns:30px minmax(0,1fr);
      align-items:baseline;
      gap:6px;
      min-height:0!important;
      padding:13px 0!important;
      color:var(--fp-ink)!important;
      text-decoration:none!important;
      border:0!important;
      border-bottom:1px solid color-mix(in srgb,var(--fp-ink) 18%,transparent)!important;
      font:700 clamp(31px,9.6vw,48px)/.92 Georgia,"Times New Roman",serif!important;
      letter-spacing:-.045em!important;
      text-transform:lowercase!important;
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links>a:before{
      content:"0" counter(fpMenuLink);
      color:var(--fp-red);
      font:700 9px/1 "Courier New",monospace;
      letter-spacing:0;
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links>a:last-child{border-bottom:0!important}
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links>a:active{color:var(--fp-red)!important}
    #FridayHeader-{{ section.id }} .fp-mobile-menu__bottom{
      display:block;
      padding-top:14px;
      border-top:1px solid color-mix(in srgb,var(--fp-ink) 16%,transparent);
    }
    #FridayHeader-{{ section.id }} .fp-mobile-menu__bottom p{
      margin:0;
      font:700 9px/1.35 "Courier New",monospace;
      letter-spacing:.035em;
      text-transform:uppercase;
    }
  }
  @media (max-width: 360px){
    #FridayHeader-{{ section.id }} .fp-mobile-menu{padding:16px 18px 20px!important}
    #FridayHeader-{{ section.id }} .fp-mobile-menu__links>a{font-size:30px!important;padding:10px 0!important}
  }
  @media (prefers-reduced-motion:reduce){
    #FridayHeader-{{ section.id }} .fp-mobile-menu,
    #FridayHeader-{{ section.id }} .fp-menu>summary i{transition:none!important}
  }
</style>
<header class="fp-site-header" id="FridayHeader-{{ section.id }}">
  {% if section.settings.show_announcement and section.settings.announcement != blank %}
    <div class="fp-announcement">
      {% if section.settings.announcement_symbol != blank %}<span aria-hidden="true">{{ section.settings.announcement_symbol }}</span>{% endif %}
      <span>{{ section.settings.announcement }}</span>
      {% if section.settings.announcement_symbol != blank %}<span aria-hidden="true">{{ section.settings.announcement_symbol }}</span>{% endif %}
    </div>
  {% endif %}

  <div class="fp-nav-wrap">
    <div class="fp-shell fp-nav">
      <a class="fp-logo" href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_alt | escape }}">
        {% if section.settings.logo_image != blank %}
          {{ section.settings.logo_image | image_url: width: 700 | image_tag: class: 'fp-logo__image', loading: 'eager', widths: '160,240,360,500,700', sizes: '(max-width: 749px) 150px, 220px', alt: section.settings.logo_alt }}
        {% else %}
          <span>{{ section.settings.logo_text }}</span>
          {% if section.settings.logo_subtext != blank %}<small>{{ section.settings.logo_subtext }}</small>{% endif %}
        {% endif %}
      </a>

      <nav class="fp-nav__links" aria-label="{{ section.settings.navigation_label | escape }}">
        {% if section.settings.main_menu != blank %}
          {% for link in section.settings.main_menu.links %}
            <a href="{{ link.url }}"{% if link.current %} class="is-active" aria-current="page"{% endif %}>{{ link.title }}</a>
          {% endfor %}
        {% else %}
          {% if section.settings.nav_1_label != blank and section.settings.nav_1_url != blank %}<a href="{{ section.settings.nav_1_url }}"{% if request.path == section.settings.nav_1_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_1_label }}</a>{% endif %}
          {% if section.settings.nav_2_label != blank and section.settings.nav_2_url != blank %}<a href="{{ section.settings.nav_2_url }}"{% if request.path == section.settings.nav_2_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_2_label }}</a>{% endif %}
          {% if section.settings.nav_3_label != blank and section.settings.nav_3_url != blank %}<a href="{{ section.settings.nav_3_url }}"{% if request.path == section.settings.nav_3_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_3_label }}</a>{% endif %}
          {% if section.settings.nav_4_label != blank and section.settings.nav_4_url != blank %}<a href="{{ section.settings.nav_4_url }}"{% if request.path == section.settings.nav_4_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_4_label }}</a>{% endif %}
          {% if section.settings.nav_5_label != blank and section.settings.nav_5_url != blank %}<a href="{{ section.settings.nav_5_url }}"{% if request.path == section.settings.nav_5_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_5_label }}</a>{% endif %}
          {% if section.settings.nav_6_label != blank and section.settings.nav_6_url != blank %}<a href="{{ section.settings.nav_6_url }}"{% if request.path == section.settings.nav_6_url %} class="is-active" aria-current="page"{% endif %}>{{ section.settings.nav_6_label }}</a>{% endif %}
        {% endif %}
      </nav>

      <div class="fp-nav__actions">
        {% if section.settings.show_search %}
          <a class="fp-search" href="{{ routes.search_url }}" aria-label="{{ section.settings.search_label | escape }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></svg>
          </a>
        {% endif %}

        {% if section.settings.show_instagram and section.settings.instagram_url != blank %}
          <a class="fp-instagram" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.instagram_label | escape }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>
          </a>
        {% endif %}

        {% if section.settings.gigi_icon != blank %}
          {% if section.settings.gigi_link != blank %}<a class="fp-gigi-link" href="{{ section.settings.gigi_link }}" aria-label="{{ section.settings.gigi_alt | escape }}">{% else %}<span class="fp-gigi-link">{% endif %}
            {{ section.settings.gigi_icon | image_url: width: 240 | image_tag: class: 'fp-nav__gigi', loading: 'eager', widths: '60,90,120,180,240', sizes: '(max-width: 900px) 48px, 64px', alt: section.settings.gigi_alt }}
          {% if section.settings.gigi_link != blank %}</a>{% else %}</span>{% endif %}
        {% elsif request.design_mode %}
          <span class="fp-gigi-editor-placeholder">Add GiGi</span>
        {% endif %}

        {% if section.settings.show_cart %}
          <a class="fp-cart" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }}, {{ cart.item_count }} items">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><b>{{ cart.item_count }}</b>
          </a>
        {% endif %}

        <details class="fp-menu">
          <summary aria-label="{{ section.settings.menu_open_label | escape }}"><i></i><i></i></summary>
          <nav class="fp-mobile-menu" aria-label="{{ section.settings.mobile_navigation_label | escape }}">
            <div class="fp-mobile-menu__links">
              {% if section.settings.main_menu != blank %}
                {% for link in section.settings.main_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
              {% else %}
                {% if section.settings.nav_1_label != blank and section.settings.nav_1_url != blank %}<a href="{{ section.settings.nav_1_url }}">{{ section.settings.nav_1_label }}</a>{% endif %}
                {% if section.settings.nav_2_label != blank and section.settings.nav_2_url != blank %}<a href="{{ section.settings.nav_2_url }}">{{ section.settings.nav_2_label }}</a>{% endif %}
                {% if section.settings.nav_3_label != blank and section.settings.nav_3_url != blank %}<a href="{{ section.settings.nav_3_url }}">{{ section.settings.nav_3_label }}</a>{% endif %}
                {% if section.settings.nav_4_label != blank and section.settings.nav_4_url != blank %}<a href="{{ section.settings.nav_4_url }}">{{ section.settings.nav_4_label }}</a>{% endif %}
                {% if section.settings.nav_5_label != blank and section.settings.nav_5_url != blank %}<a href="{{ section.settings.nav_5_url }}">{{ section.settings.nav_5_label }}</a>{% endif %}
                {% if section.settings.nav_6_label != blank and section.settings.nav_6_url != blank %}<a href="{{ section.settings.nav_6_url }}">{{ section.settings.nav_6_label }}</a>{% endif %}
              {% endif %}
              {% if section.settings.show_search %}<a href="{{ routes.search_url }}">{{ section.settings.search_label }}</a>{% endif %}
            </div>
            <div class="fp-mobile-menu__bottom">
              <p>limited-edition prints · made to order in Egypt</p>
            </div>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
<script>
  (() => {
    const root = document.getElementById('FridayHeader-{{ section.id }}');
    if (!root || root.dataset.fpMenuReady === 'true') return;
    root.dataset.fpMenuReady = 'true';
    const menu = root.querySelector('.fp-menu');
    if (!menu) return;
    const summary = menu.querySelector('summary');
    const pinMenuButton = () => {
      if (!summary || menu.open) return;
      const rect = summary.getBoundingClientRect();
      root.style.setProperty('--fp-menu-button-left', `${rect.left}px`);
      root.style.setProperty('--fp-menu-button-top', `${rect.top}px`);
      root.style.setProperty('--fp-menu-button-width', `${rect.width}px`);
      root.style.setProperty('--fp-menu-button-height', `${rect.height}px`);
    };
    summary?.addEventListener('pointerdown', pinMenuButton);
    summary?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') pinMenuButton();
    });
    window.addEventListener('resize', pinMenuButton, { passive: true });
    pinMenuButton();
    const sync = () => {
      document.documentElement.classList.toggle('fp-mobile-menu-open', menu.open);
      document.body.classList.toggle('fp-mobile-menu-open', menu.open);
      if (summary) summary.setAttribute('aria-label', menu.open ? 'Close menu' : {{ section.settings.menu_open_label | json }});
    };
    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('.fp-mobile-menu a').forEach((link) => link.addEventListener('click', () => { menu.open = false; sync(); }));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu.open) { menu.open = false; sync(); menu.querySelector('summary')?.focus(); } });
    document.addEventListener('shopify:section:unload', (event) => { if (event.target?.contains(root)) { document.documentElement.classList.remove('fp-mobile-menu-open'); document.body.classList.remove('fp-mobile-menu-open'); } });
    sync();
  })();
</script>

{% schema %}
{
  "name": "Friday header",
  "settings": [
    { "type": "header", "content": "Announcement" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement", "default": true },
    { "type": "text", "id": "announcement", "label": "Announcement text", "default": "LIMITED EDITION ART PRINTS, MADE TO ORDER IN EGYPT" },
    { "type": "text", "id": "announcement_symbol", "label": "Announcement symbol", "default": "✦" },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (optional)" },
    { "type": "range", "id": "logo_image_width", "label": "Logo image width", "min": 80, "max": 260, "step": 5, "unit": "px", "default": 170 },
    { "type": "text", "id": "logo_text", "label": "Text logo line 1", "default": "friday" },
    { "type": "text", "id": "logo_subtext", "label": "Text logo line 2", "default": "prints.art" },
    { "type": "text", "id": "logo_alt", "label": "Logo accessibility label", "default": "Friday Prints home" },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "main_menu", "label": "Shopify navigation menu", "info": "Preferred handoff control. If blank, the fallback links below are used." },
    { "type": "text", "id": "navigation_label", "label": "Desktop navigation accessibility label", "default": "Main navigation" },
    { "type": "text", "id": "mobile_navigation_label", "label": "Mobile navigation accessibility label", "default": "Mobile navigation" },
    { "type": "text", "id": "menu_open_label", "label": "Menu button accessibility label", "default": "Open menu" },
    { "type": "text", "id": "nav_1_label", "label": "Fallback link 1 label", "default": "shop all" },
    { "type": "url", "id": "nav_1_url", "label": "Fallback link 1 URL" },
    { "type": "text", "id": "nav_2_label", "label": "Fallback link 2 label", "default": "world of GiGi" },
    { "type": "url", "id": "nav_2_url", "label": "Fallback link 2 URL" },
    { "type": "text", "id": "nav_3_label", "label": "Fallback link 3 label", "default": "print guide" },
    { "type": "url", "id": "nav_3_url", "label": "Fallback link 3 URL" },
    { "type": "text", "id": "nav_4_label", "label": "Fallback link 4 label", "default": "faq" },
    { "type": "url", "id": "nav_4_url", "label": "Fallback link 4 URL" },
    { "type": "text", "id": "nav_5_label", "label": "Fallback link 5 label" },
    { "type": "url", "id": "nav_5_url", "label": "Fallback link 5 URL" },
    { "type": "text", "id": "nav_6_label", "label": "Fallback link 6 label" },
    { "type": "url", "id": "nav_6_url", "label": "Fallback link 6 URL" },

    { "type": "header", "content": "Header actions" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_label", "label": "Search accessibility label", "default": "Search prints" },
    { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram", "default": false },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "instagram_label", "label": "Instagram accessibility label", "default": "Instagram" },
    { "type": "image_picker", "id": "gigi_icon", "label": "GiGi image" },
    { "type": "url", "id": "gigi_link", "label": "GiGi link" },
    { "type": "text", "id": "gigi_alt", "label": "GiGi alt text", "default": "Meet GiGi" },
    { "type": "range", "id": "gigi_size_desktop", "label": "GiGi size — desktop", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "gigi_size_mobile", "label": "GiGi size — mobile", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 31 },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart", "default": true },
    { "type": "text", "id": "cart_label", "label": "Cart accessibility label", "default": "Cart" },

    { "type": "header", "content": "Friday Prints palette" },
    { "type": "color", "id": "color_cream", "label": "Cream", "default": "#FBF1E4" },
    { "type": "color", "id": "color_pink", "label": "Pink", "default": "#F2BDC5" },
    { "type": "color", "id": "color_newsletter", "label": "Newsletter pink", "default": "#E9A5B2" },
    { "type": "color", "id": "color_red", "label": "Coral red", "default": "#E53F36" },
    { "type": "color", "id": "color_yellow", "label": "Mustard", "default": "#F3CF78" },
    { "type": "color", "id": "color_green", "label": "Green accent", "default": "#2F8869" },
    { "type": "color", "id": "color_ink", "label": "Ink", "default": "#17120F" }
  ],
  "presets": [{ "name": "Friday header" }]
}
{% endschema %}
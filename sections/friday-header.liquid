{{ 'friday-home-v3.css' | asset_url | stylesheet_tag }}
<header class="fr-site-header" id="FridayHeader-{{ section.id }}">
  <div class="fr-announcement">✦ {{ section.settings.announcement }} ✦</div>
  <div class="fr-shell fr-nav">
    <a class="fr-logo" href="{{ routes.root_url }}" aria-label="Friday Prints home"><span>friday</span><small>prints.art</small></a>
    <nav class="fr-nav__links" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">shop prints</a>
      <a href="{{ routes.collections_url }}">collections</a>
      <a href="/pages/about">about</a>
      <a href="/pages/info">info</a>
      <a href="/pages/faq">faq</a>
      <a href="/pages/contact">contact</a>
    </nav>
    <div class="fr-nav__actions">
      <a href="/pages/about" aria-label="Meet GiGi"><img class="fr-nav__gigi" src="{{ 'friday-gigi-nav.png' | asset_url }}" width="34" height="42" alt="" loading="eager"></a>
      <a class="fr-cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><b>{{ cart.item_count }}</b></a>
      <details class="fr-menu"><summary aria-label="Open menu"><i></i><i></i></summary><nav class="fr-mobile-menu"><a href="{{ routes.all_products_collection_url }}">shop prints</a><a href="{{ routes.collections_url }}">collections</a><a href="/pages/about">about</a><a href="/pages/info">info</a><a href="/pages/faq">faq</a><a href="/pages/contact">contact</a></nav></details>
    </div>
  </div>
</header>
{% schema %}
{"name":"Friday header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"LIMITED EDITION ART PRINTS, MADE TO ORDER IN EGYPT"}],"presets":[{"name":"Friday header"}]}
{% endschema %}
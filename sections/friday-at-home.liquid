<section
  class="fp-section fp-at-home"
  id="FridayAtHome-{{ section.id }}"
  style="--fp-at-home-bg:{{ section.settings.background_color }};--fp-at-home-heading-desktop:{{ section.settings.heading_size_desktop }}px;--fp-at-home-heading-mobile:{{ section.settings.heading_size_mobile }}px;--fp-at-home-height:{{ section.settings.section_height_desktop }}px;"
>
  <style>
    #FridayAtHome-{{ section.id }}{
      background:var(--fp-at-home-bg);
      color:var(--fp-ink);
      overflow:hidden;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__inner{
      width:100%;
      display:grid;
      grid-template-columns:minmax(250px,26%) minmax(0,74%);
      min-height:var(--fp-at-home-height);
      max-height:var(--fp-at-home-height);
      padding:0;
      margin:0;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__intro{
      min-width:0;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:flex-start;
      padding:42px clamp(28px,3.4vw,58px);
      border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__title{
      margin:0;
      max-width:9ch;
      font:700 var(--fp-at-home-heading-desktop)/.9 "Courier New",Courier,monospace;
      letter-spacing:-.065em;
      text-transform:uppercase;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__text{
      max-width:220px;
      margin:20px 0 0;
      font:400 13px/1.45 "Courier New",Courier,monospace;
      letter-spacing:-.01em;
      text-transform:none;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__cta{
      display:inline-flex;
      align-items:center;
      gap:12px;
      margin-top:auto;
      padding-top:24px;
      color:inherit;
      text-decoration:none;
      border-bottom:1px solid currentColor;
      font:700 11px/1.6 "Courier New",Courier,monospace;
      text-transform:uppercase;
      letter-spacing:.035em;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__gallery{
      min-width:0;
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      height:var(--fp-at-home-height);
      overflow:hidden;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene{
      position:relative;
      min-width:0;
      height:100%;
      overflow:hidden;
      background:color-mix(in srgb,var(--fp-cream) 82%,#fff);
      border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene:last-child{border-right:0}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a,
    #FridayAtHome-{{ section.id }} .fp-at-home__media{
      display:block;
      width:100%;
      height:100%;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene img,
    #FridayAtHome-{{ section.id }} .fp-at-home__scene svg{
      display:block;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center;
      transition:transform .45s cubic-bezier(.2,.7,.2,1);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:hover img{transform:scale(1.02)}
    #FridayAtHome-{{ section.id }} .fp-at-home__placeholder{
      background:color-mix(in srgb,var(--fp-cream) 82%,#fff);
      fill:color-mix(in srgb,var(--fp-ink) 14%,transparent);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__hint{
      position:absolute;
      left:12px;
      bottom:10px;
      margin:0;
      padding:5px 7px;
      background:var(--fp-cream);
      font:700 8px/1 "Courier New",Courier,monospace;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    @media(max-width:1100px) and (min-width:750px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{
        grid-template-columns:minmax(215px,29%) minmax(0,71%);
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__intro{padding:34px 28px}
      #FridayAtHome-{{ section.id }} .fp-at-home__title{font-size:clamp(28px,3.4vw,var(--fp-at-home-heading-desktop))}
      #FridayAtHome-{{ section.id }} .fp-at-home__text{margin-top:16px;font-size:11px}
    }

    @media(max-width:749px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{
        display:block;
        min-height:0;
        max-height:none;
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__intro{
        min-height:142px;
        padding:25px 20px 22px;
        border-right:0;
        border-bottom:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__title{
        max-width:none;
        font-size:var(--fp-at-home-heading-mobile);
        letter-spacing:-.055em;
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__text{
        max-width:none;
        margin-top:9px;
        font-size:10px;
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__cta{
        margin-top:16px;
        padding-top:0;
        font-size:9px;
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery{
        display:flex;
        gap:0;
        height:232px;
        overflow-x:auto;
        overflow-y:hidden;
        scroll-snap-type:x mandatory;
        scrollbar-width:none;
        -webkit-overflow-scrolling:touch;
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery::-webkit-scrollbar{display:none}
      #FridayAtHome-{{ section.id }} .fp-at-home__scene{
        flex:0 0 78vw;
        height:232px;
        scroll-snap-align:start;
        border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
      }
      #FridayAtHome-{{ section.id }} .fp-at-home__scene:last-child{border-right:0}
    }

    @media(prefers-reduced-motion:reduce){
      #FridayAtHome-{{ section.id }} .fp-at-home__scene img{transition:none}
    }
  </style>

  <div class="fp-at-home__inner">
    <div class="fp-at-home__intro">
      {% if section.settings.heading != blank %}<h2 class="fp-at-home__title">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="fp-at-home__text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="fp-at-home__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>

    <div class="fp-at-home__gallery">
      {% for block in section.blocks %}
        {% assign fp_scene_image = block.settings.image %}
        {% if fp_scene_image == blank and block.settings.product != blank %}
          {% assign fp_scene_image = block.settings.product.featured_image %}
        {% endif %}
        {% assign fp_scene_link = block.settings.link %}
        {% if block.settings.product != blank %}{% assign fp_scene_link = block.settings.product.url %}{% endif %}
        {% assign fp_scene_alt = block.settings.alt | default: block.settings.product.title | default: 'Friday Prints at home' %}

        <article class="fp-at-home__scene" {{ block.shopify_attributes }}>
          {% if fp_scene_link != blank %}<a href="{{ fp_scene_link }}" aria-label="{{ fp_scene_alt | escape }}">{% endif %}
            <div class="fp-at-home__media">
              {% if fp_scene_image != blank %}
                {{ fp_scene_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200,1600', sizes: '(max-width: 749px) 78vw, 25vw', alt: fp_scene_alt }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'fp-at-home__placeholder' }}
                {% if request.design_mode %}<p class="fp-at-home__hint">Add room image</p>{% endif %}
              {% endif %}
            </div>
          {% if fp_scene_link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friday at home",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "friday at home" },
    { "type": "text", "id": "text", "label": "Supporting line", "default": "Printed to live with you." },
    { "type": "text", "id": "cta_label", "label": "Optional link label", "default": "" },
    { "type": "url", "id": "cta_link", "label": "Optional link" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3CF78" },
    { "type": "range", "id": "section_height_desktop", "label": "Section height — desktop", "min": 280, "max": 420, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 30, "max": 52, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 26, "max": 40, "step": 1, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Home image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Lifestyle / room image" },
        { "type": "product", "id": "product", "label": "Featured print (optional link + image fallback)" },
        { "type": "url", "id": "link", "label": "Custom link (used if no product is selected)" },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Friday Prints at home" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday at home",
      "blocks": [
        { "type": "scene" },
        { "type": "scene" },
        { "type": "scene" }
      ]
    }
  ]
}
{% endschema %}
<section
  class="fp-section fp-at-home"
  id="FridayAtHome-{{ section.id }}"
  style="--fp-at-home-bg:{{ section.settings.background_color }};--fp-at-home-heading-desktop:{{ section.settings.heading_size_desktop }}px;--fp-at-home-heading-mobile:{{ section.settings.heading_size_mobile }}px;--fp-at-home-height:{{ section.settings.section_height_desktop }}px;"
>
  <style>
    #FridayAtHome-{{ section.id }}{
      background:var(--fp-at-home-bg);
      color:var(--fp-ink);
      overflow:hidden;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__inner{
      width:100%;
      display:grid;
      grid-template-columns:minmax(250px,24%) minmax(0,76%);
      min-height:var(--fp-at-home-height);
      max-height:var(--fp-at-home-height);
      padding:0;
      margin:0;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__intro{
      min-width:0;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:flex-start;
      padding:38px clamp(28px,3.4vw,54px);
      border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__title{
      margin:0;
      max-width:8ch;
      font-family:var(--fp-display-font,Georgia,"Times New Roman",serif);
      font-style:normal;
      font-weight:700;
      font-size:min(var(--fp-at-home-heading-desktop),var(--fp-section-title,56px));
      line-height:.92;
      letter-spacing:-.045em;
      text-transform:none;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__text{
      max-width:220px;
      margin:17px 0 0;
      font:400 12.5px/1.5 var(--fp-ui-font,"Courier New",Courier,monospace);
      letter-spacing:-.01em;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__cta{
      display:inline-flex;
      align-items:center;
      gap:10px;
      margin-top:auto;
      padding-top:22px;
      color:inherit;
      text-decoration:none;
      border-bottom:1px solid currentColor;
      font:700 10px/1.6 var(--fp-ui-font,"Courier New",Courier,monospace);
      letter-spacing:.035em;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__gallery{
      min-width:0;
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      height:var(--fp-at-home-height);
      overflow:hidden;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene{
      position:relative;
      min-width:0;
      height:100%;
      overflow:hidden;
      background:color-mix(in srgb,var(--fp-cream) 82%,#fff);
      border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent);
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene:last-child{border-right:0}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a,
    #FridayAtHome-{{ section.id }} .fp-at-home__media{
      display:block;
      width:100%;
      height:100%;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a{position:relative;color:inherit;text-decoration:none}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene img,
    #FridayAtHome-{{ section.id }} .fp-at-home__scene svg{
      display:block;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center;
      transition:transform .45s cubic-bezier(.2,.7,.2,1),filter .3s ease;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:hover img,
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:focus-visible img{transform:scale(1.018);filter:saturate(1.03)}
    #FridayAtHome-{{ section.id }} .fp-at-home__shop-label{
      position:absolute;
      left:12px;
      bottom:12px;
      z-index:2;
      display:inline-flex;
      align-items:center;
      min-height:34px;
      padding:0 10px;
      background:color-mix(in srgb,var(--fp-cream) 94%,transparent);
      border:1px solid color-mix(in srgb,var(--fp-ink) 72%,transparent);
      color:var(--fp-ink);
      font:700 8px/1 var(--fp-ui-font,"Courier New",Courier,monospace);
      letter-spacing:.045em;
      opacity:0;
      transform:translateY(5px);
      transition:opacity .2s ease,transform .2s ease;
    }
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:hover .fp-at-home__shop-label,
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:focus-visible .fp-at-home__shop-label{opacity:1;transform:none}
    #FridayAtHome-{{ section.id }} .fp-at-home__placeholder{background:color-mix(in srgb,var(--fp-cream) 82%,#fff);fill:color-mix(in srgb,var(--fp-ink) 14%,transparent)}
    #FridayAtHome-{{ section.id }} .fp-at-home__hint{position:absolute;left:12px;bottom:10px;margin:0;padding:5px 7px;background:var(--fp-cream);font:700 8px/1 var(--fp-ui-font,"Courier New",Courier,monospace);text-transform:uppercase;letter-spacing:.04em}

    @media(max-width:1100px) and (min-width:750px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{grid-template-columns:minmax(215px,27%) minmax(0,73%)}
      #FridayAtHome-{{ section.id }} .fp-at-home__intro{padding:32px 28px}
      #FridayAtHome-{{ section.id }} .fp-at-home__title{font-size:min(var(--fp-at-home-heading-desktop),48px)}
      #FridayAtHome-{{ section.id }} .fp-at-home__text{margin-top:14px;font-size:11px}
    }

    @media(max-width:749px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{display:block;min-height:0;max-height:none}
      #FridayAtHome-{{ section.id }} .fp-at-home__intro{min-height:150px;padding:28px 20px 24px;border-right:0;border-bottom:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent)}
      #FridayAtHome-{{ section.id }} .fp-at-home__title{max-width:none;font-size:min(var(--fp-at-home-heading-mobile),var(--fp-section-title,38px));letter-spacing:-.045em}
      #FridayAtHome-{{ section.id }} .fp-at-home__text{max-width:none;margin-top:9px;font-size:10.5px}
      #FridayAtHome-{{ section.id }} .fp-at-home__cta{margin-top:16px;padding-top:0;font-size:9px}
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery{display:flex;gap:0;height:238px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery::-webkit-scrollbar{display:none}
      #FridayAtHome-{{ section.id }} .fp-at-home__scene{flex:0 0 78vw;height:238px;scroll-snap-align:start;border-right:1px solid color-mix(in srgb,var(--fp-ink) 12%,transparent)}
      #FridayAtHome-{{ section.id }} .fp-at-home__scene:last-child{border-right:0}
      #FridayAtHome-{{ section.id }} .fp-at-home__shop-label{left:10px;bottom:10px;min-height:32px;font-size:7.5px;opacity:1;transform:none}
    }

    @media(prefers-reduced-motion:reduce){
      #FridayAtHome-{{ section.id }} .fp-at-home__scene img,
      #FridayAtHome-{{ section.id }} .fp-at-home__shop-label{transition:none}
    }
  </style>

  <div class="fp-at-home__inner">
    <div class="fp-at-home__intro">
      {% if section.settings.heading != blank %}<h2 class="fp-at-home__title">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="fp-at-home__text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="fp-at-home__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>

    <div class="fp-at-home__gallery">
      {% for block in section.blocks %}
        {% assign fp_scene_image = block.settings.image %}
        {% if fp_scene_image == blank and block.settings.product != blank %}
          {% assign fp_scene_image = block.settings.product.featured_image %}
        {% endif %}
        {% assign fp_scene_link = block.settings.link %}
        {% if block.settings.product != blank %}
          {% assign fp_scene_link = block.settings.product.url %}
        {% endif %}
        {% if fp_scene_link == blank %}
          {% assign fp_scene_link = collections['all'].url %}
        {% endif %}
        {% assign fp_scene_alt = block.settings.alt | default: block.settings.product.title | default: 'Friday Prints at home' %}

        <article class="fp-at-home__scene" {{ block.shopify_attributes }}>
          <a href="{{ fp_scene_link }}" aria-label="{{ fp_scene_alt | escape }} — view print">
            <div class="fp-at-home__media">
              {% if fp_scene_image != blank %}
                {{ fp_scene_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200,1600', sizes: '(max-width: 749px) 78vw, 25vw', alt: fp_scene_alt }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'fp-at-home__placeholder' }}
                {% if request.design_mode %}<p class="fp-at-home__hint">Add room image</p>{% endif %}
              {% endif %}
            </div>
            <span class="fp-at-home__shop-label">view print&nbsp;↗</span>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friday at home",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "friday at home" },
    { "type": "text", "id": "text", "label": "Supporting line", "default": "Printed to live with you." },
    { "type": "text", "id": "cta_label", "label": "Optional link label", "default": "shop the prints" },
    { "type": "url", "id": "cta_link", "label": "Optional link" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3CF78" },
    { "type": "range", "id": "section_height_desktop", "label": "Section height — desktop", "min": 280, "max": 420, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 38, "max": 60, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 32, "max": 46, "step": 1, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Home image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Lifestyle / room image" },
        { "type": "product", "id": "product", "label": "Featured print (recommended for direct linking)" },
        { "type": "url", "id": "link", "label": "Custom link (used if no product is selected)" },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Friday Prints at home" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday at home",
      "blocks": [{"type":"scene"},{"type":"scene"},{"type":"scene"}]
    }
  ]
}
{% endschema %}
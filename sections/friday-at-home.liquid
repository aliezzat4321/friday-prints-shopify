<section
  class="fp-section fp-at-home"
  id="FridayAtHome-{{ section.id }}"
  style="--fp-at-home-bg:{{ section.settings.background_color }};--fp-at-home-heading-desktop:{{ section.settings.heading_size_desktop }}px;--fp-at-home-heading-mobile:{{ section.settings.heading_size_mobile }}px;"
>
  <style>
    #FridayAtHome-{{ section.id }}{background:var(--fp-at-home-bg);color:var(--fp-ink)}
    #FridayAtHome-{{ section.id }} .fp-at-home__inner{display:grid;grid-template-columns:minmax(220px,.56fr) minmax(0,1.74fr);gap:40px;padding:58px 42px 62px}
    #FridayAtHome-{{ section.id }} .fp-at-home__intro{align-self:start;padding-top:4px}
    #FridayAtHome-{{ section.id }} .fp-at-home__title{margin:0;font:700 var(--fp-at-home-heading-desktop)/.9 Georgia,"Times New Roman",serif;letter-spacing:-.045em;text-transform:lowercase}
    #FridayAtHome-{{ section.id }} .fp-at-home__text{max-width:230px;margin:18px 0 0;font:700 11px/1.45 "Courier New",Courier,monospace;letter-spacing:.02em;text-transform:uppercase}
    #FridayAtHome-{{ section.id }} .fp-at-home__gallery{display:grid;grid-template-columns:minmax(0,1.28fr) minmax(190px,.72fr);grid-template-rows:1fr 1fr;gap:14px;min-height:560px}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene{position:relative;min-width:0;overflow:hidden;background:color-mix(in srgb,var(--fp-cream) 78%,#fff);border:1px solid color-mix(in srgb,var(--fp-ink) 18%,transparent)}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene:first-child{grid-row:1 / span 2}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a,
    #FridayAtHome-{{ section.id }} .fp-at-home__media{display:block;width:100%;height:100%}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene img,
    #FridayAtHome-{{ section.id }} .fp-at-home__scene svg{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
    #FridayAtHome-{{ section.id }} .fp-at-home__scene>a:hover img{transform:scale(1.018)}
    #FridayAtHome-{{ section.id }} .fp-at-home__placeholder{background:color-mix(in srgb,var(--fp-cream) 82%,#fff);fill:color-mix(in srgb,var(--fp-ink) 16%,transparent)}
    #FridayAtHome-{{ section.id }} .fp-at-home__hint{position:absolute;left:12px;bottom:10px;margin:0;padding:5px 7px;background:var(--fp-cream);font:700 8px/1 "Courier New",Courier,monospace;text-transform:uppercase;letter-spacing:.04em}
    @media(max-width:1100px) and (min-width:750px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{grid-template-columns:minmax(180px,.48fr) minmax(0,1.52fr);gap:28px;padding:48px 30px 52px}
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery{min-height:470px}
    }
    @media(max-width:749px){
      #FridayAtHome-{{ section.id }} .fp-at-home__inner{display:block;padding:40px 20px 42px}
      #FridayAtHome-{{ section.id }} .fp-at-home__intro{padding:0 0 26px}
      #FridayAtHome-{{ section.id }} .fp-at-home__title{font-size:var(--fp-at-home-heading-mobile)}
      #FridayAtHome-{{ section.id }} .fp-at-home__text{max-width:none;margin-top:12px;font-size:9px}
      #FridayAtHome-{{ section.id }} .fp-at-home__gallery{grid-template-columns:1fr 1fr;grid-template-rows:auto auto;gap:10px;min-height:0}
      #FridayAtHome-{{ section.id }} .fp-at-home__scene{aspect-ratio:1 / 1}
      #FridayAtHome-{{ section.id }} .fp-at-home__scene:first-child{grid-column:1 / -1;grid-row:auto;aspect-ratio:1.28 / 1}
      #FridayAtHome-{{ section.id }} .fp-at-home__hint{left:8px;bottom:8px}
    }
    @media(prefers-reduced-motion:reduce){#FridayAtHome-{{ section.id }} .fp-at-home__scene img{transition:none}}
  </style>

  <div class="fp-shell fp-at-home__inner">
    <div class="fp-at-home__intro">
      {% if section.settings.heading != blank %}<h2 class="fp-at-home__title">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="fp-at-home__text">{{ section.settings.text }}</div>{% endif %}
    </div>

    <div class="fp-at-home__gallery">
      {% for block in section.blocks %}
        {% assign fp_scene_image = block.settings.image %}
        {% if fp_scene_image == blank and block.settings.product != blank %}
          {% assign fp_scene_image = block.settings.product.featured_image %}
        {% endif %}
        {% assign fp_scene_link = block.settings.link %}
        {% if block.settings.product != blank %}{% assign fp_scene_link = block.settings.product.url %}{% endif %}
        {% assign fp_scene_alt = block.settings.alt | default: block.settings.product.title | default: 'Friday Prints at home' %}

        <article class="fp-at-home__scene" {{ block.shopify_attributes }}>
          {% if fp_scene_link != blank %}<a href="{{ fp_scene_link }}" aria-label="{{ fp_scene_alt | escape }}">{% endif %}
            <div class="fp-at-home__media">
              {% if fp_scene_image != blank %}
                {{ fp_scene_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200,1500,1800', sizes: '(max-width: 749px) 100vw, (max-width: 1100px) 60vw, 68vw', alt: fp_scene_alt }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'fp-at-home__placeholder' }}
                {% if request.design_mode %}<p class="fp-at-home__hint">Add a room / lifestyle image</p>{% endif %}
              {% endif %}
            </div>
          {% if fp_scene_link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Friday at home",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "friday at home" },
    { "type": "text", "id": "text", "label": "Supporting line", "default": "Printed to live with you." },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3CF78" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 48, "max": 78, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 38, "max": 58, "step": 1, "unit": "px", "default": 46 }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Home image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Lifestyle / room image" },
        { "type": "product", "id": "product", "label": "Featured print (optional link + image fallback)" },
        { "type": "url", "id": "link", "label": "Custom link (used if no product is selected)" },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Friday Prints at home" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Friday at home",
      "blocks": [
        { "type": "scene" },
        { "type": "scene" },
        { "type": "scene" }
      ]
    }
  ]
}
{% endschema %}
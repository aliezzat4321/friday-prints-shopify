{% liquid
  assign fp_newsletter_heading = section.settings.heading
  if fp_newsletter_heading == 'Postcards from GiGi' or fp_newsletter_heading == 'Postcards from Gigi' or fp_newsletter_heading == 'postcards from Gigi' or fp_newsletter_heading == 'Postcards from GIGI' or fp_newsletter_heading == 'postcards from GIGI'
    assign fp_newsletter_heading = 'postcards from GiGi'
  endif
%}
<section class="fp-section fp-newsletter" id="FridayNewsletter-{{ section.id }}" style="--fp-newsletter-gigi-desktop:{{ section.settings.gigi_size_desktop }}px;--fp-newsletter-gigi-mobile:{{ section.settings.gigi_size_mobile }}px;--fp-newsletter-bg:{{ section.settings.background_color }};--fp-newsletter-heading-desktop:{{ section.settings.heading_size_desktop }}px;--fp-newsletter-heading-mobile:{{ section.settings.heading_size_mobile }}px;--fp-newsletter-body-desktop:{{ section.settings.body_size_desktop }}px;--fp-newsletter-body-mobile:{{ section.settings.body_size_mobile }}px;">
  <style>
    #FridayNewsletter-{{ section.id }} .fp-newsletter h2{
      margin:0 0 11px;
      font-family:var(--fp-display-font,Georgia,"Times New Roman",serif)!important;
      font-style:normal!important;
      font-weight:700!important;
      font-size:min(var(--fp-newsletter-heading-desktop),var(--fp-section-title,56px))!important;
      line-height:.9!important;
      letter-spacing:-.045em!important;
      text-transform:none!important;
      text-align:left;
    }
    #FridayNewsletter-{{ section.id }} .fp-newsletter__copy>p:last-child{font-size:var(--fp-newsletter-body-desktop);line-height:1.48}
    @media(max-width:749px){
      #FridayNewsletter-{{ section.id }} .fp-newsletter__grid{grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:30px 20px 32px}
      #FridayNewsletter-{{ section.id }} .fp-newsletter h2{font-size:min(var(--fp-newsletter-heading-mobile),var(--fp-section-title,38px))!important;line-height:.92!important;margin-bottom:10px}
      #FridayNewsletter-{{ section.id }} .fp-newsletter__copy>p:last-child{font-size:var(--fp-newsletter-body-mobile);line-height:1.48}
      #FridayNewsletter-{{ section.id }} .fp-newsletter__form{display:grid;grid-template-columns:1fr;gap:8px;min-height:0}
      #FridayNewsletter-{{ section.id }} .fp-newsletter__form input{width:100%;min-width:0;height:52px;border:1px solid var(--fp-ink);padding:0 14px;font-size:12px}
      #FridayNewsletter-{{ section.id }} .fp-newsletter__form button{width:100%;min-height:52px;padding:0 16px;font-size:11px;white-space:normal;text-align:center}
      #FridayNewsletter-{{ section.id }} .fp-newsletter__feedback{margin-top:2px}
    }
  </style>
  <div class="fp-shell fp-newsletter__grid">
    <div class="fp-newsletter__copy">
      {% if section.settings.eyebrow != blank %}<p class="fp-newsletter__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if fp_newsletter_heading != blank %}<h2>{{ fp_newsletter_heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>

    <div class="fp-newsletter__form-wrap">
      {% form 'customer', class: 'fp-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder | escape }}" aria-label="{{ section.settings.email_label | escape }}" required>
        <button type="submit">{{ section.settings.button_label }}</button>
        {% if form.posted_successfully? %}<p class="fp-newsletter__feedback">{{ section.settings.success_message }}</p>{% elsif form.errors %}<div class="fp-newsletter__feedback">{{ form.errors | default_errors }}</div>{% endif %}
      {% endform %}
    </div>

    {% if section.settings.gigi_icon != blank %}
      <div class="fp-newsletter__gigi-wrap">
        {{ section.settings.gigi_icon | image_url: width: 420 | image_tag: class: 'fp-newsletter__gigi', loading: 'lazy', widths: '100,160,240,320,420', sizes: '(max-width: 749px) 90px, 130px', alt: section.settings.gigi_alt }}
      </div>
    {% elsif request.design_mode %}
      <div class="fp-newsletter__gigi-wrap"><span class="fp-gigi-editor-placeholder">Add GiGi</span></div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Friday newsletter",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#E9A5B2" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 42, "max": 60, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 32, "max": 46, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "body_size_desktop", "label": "Body size — desktop", "min": 13, "max": 17, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "body_size_mobile", "label": "Body size — mobile", "min": 11, "max": 15, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FROM CAIRO, OCCASIONALLY." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "postcards from GiGi" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A small email newsletter with new prints, new drops & studio notes." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "your email" },
    { "type": "text", "id": "email_label", "label": "Email accessibility label", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "join the newsletter →" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You’re on the list. See you Friday." },
    { "type": "header", "content": "GiGi artwork" },
    { "type": "image_picker", "id": "gigi_icon", "label": "GiGi image" },
    { "type": "text", "id": "gigi_alt", "label": "GiGi alt text", "default": "GiGi" },
    { "type": "range", "id": "gigi_size_desktop", "label": "GiGi size — desktop", "min": 50, "max": 130, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "gigi_size_mobile", "label": "GiGi size — mobile", "min": 40, "max": 90, "step": 5, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "Friday newsletter" }]
}
{% endschema %}
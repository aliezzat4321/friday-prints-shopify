<section class="fp-section fp-newsletter" id="FridayNewsletter-{{ section.id }}">
  <div class="fp-shell fp-newsletter__grid">
    <div class="fp-newsletter__copy">
      <p class="fp-newsletter__eyebrow">FROM CAIRO, OCCASIONALLY.</p>
      <h2>Postcards from GiGi</h2>
      <p>A small email newsletter with new prints, new drops &amp; studio notes.</p>
    </div>
    {% form 'customer', class: 'fp-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="your email" aria-label="Email address" required>
      <button type="submit">join the newsletter →</button>
    {% endform %}
    <div class="fp-newsletter__gigi-wrap">
      {% if section.settings.gigi_icon != blank %}
        {{ section.settings.gigi_icon | image_url: width: 320 | image_tag: class: 'fp-newsletter__gigi', loading: 'lazy', widths: '100,160,240,320', sizes: '90px', alt: 'GiGi' }}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}{"name":"Friday newsletter","settings":[{"type":"image_picker","id":"gigi_icon","label":"GiGi icon","info":"Select the GiGi artwork used beside the newsletter signup."}],"presets":[{"name":"Friday newsletter"}]}{% endschema %}
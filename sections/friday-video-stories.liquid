{% liquid
  assign visible_story_count = 0
  for block in section.blocks
    assign fp_block_is_visible = false
    if block.settings.video != blank
      assign fp_block_is_visible = true
    elsif forloop.first and section.settings.use_sample_video
      assign fp_block_is_visible = true
    elsif request.design_mode
      assign fp_block_is_visible = true
    endif
    if fp_block_is_visible
      assign visible_story_count = visible_story_count | plus: 1
    endif
  endfor
  if section.blocks.size < 1 and section.settings.use_sample_video
    assign visible_story_count = 1
  endif
%}

{% if section.settings.show_section and visible_story_count > 0 %}
  <section
    class="fp-films"
    id="FridayFilms-{{ section.id }}"
    style="--fp-films-bg:{{ section.settings.background_color }};--fp-films-accent:{{ section.settings.accent_color }};--fp-films-count:{{ visible_story_count }};"
    data-fp-films
  >
    <style>
      #FridayFilms-{{ section.id }}{position:relative;overflow:hidden;background:var(--fp-cream);color:var(--fp-ink);padding:clamp(42px,5.5vw,76px) clamp(22px,4vw,54px);border-block:1px solid var(--fp-ink)}
      #FridayFilms-{{ section.id }} *{box-sizing:border-box}
      #FridayFilms-{{ section.id }} .fp-films__inner{width:min(100%,1180px);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,270px);gap:clamp(44px,7vw,92px);align-items:center;padding:clamp(38px,4vw,58px);background:var(--fp-films-bg);border:1px solid var(--fp-ink);box-shadow:12px 12px 0 var(--fp-ink)}
      #FridayFilms-{{ section.id }} .fp-films__intro{position:relative;z-index:1;max-width:590px}
      #FridayFilms-{{ section.id }} .fp-films__eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 17px;color:var(--fp-films-accent);font:700 9px/1 "Courier New",monospace;letter-spacing:.11em;text-transform:uppercase}
      #FridayFilms-{{ section.id }} .fp-films__eyebrow:before{content:'';width:27px;height:1px;background:currentColor}
      #FridayFilms-{{ section.id }} h2{max-width:7.2ch;margin:0;color:var(--fp-ink);font:700 clamp(52px,5.5vw,76px)/.84 Georgia,"Times New Roman",serif;letter-spacing:-.06em;text-transform:lowercase;text-wrap:balance}
      #FridayFilms-{{ section.id }} .fp-films__text{max-width:40ch;margin:21px 0 0;color:var(--fp-ink);font:12px/1.62 "Courier New",monospace}
      #FridayFilms-{{ section.id }} .fp-films__note{display:flex;align-items:center;gap:10px;max-width:470px;margin:21px 0 0;color:var(--fp-ink);font:700 8px/1.35 "Courier New",monospace;letter-spacing:.065em;text-transform:uppercase}
      #FridayFilms-{{ section.id }} .fp-films__note:before{content:'↘';color:var(--fp-films-accent);font-size:17px}
      #FridayFilms-{{ section.id }} .fp-films__facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:25px;border-block:1px solid var(--fp-ink)}
      #FridayFilms-{{ section.id }} .fp-films__fact{padding:13px 12px 14px;border-right:1px solid var(--fp-ink);font:700 7.5px/1.32 "Courier New",monospace;text-transform:uppercase;letter-spacing:.035em}
      #FridayFilms-{{ section.id }} .fp-films__fact:first-child{padding-left:0}
      #FridayFilms-{{ section.id }} .fp-films__fact:last-child{padding-right:0;border-right:0}
      #FridayFilms-{{ section.id }} .fp-films__fact b{display:block;margin-bottom:6px;color:var(--fp-films-accent);font-size:9px}
      #FridayFilms-{{ section.id }} .fp-films__rail{min-width:0;width:100%;justify-self:end;display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 0 4px}
      #FridayFilms-{{ section.id }} .fp-films__rail::-webkit-scrollbar{display:none}
      #FridayFilms-{{ section.id }} .fp-films__rail[data-count="1"]{display:block;overflow:visible}
      #FridayFilms-{{ section.id }} .fp-film-card{flex:0 0 88%;min-width:0;margin:0;scroll-snap-align:start}
      #FridayFilms-{{ section.id }} .fp-film-card__media{position:relative;aspect-ratio:9/16;overflow:hidden;background:#090807;border:1px solid var(--fp-ink)}
      #FridayFilms-{{ section.id }} .fp-film-card__media video{display:block;width:100%;height:100%;object-fit:cover;object-position:center;background:#090807;filter:saturate(.92) contrast(1.02);transition:transform .7s cubic-bezier(.22,.61,.36,1),filter .35s ease}
      #FridayFilms-{{ section.id }} .fp-film-card:hover .fp-film-card__media video{transform:scale(1.025);filter:saturate(1) contrast(1.04)}
      #FridayFilms-{{ section.id }} .fp-film-card__index{position:absolute;left:14px;top:13px;z-index:3;padding:7px 9px;background:var(--fp-films-accent);color:var(--fp-ink);font:700 8px/1 "Courier New",monospace;letter-spacing:.075em;text-transform:uppercase}
      #FridayFilms-{{ section.id }} .fp-film-card__index:before{content:'FILM / '}
      #FridayFilms-{{ section.id }} .fp-film-card__open{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-end;width:100%;padding:12px;border:0;background:linear-gradient(180deg,transparent 58%,rgba(9,8,7,.58));color:var(--fp-cream);cursor:pointer;text-align:right}
      #FridayFilms-{{ section.id }} .fp-film-card__open span{display:inline-flex;align-items:center;gap:12px;padding:11px 13px;border:1px solid color-mix(in srgb,var(--fp-cream) 72%,transparent);background:rgba(9,8,7,.34);font:700 8px/1 "Courier New",monospace;letter-spacing:.07em;text-transform:uppercase;backdrop-filter:blur(8px)}
      #FridayFilms-{{ section.id }} .fp-film-card__open span:before{content:'▶';font-size:7px}
      #FridayFilms-{{ section.id }} .fp-film-card__open:focus-visible{outline:2px solid var(--fp-films-accent);outline-offset:-5px}
      #FridayFilms-{{ section.id }} .fp-film-card__caption{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;margin-top:10px;font-family:"Courier New",monospace}
      #FridayFilms-{{ section.id }} .fp-film-card__caption span{max-width:32ch;color:var(--fp-ink);font-size:7px;line-height:1.45}
      #FridayFilms-{{ section.id }} .fp-film-card__caption strong{color:var(--fp-ink);font-size:8px;line-height:1.3;letter-spacing:.05em;text-transform:uppercase}
      #FridayFilms-{{ section.id }} .fp-film-card__caption small{color:var(--fp-films-accent);font:700 8px/1 "Courier New",monospace;letter-spacing:.05em}
      #FridayFilms-{{ section.id }} .fp-film-card__placeholder{height:100%;display:grid;place-items:center;padding:30px;color:var(--fp-cream);text-align:center;font:700 10px/1.4 "Courier New",monospace;text-transform:uppercase}

      #FridayFilms-{{ section.id }} .fp-film-dialog{width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:var(--fp-cream);color:var(--fp-ink)}
      #FridayFilms-{{ section.id }} .fp-film-dialog::backdrop{background:rgba(8,7,6,.88)}
      #FridayFilms-{{ section.id }} .fp-film-dialog__inner{position:relative;width:100%;height:100%;display:grid;grid-template-rows:1fr auto;place-items:center;padding:28px 70px 24px}
      #FridayFilms-{{ section.id }} .fp-film-dialog__stage{min-height:0;width:100%;height:100%;display:grid;place-items:center}
      #FridayFilms-{{ section.id }} .fp-film-dialog video{display:block;width:auto;height:auto;max-width:min(88vw,520px);max-height:calc(100dvh - 94px);aspect-ratio:9/16;object-fit:contain;background:#050505}
      #FridayFilms-{{ section.id }} .fp-film-dialog__close{position:absolute;right:20px;top:20px;z-index:2;width:44px;height:44px;border:1px solid var(--fp-ink);background:var(--fp-cream);color:var(--fp-ink);cursor:pointer;font:18px/1 "Courier New",monospace}
      #FridayFilms-{{ section.id }} .fp-film-dialog__meta{width:min(88vw,520px);display:flex;justify-content:space-between;gap:20px;padding-top:10px;border-top:1px solid var(--fp-ink);font:700 8px/1.3 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
      #FridayFilms-{{ section.id }} .fp-film-dialog__meta span:last-child{color:var(--fp-films-accent)}

      @media(max-width:1050px){
        #FridayFilms-{{ section.id }} .fp-films__inner{grid-template-columns:minmax(0,1fr) minmax(220px,250px);gap:42px;padding:40px}
        #FridayFilms-{{ section.id }} h2{font-size:clamp(50px,6.3vw,68px)}
      }
      @media(max-width:899px){
        #FridayFilms-{{ section.id }} .fp-films__inner{grid-template-columns:minmax(0,1fr) minmax(210px,230px);gap:32px;padding:36px}
      }
      @media(max-width:749px){
        #FridayFilms-{{ section.id }}{padding:28px 16px 34px}
        #FridayFilms-{{ section.id }} .fp-films__inner{grid-template-columns:1fr;gap:24px;padding:28px 20px;box-shadow:7px 7px 0 var(--fp-ink)}
        #FridayFilms-{{ section.id }} .fp-films__eyebrow{margin-bottom:11px;font-size:7.5px}
        #FridayFilms-{{ section.id }} .fp-films__eyebrow:before{width:19px}
        #FridayFilms-{{ section.id }} h2{max-width:7.7ch;font-size:clamp(43px,12.4vw,55px);line-height:.86}
        #FridayFilms-{{ section.id }} .fp-films__text{max-width:36ch;margin-top:14px;font-size:10px;line-height:1.53}
        #FridayFilms-{{ section.id }} .fp-films__note{margin-top:16px;font-size:7px}
        #FridayFilms-{{ section.id }} .fp-films__facts{margin-top:19px}
        #FridayFilms-{{ section.id }} .fp-films__fact{padding:11px 8px 12px;font-size:6.5px}
        #FridayFilms-{{ section.id }} .fp-films__rail{width:min(58vw,220px);justify-self:end}
        #FridayFilms-{{ section.id }} .fp-film-card{flex-basis:88%;max-width:none}
        #FridayFilms-{{ section.id }} .fp-film-card__index{left:10px;top:10px;padding:6px 8px;font-size:7px}
        #FridayFilms-{{ section.id }} .fp-film-card__open{padding:12px}
        #FridayFilms-{{ section.id }} .fp-film-card__open span{padding:9px 10px;font-size:7px}
        #FridayFilms-{{ section.id }} .fp-film-card__caption{margin-top:10px;padding-top:9px}
        #FridayFilms-{{ section.id }} .fp-film-card__caption span,#FridayFilms-{{ section.id }} .fp-film-card__caption small{font-size:7px}
        #FridayFilms-{{ section.id }} .fp-film-card__caption strong{font-size:8px}
        #FridayFilms-{{ section.id }} .fp-film-dialog__inner{padding:64px 14px 20px}
        #FridayFilms-{{ section.id }} .fp-film-dialog video{max-width:88vw;max-height:calc(100dvh - 122px)}
        #FridayFilms-{{ section.id }} .fp-film-dialog__close{right:14px;top:14px;width:40px;height:40px}
        #FridayFilms-{{ section.id }} .fp-film-dialog__meta{width:88vw;font-size:7px}
      }
      @media(prefers-reduced-motion:reduce){#FridayFilms-{{ section.id }} .fp-film-card__media video{transition:none}}
    </style>

    <div class="fp-films__inner">
      <header class="fp-films__intro">
        {% if section.settings.eyebrow != blank %}<p class="fp-films__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div class="fp-films__text">{{ section.settings.text }}</div>{% endif %}
        {% if section.settings.note != blank %}<p class="fp-films__note">{{ section.settings.note }}</p>{% endif %}
        <div class="fp-films__facts" aria-label="What comes with your print">
          <div class="fp-films__fact"><b>01</b>numbered<br>edition</div>
          <div class="fp-films__fact"><b>02</b>removable<br>mount</div>
          <div class="fp-films__fact"><b>03</b>packed<br>by hand</div>
        </div>
      </header>

      <div class="fp-films__rail" data-count="{{ visible_story_count }}" aria-label="Friday Prints films">
        {% if section.blocks.size > 0 %}
          {% assign fp_rendered_index = 0 %}
          {% for block in section.blocks %}
            {% liquid
              assign fp_block_has_video = false
              assign fp_block_is_visible = false
              if block.settings.video != blank
                assign fp_block_has_video = true
                assign fp_block_is_visible = true
              elsif forloop.first and section.settings.use_sample_video
                assign fp_block_has_video = true
                assign fp_block_is_visible = true
              elsif request.design_mode
                assign fp_block_is_visible = true
              endif
              assign fp_block_poster_url = blank
              if block.settings.poster != blank
                assign fp_block_poster_url = block.settings.poster | image_url: width: 1200
              endif
            %}
            {% if fp_block_is_visible %}
              {% assign fp_rendered_index = fp_rendered_index | plus: 1 %}
              {% assign fp_dialog_id = 'FridayFilmDialog-' | append: section.id | append: '-' | append: block.id %}
              <figure class="fp-film-card" {{ block.shopify_attributes }}>
                <div class="fp-film-card__media">
                  <span class="fp-film-card__index" aria-hidden="true">0{{ fp_rendered_index }}</span>
                  {% if block.settings.video != blank %}
                    {{ block.settings.video | video_tag: image_size: '1200x', autoplay: section.settings.autoplay, loop: section.settings.loop, muted: true, controls: false, playsinline: true, preload: 'metadata', poster: fp_block_poster_url }}
                  {% elsif forloop.first and section.settings.use_sample_video %}
                    <video src="{{ 'friday-unboxing.mp4' | asset_url }}" poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 1200 }}{% else %}{{ 'friday-unboxing-poster.webp' | asset_url }}{% endif %}" {% if section.settings.autoplay %}autoplay muted{% endif %} {% if section.settings.loop %}loop{% endif %} playsinline preload="metadata"></video>
                  {% elsif request.design_mode %}
                    <div class="fp-film-card__placeholder">Choose a Shopify-hosted video</div>
                  {% endif %}
                  {% if fp_block_has_video %}<button class="fp-film-card__open" type="button" data-fp-film-open="{{ fp_dialog_id }}" aria-label="Watch the full unboxing film"><span>watch full film ↗</span></button>{% endif %}
                </div>
                {% if block.settings.heading != blank or block.settings.caption != blank %}
                  <figcaption class="fp-film-card__caption">
                    <span>{% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong><br>{% endif %}{{ block.settings.caption }}</span>
                    <small>CAIRO → YOU</small>
                  </figcaption>
                {% endif %}
              </figure>
              {% if fp_block_has_video %}
                <dialog class="fp-film-dialog" id="{{ fp_dialog_id }}" aria-label="Friday Prints unboxing film">
                  <div class="fp-film-dialog__inner">
                    <button class="fp-film-dialog__close" type="button" data-fp-film-close aria-label="Close film">×</button>
                    <div class="fp-film-dialog__stage">
                      {% if block.settings.video != blank %}
                        {{ block.settings.video | video_tag: image_size: '1200x', autoplay: false, loop: false, muted: false, controls: true, playsinline: true, preload: 'none', poster: fp_block_poster_url }}
                      {% else %}
                        <video src="{{ 'friday-unboxing.mp4' | asset_url }}" poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 1200 }}{% else %}{{ 'friday-unboxing-poster.webp' | asset_url }}{% endif %}" controls playsinline preload="none"></video>
                      {% endif %}
                    </div>
                    <div class="fp-film-dialog__meta"><span>{{ block.settings.heading | default: 'wrapped by hand' }}</span><span>FRIDAY PRINTS · CAIRO</span></div>
                  </div>
                </dialog>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% elsif section.settings.use_sample_video %}
          {% assign fp_dialog_id = 'FridayFilmDialog-' | append: section.id | append: '-sample' %}
          <figure class="fp-film-card">
            <div class="fp-film-card__media">
              <span class="fp-film-card__index" aria-hidden="true">01</span>
              <video src="{{ 'friday-unboxing.mp4' | asset_url }}" poster="{{ 'friday-unboxing-poster.webp' | asset_url }}" {% if section.settings.autoplay %}autoplay muted{% endif %} {% if section.settings.loop %}loop{% endif %} playsinline preload="metadata"></video>
              <button class="fp-film-card__open" type="button" data-fp-film-open="{{ fp_dialog_id }}" aria-label="Watch the full unboxing film"><span>watch full film ↗</span></button>
            </div>
          </figure>
          <dialog class="fp-film-dialog" id="{{ fp_dialog_id }}" aria-label="Friday Prints unboxing film">
            <div class="fp-film-dialog__inner">
              <button class="fp-film-dialog__close" type="button" data-fp-film-close aria-label="Close film">×</button>
              <div class="fp-film-dialog__stage"><video src="{{ 'friday-unboxing.mp4' | asset_url }}" poster="{{ 'friday-unboxing-poster.webp' | asset_url }}" controls playsinline preload="none"></video></div>
              <div class="fp-film-dialog__meta"><span>wrapped by hand</span><span>FRIDAY PRINTS · CAIRO</span></div>
            </div>
          </dialog>
        {% endif %}
      </div>
    </div>

    <script>
      (() => {
        const root = document.getElementById('FridayFilms-{{ section.id }}');
        if (!root || root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';
        const previews = [...root.querySelectorAll('.fp-film-card__media > video')];
        const dialogs = [...root.querySelectorAll('.fp-film-dialog')];

        root.querySelectorAll('[data-fp-film-open]').forEach((button) => button.addEventListener('click', () => {
          const dialog = document.getElementById(button.dataset.fpFilmOpen);
          if (!dialog) return;
          previews.forEach((video) => video.pause());
          dialog.showModal();
          const film = dialog.querySelector('video');
          if (film) {
            film.currentTime = 0;
            film.play().catch(() => {});
          }
        }));

        dialogs.forEach((dialog) => {
          const close = () => dialog.close();
          dialog.querySelector('[data-fp-film-close]')?.addEventListener('click', close);
          dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
          dialog.addEventListener('close', () => {
            const film = dialog.querySelector('video');
            film?.pause();
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches && {{ section.settings.autoplay | json }}) previews.forEach((video) => video.play().catch(() => {}));
          });
        });

        if (!{{ section.settings.autoplay | json }} || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          previews.forEach((video) => video.pause());
          return;
        }
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (dialogs.some((dialog) => dialog.open)) return;
          if (entry.isIntersecting) entry.target.play().catch(() => {});
          else entry.target.pause();
        }), { threshold:.35 });
        previews.forEach((video) => observer.observe(video));
      })();
    </script>
  </section>
{% endif %}

{% schema %}
{
  "name": "Friday video stories",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 · UNBOX FRIDAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "the art of arrival" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>Every print leaves Cairo wrapped by hand, numbered and ready to become part of your space.</p>" },
    { "type": "text", "id": "note", "label": "Small note", "default": "MADE TO ORDER · PACKED WITH CARE" },
    { "type": "checkbox", "id": "use_sample_video", "label": "Use the supplied unboxing video when the first block is empty", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay preview silently when visible", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop preview videos", "default": true },
    { "type": "color", "id": "background_color", "label": "Insert background", "default": "#E9A5B2" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E53F36" }
  ],
  "blocks": [
    {
      "type": "film",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Shopify-hosted video" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (optional)" },
        { "type": "text", "id": "heading", "label": "Video title", "default": "wrapped by hand" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "A Friday print, from the first seal to the final reveal." }
      ]
    }
  ],
  "presets": [
    { "name": "Friday video stories", "blocks": [{ "type": "film" }] }
  ]
}
{% endschema %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'FridayProductForm-' | append: section.id
  assign can_add_cart = current_variant.available
  if current_variant == null
    assign can_add_cart = false
  endif
  assign add_to_cart_text = 'Add to cart'
  unless can_add_cart
    assign add_to_cart_text = 'Sold out'
  endunless
%}

<section
  class="fp-pdp"
  id="FridayProduct-{{ section.id }}"
  style="--fp-pdp-bg:{{ section.settings.background_color }};--fp-pdp-panel:{{ section.settings.panel_color }};--fp-pdp-accent:{{ section.settings.accent_color }};--fp-pdp-title:{{ section.settings.title_size_desktop }}px;--fp-pdp-title-mobile:{{ section.settings.title_size_mobile }}px;"
>
  <style>
    #FridayProduct-{{ section.id }}{background:var(--fp-pdp-bg);color:var(--fp-ink);border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} *{box-sizing:border-box}
    #FridayProduct-{{ section.id }} .fp-pdp__grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(390px,.65fr);align-items:start;min-height:70vh}
    #FridayProduct-{{ section.id }} .fp-pdp__gallery{min-width:0;padding:38px 38px 70px;border-right:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__media-list{display:grid;gap:28px}
    #FridayProduct-{{ section.id }} .fp-pdp__media{display:grid;place-items:center;min-height:420px;background:color-mix(in srgb,var(--fp-pdp-bg) 82%,#fff);overflow:hidden}
    #FridayProduct-{{ section.id }} .fp-pdp__media img,#FridayProduct-{{ section.id }} .fp-pdp__media svg{display:block;width:100%;height:auto;max-height:min(76vh,900px);object-fit:contain}
    #FridayProduct-{{ section.id }} .fp-pdp__media video,#FridayProduct-{{ section.id }} .fp-pdp__media model-viewer{width:100%;height:auto;max-height:76vh}
    #FridayProduct-{{ section.id }} .fp-pdp__details{position:sticky;top:0;min-width:0;padding:54px 46px 62px;background:var(--fp-pdp-panel)}
    #FridayProduct-{{ section.id }} .fp-pdp__eyebrow{margin:0 0 18px;color:var(--fp-pdp-accent);font:700 11px/1 "Courier New",monospace;letter-spacing:.09em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__title{max-width:10ch;margin:0;font:700 var(--fp-pdp-title)/.84 Georgia,"Times New Roman",serif;letter-spacing:-.055em;text-transform:lowercase;text-wrap:balance}
    #FridayProduct-{{ section.id }} .fp-pdp__price-row{display:flex;align-items:baseline;justify-content:space-between;gap:18px;margin:27px 0 0;padding-bottom:24px;border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__price{font:700 18px/1 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__edition{max-width:20ch;text-align:right;color:color-mix(in srgb,var(--fp-ink) 64%,transparent);font:10px/1.4 "Courier New",monospace;text-transform:uppercase;letter-spacing:.04em}
    #FridayProduct-{{ section.id }} .fp-pdp__variants{margin-top:25px}
    #FridayProduct-{{ section.id }} .fp-pdp__variants-label{display:flex;justify-content:space-between;gap:16px;margin-bottom:12px;font:700 10px/1 "Courier New",monospace;letter-spacing:.065em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__variant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    #FridayProduct-{{ section.id }} .fp-pdp__variant{position:relative}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input{position:absolute;opacity:0;pointer-events:none}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label{min-height:50px;padding:10px 13px;border:1px solid var(--fp-ink);display:flex;align-items:center;justify-content:space-between;gap:10px;cursor:pointer;font:700 11px/1.2 "Courier New",monospace;text-transform:uppercase;transition:background .18s ease,color .18s ease,transform .18s ease}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label small{font-size:8px;opacity:.58}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input:checked+label{background:var(--fp-ink);color:#fff}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input:focus-visible+label{outline:2px solid var(--fp-pdp-accent);outline-offset:3px}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label:hover{transform:translateY(-2px)}
    #FridayProduct-{{ section.id }} .fp-pdp__buy{margin-top:13px}
    #FridayProduct-{{ section.id }} .fp-pdp__add{width:100%!important;min-height:58px!important;border:1px solid var(--fp-pdp-accent)!important;border-radius:0!important;background:var(--fp-pdp-accent)!important;color:#fff!important;box-shadow:none!important;font:700 13px/1 "Courier New",monospace!important;letter-spacing:.035em!important;text-transform:lowercase!important;transition:transform .18s ease,background-color .18s ease!important}
    #FridayProduct-{{ section.id }} .fp-pdp__add:hover:not(:disabled){transform:translateY(-2px)}
    #FridayProduct-{{ section.id }} .fp-pdp__add:disabled{background:color-mix(in srgb,var(--fp-ink) 30%,var(--fp-pdp-bg))!important;border-color:transparent!important;color:color-mix(in srgb,var(--fp-ink) 62%,#fff)!important;cursor:not-allowed}
    #FridayProduct-{{ section.id }} .fp-pdp__fineprint{margin:11px 0 0;text-align:center;font:9px/1.4 "Courier New",monospace;color:color-mix(in srgb,var(--fp-ink) 60%,transparent)}
    #FridayProduct-{{ section.id }} .fp-pdp__description{margin-top:31px;padding-top:25px;border-top:1px solid var(--fp-line);font:13px/1.62 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__description>*:first-child{margin-top:0}
    #FridayProduct-{{ section.id }} .fp-pdp__description>*:last-child{margin-bottom:0}
    #FridayProduct-{{ section.id }} .fp-pdp__accordions{margin-top:30px;border-top:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion{border-bottom:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary{min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:15px;cursor:pointer;list-style:none;font:700 10px/1 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary::-webkit-details-marker{display:none}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary:after{content:'+';font-size:16px;font-weight:400}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion[open] summary:after{content:'−'}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content{padding:0 0 18px;max-width:48ch;font:11px/1.55 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content p{margin:0 0 8px}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content p:last-child{margin-bottom:0}
    #FridayProduct-{{ section.id }} .fp-pdp__support{margin-top:24px;font:10px/1.5 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__support a{color:inherit;text-underline-offset:3px}
    #FridayProduct-{{ section.id }} .fp-pdp__live{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:1100px){
      #FridayProduct-{{ section.id }} .fp-pdp__grid{grid-template-columns:minmax(0,1.05fr) minmax(350px,.95fr)}
      #FridayProduct-{{ section.id }} .fp-pdp__gallery{padding:30px 26px 56px}
      #FridayProduct-{{ section.id }} .fp-pdp__details{padding:44px 32px 54px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{font-size:clamp(52px,6vw,var(--fp-pdp-title))}
    }
    @media(max-width:749px){
      #FridayProduct-{{ section.id }} .fp-pdp__grid{display:block}
      #FridayProduct-{{ section.id }} .fp-pdp__gallery{padding:18px 12px 24px;border-right:0;border-bottom:1px solid var(--fp-line)}
      #FridayProduct-{{ section.id }} .fp-pdp__media-list{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:2px}
      #FridayProduct-{{ section.id }} .fp-pdp__media-list::-webkit-scrollbar{display:none}
      #FridayProduct-{{ section.id }} .fp-pdp__media{flex:0 0 91%;min-height:0;aspect-ratio:.707;scroll-snap-align:center}
      #FridayProduct-{{ section.id }} .fp-pdp__media img,#FridayProduct-{{ section.id }} .fp-pdp__media svg{width:100%;height:100%;max-height:none;object-fit:contain}
      #FridayProduct-{{ section.id }} .fp-pdp__details{position:relative;top:auto;padding:34px 20px 48px}
      #FridayProduct-{{ section.id }} .fp-pdp__eyebrow{font-size:9px;margin-bottom:12px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{max-width:11ch;font-size:var(--fp-pdp-title-mobile)}
      #FridayProduct-{{ section.id }} .fp-pdp__price-row{margin-top:21px;padding-bottom:20px}
      #FridayProduct-{{ section.id }} .fp-pdp__price{font-size:15px}
      #FridayProduct-{{ section.id }} .fp-pdp__edition{font-size:8px}
      #FridayProduct-{{ section.id }} .fp-pdp__variant label{min-height:48px;font-size:10px}
      #FridayProduct-{{ section.id }} .fp-pdp__add{min-height:56px!important;font-size:12px!important}
      #FridayProduct-{{ section.id }} .fp-pdp__description{font-size:12px}
    }
    @media(prefers-reduced-motion:reduce){#FridayProduct-{{ section.id }} .fp-pdp__variant label,#FridayProduct-{{ section.id }} .fp-pdp__add{transition:none}#FridayProduct-{{ section.id }} .fp-pdp__variant label:hover,#FridayProduct-{{ section.id }} .fp-pdp__add:hover{transform:none}}
  </style>

  <div class="fp-pdp__grid">
    <div class="fp-pdp__gallery" aria-label="{{ product.title | escape }} artwork gallery">
      <div class="fp-pdp__media-list" data-fp-media-list>
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <div class="fp-pdp__media" data-media-id="{{ media.id }}">
              {% case media.media_type %}
                {% when 'image' %}
                  {% assign media_alt = media.alt | default: product.title %}
                  {{ media | image_url: width: 1800 | image_tag: loading: forloop.first | default: 'lazy', widths: '480,720,960,1200,1500,1800', sizes: '(max-width: 749px) 91vw, (max-width: 1100px) 55vw, 65vw', alt: media_alt }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, preload: 'metadata' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag }}
                {% when 'model' %}
                  {{ media | model_viewer_tag }}
              {% endcase %}
            </div>
          {% endfor %}
        {% else %}
          <div class="fp-pdp__media">{{ 'product-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
    </div>

    <div class="fp-pdp__details">
      {% if section.settings.eyebrow != blank %}<p class="fp-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="fp-pdp__title">{{ product.title }}</h1>

      <div class="fp-pdp__price-row">
        <span class="fp-pdp__price" data-fp-price>{{ current_variant.price | money }}</span>
        <span class="fp-pdp__edition" data-fp-edition>limited numbered edition</span>
      </div>

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-quantity-default="1"
        id="ProductFormComponent-{{ section.id }}"
      >
        {% form 'product', product, id: product_form_id, class: 'fp-pdp__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ current_variant.id }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
          <input type="hidden" name="quantity" value="1">

          {% unless product.has_only_default_variant %}
            <div class="fp-pdp__variants">
              <div class="fp-pdp__variants-label"><span>{{ section.settings.variant_label }}</span><span data-fp-selected>{{ current_variant.title }}</span></div>
              <div class="fp-pdp__variant-grid" role="radiogroup" aria-label="{{ section.settings.variant_label | escape }}">
                {% for variant in product.variants %}
                  {% assign variant_id_string = variant.id | append: '' %}
                  <div class="fp-pdp__variant">
                    <input
                      type="radio"
                      id="FridayVariant-{{ section.id }}-{{ variant.id }}"
                      name="friday_variant"
                      value="{{ variant.id }}"
                      data-fp-variant
                      data-title="{{ variant.title | escape }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-available="{{ variant.available }}"
                      {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                      {% if variant.id == current_variant.id %}checked{% endif %}
                    >
                    <label for="FridayVariant-{{ section.id }}-{{ variant.id }}">
                      <span>{{ variant.title }}</span>
                      {% unless variant.available %}<small>sold out</small>{% endunless %}
                    </label>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endunless %}

          <div class="fp-pdp__buy" ref="productFormButtons">
            {% render 'add-to-cart-button',
              can_add_to_cart: can_add_cart,
              add_to_cart_text: add_to_cart_text,
              product: product,
              class: 'fp-pdp__add'
            %}
          </div>
          <div class="fp-pdp__live" ref="liveRegion" aria-live="polite" aria-atomic="true"></div>
          {% if section.settings.fineprint != blank %}<p class="fp-pdp__fineprint">{{ section.settings.fineprint }}</p>{% endif %}
        {% endform %}
      </product-form-component>

      {% if product.description != blank %}<div class="fp-pdp__description rte">{{ product.description }}</div>{% endif %}

      <div class="fp-pdp__accordions">
        <details class="fp-pdp__accordion" open>
          <summary>{{ section.settings.print_heading }}</summary>
          <div class="fp-pdp__accordion-content">
            <p>{{ section.settings.print_copy }}</p>
            <p>{{ section.settings.mount_copy }}</p>
          </div>
        </details>
        <details class="fp-pdp__accordion">
          <summary>{{ section.settings.delivery_heading }}</summary>
          <div class="fp-pdp__accordion-content"><p>{{ section.settings.delivery_copy }}</p></div>
        </details>
        <details class="fp-pdp__accordion">
          <summary>{{ section.settings.returns_heading }}</summary>
          <div class="fp-pdp__accordion-content"><p>{{ section.settings.returns_copy }}</p></div>
        </details>
      </div>

      {% if section.settings.support_email != blank or section.settings.instagram_url != blank %}
        <p class="fp-pdp__support">
          {{ section.settings.support_prefix }}
          {% if section.settings.support_email != blank %}<a href="mailto:{{ section.settings.support_email | escape }}">{{ section.settings.support_email }}</a>{% endif %}
          {% if section.settings.support_email != blank and section.settings.instagram_url != blank %} · {% endif %}
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>{% endif %}
        </p>
      {% endif %}
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('FridayProduct-{{ section.id }}');
      if (!root) return;
      const variantId = root.querySelector('input[name="id"]');
      const price = root.querySelector('[data-fp-price]');
      const edition = root.querySelector('[data-fp-edition]');
      const selected = root.querySelector('[data-fp-selected]');
      const button = root.querySelector('[ref="addToCartButton"]');
      const buttonText = root.querySelector('[ref="addToCartText"]');
      const mediaList = root.querySelector('[data-fp-media-list]');

      const editionFor = (title = '') => {
        const value = title.toLowerCase();
        if (value.includes('a3')) return '1 of 100 editions';
        if (value.includes('a4')) return '1 of 150 editions';
        if (value.includes('postcard')) return '1 of 250 editions';
        return 'limited numbered edition';
      };

      const applyVariant = (input) => {
        if (!input || !variantId) return;
        variantId.value = input.value;
        variantId.disabled = false;
        if (price) price.textContent = input.dataset.price || '';
        if (selected) selected.textContent = input.dataset.title || '';
        if (edition) edition.textContent = editionFor(input.dataset.title);
        const available = input.dataset.available === 'true';
        if (button) button.disabled = !available;
        if (buttonText) buttonText.textContent = available ? 'Add to cart' : 'Sold out';
        const mediaId = input.dataset.mediaId;
        if (mediaId && mediaList) {
          const target = mediaList.querySelector(`[data-media-id="${mediaId}"]`);
          target?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      };

      root.querySelectorAll('[data-fp-variant]').forEach((input) => input.addEventListener('change', () => applyVariant(input)));
      applyVariant(root.querySelector('[data-fp-variant]:checked'));
    })();
  </script>
</section>

{% schema %}
{
  "name": "Friday product",
  "settings": [
    { "type": "header", "content": "Product presentation" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LIMITED EDITION ART PRINT" },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "choose your size" },
    { "type": "text", "id": "fineprint", "label": "Purchase note", "default": "Made to order in Egypt · edition number on the back" },
    { "type": "header", "content": "Print guide" },
    { "type": "text", "id": "print_heading", "label": "Print accordion heading", "default": "the print" },
    { "type": "textarea", "id": "print_copy", "label": "Print details", "default": "Printed on premium matte paper, chosen for its rich colours and soft finish. Every Friday print is part of a limited numbered edition, with the edition number on the back." },
    { "type": "textarea", "id": "mount_copy", "label": "Mount details", "default": "Your print comes with a removable cardboard mount. Remove it to reveal the tinted border around the artwork, or keep it on for a clean, classic look." },
    { "type": "text", "id": "delivery_heading", "label": "Delivery accordion heading", "default": "delivery" },
    { "type": "textarea", "id": "delivery_copy", "label": "Delivery copy", "default": "Delivery typically takes 3–5 working days once your print has been produced and is ready to ship." },
    { "type": "text", "id": "returns_heading", "label": "Returns accordion heading", "default": "returns" },
    { "type": "textarea", "id": "returns_copy", "label": "Returns copy", "default": "Because each print is made to order, all print sales are final and cannot be returned or exchanged. If your order arrives damaged, please get in touch and we’ll help." },
    { "type": "header", "content": "Support" },
    { "type": "text", "id": "support_prefix", "label": "Support intro", "default": "Questions?" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "Eldemirdsh@gmail.com" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "@fridayprints.art" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Artwork background", "default": "#FBF1E4" },
    { "type": "color", "id": "panel_color", "label": "Purchase panel", "default": "#FBF1E4" },
    { "type": "color", "id": "accent_color", "label": "Accent / add to cart", "default": "#E53F36" },
    { "type": "range", "id": "title_size_desktop", "label": "Title size — desktop", "min": 54, "max": 96, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size — mobile", "min": 44, "max": 70, "step": 2, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Friday product" }]
}
{% endschema %}
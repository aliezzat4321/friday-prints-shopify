      #FridayProduct-{{ section.id }} .fp-pdp__recommend-grid{gap:18px}
    }

    @media(max-width:899px){
      body:has(#FridayProduct-{{ section.id }}) .fp-nav{height:84px}
      #FridayProduct-{{ section.id }} .fp-pdp__top{display:block}
      #FridayProduct-{{ section.id }} .fp-pdp__gallery{padding:22px 24px 28px;border-right:0;border-bottom:1px solid var(--fp-line)}
      #FridayProduct-{{ section.id }} .fp-pdp__media img{max-height:610px}
      #FridayProduct-{{ section.id }} .fp-pdp__details{padding:34px 28px 38px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{max-width:14ch;font-size:clamp(48px,7.5vw,62px)}
      #FridayProduct-{{ section.id }} .fp-pdp__about,#FridayProduct-{{ section.id }} .fp-pdp__info{grid-template-columns:1fr;gap:20px;padding:38px 28px}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox{grid-template-columns:minmax(0,1fr) minmax(270px,360px);gap:40px;padding:52px 38px}
      #FridayProduct-{{ section.id }} .fp-pdp__fact-band{grid-template-columns:repeat(2,1fr)}
      #FridayProduct-{{ section.id }} .fp-pdp__fact:nth-child(2){border-right:0}
      #FridayProduct-{{ section.id }} .fp-pdp__fact:nth-child(-n+2){border-bottom:1px solid var(--fp-line)}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend{padding:38px 28px 48px}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
      #FridayProduct-{{ section.id }} .fp-pdp-rec:nth-child(n+4){display:none}
    }

    @media(max-width:749px){
      body:has(#FridayProduct-{{ section.id }}) .fp-nav{height:auto}
      #FridayProduct-{{ section.id }} .fp-pdp__gallery{padding:15px 12px 18px}
      #FridayProduct-{{ section.id }} .fp-pdp__back{margin:0 8px 12px;font-size:9px}
      #FridayProduct-{{ section.id }} .fp-pdp__media-list{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 8px 2px}
      #FridayProduct-{{ section.id }} .fp-pdp__media-list::-webkit-scrollbar{display:none}
      #FridayProduct-{{ section.id }} .fp-pdp__media{flex:0 0 78%;min-height:0;aspect-ratio:.707;scroll-snap-align:center}
      #FridayProduct-{{ section.id }} .fp-pdp__media:first-child{grid-column:auto}
      #FridayProduct-{{ section.id }} .fp-pdp__media-button{width:100%;height:100%}
      #FridayProduct-{{ section.id }} .fp-pdp__media img,#FridayProduct-{{ section.id }} .fp-pdp__media svg{width:100%;height:100%;max-height:none;object-fit:contain}
      #FridayProduct-{{ section.id }} .fp-pdp__zoom-hint{display:none}
      #FridayProduct-{{ section.id }} .fp-pdp__details{padding:24px 20px 32px}
      #FridayProduct-{{ section.id }} .fp-pdp__eyebrow{font-size:8px;margin-bottom:10px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{max-width:12ch;font-size:clamp(42px,12vw,var(--fp-pdp-title-mobile));line-height:.9}
      #FridayProduct-{{ section.id }} .fp-pdp__price-row{margin-top:17px;padding-bottom:16px}
      #FridayProduct-{{ section.id }} .fp-pdp__price{font-size:14px}
      #FridayProduct-{{ section.id }} .fp-pdp__edition{font-size:8px}
      #FridayProduct-{{ section.id }} .fp-pdp__size-line{font-size:8px;padding:10px 0}
      #FridayProduct-{{ section.id }} .fp-pdp__edition-preview{gap:12px;margin-top:15px;padding-block:13px}
      #FridayProduct-{{ section.id }} .fp-pdp__edition-preview-copy strong{font-size:8px}
      #FridayProduct-{{ section.id }} .fp-pdp__edition-preview-copy small{font-size:8px;max-width:25ch}
      #FridayProduct-{{ section.id }} .fp-pdp__edition-number{font-size:30px}
      #FridayProduct-{{ section.id }} .fp-pdp__edition-number small{font-size:11px}
      #FridayProduct-{{ section.id }} .fp-pdp__variant label{min-height:44px;font-size:9px}
      #FridayProduct-{{ section.id }} .fp-pdp__add{min-height:54px!important;font-size:11px!important}
      #FridayProduct-{{ section.id }} .fp-pdp__assurances{margin-top:15px}
      #FridayProduct-{{ section.id }} .fp-pdp__assurance{min-height:47px;font-size:7px;padding:8px 5px}
      #FridayProduct-{{ section.id }} .fp-pdp__payment{font-size:9px}
      #FridayProduct-{{ section.id }} .fp-pdp__about{padding:32px 20px;gap:17px}
      #FridayProduct-{{ section.id }} .fp-pdp__about h2,#FridayProduct-{{ section.id }} .fp-pdp__recommend h2{font-size:38px}
      #FridayProduct-{{ section.id }} .fp-pdp__about-copy{font-size:12px;line-height:1.6}
      #FridayProduct-{{ section.id }} .fp-pdp__fact{min-height:100px;padding:18px 16px}
      #FridayProduct-{{ section.id }} .fp-pdp__fact strong{font-size:11px}
      #FridayProduct-{{ section.id }} .fp-pdp__info{padding:32px 20px;gap:17px}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox{grid-template-columns:1fr;gap:28px;padding:42px 20px 48px}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox:after{right:18px;top:25px;font-size:30px}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox h2{font-size:clamp(48px,15vw,64px);line-height:.86}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox-text{margin-top:20px;font-size:11px;line-height:1.6}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox-note{margin-top:20px;font-size:8px}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox-media{justify-self:center;width:min(82vw,340px)}
      #FridayProduct-{{ section.id }} .fp-pdp__unbox-stamp{left:-18px;top:28px;width:68px;height:68px;font-size:7.5px}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend{padding:32px 0 42px}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend-head{padding:0 20px;margin-bottom:18px}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend-all{display:none}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend-grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 20px 4px}
      #FridayProduct-{{ section.id }} .fp-pdp__recommend-grid::-webkit-scrollbar{display:none}
      #FridayProduct-{{ section.id }} .fp-pdp-rec{display:block!important;flex:0 0 68vw;max-width:250px;scroll-snap-align:start}
      #FridayProduct-{{ section.id }} .fp-pdp__lightbox-inner{padding:56px 16px 28px}
      #FridayProduct-{{ section.id }} .fp-pdp__lightbox-nav{width:38px;height:38px;top:auto;bottom:18px;transform:none}
      #FridayProduct-{{ section.id }} .fp-pdp__lightbox-prev{left:16px}
      #FridayProduct-{{ section.id }} .fp-pdp__lightbox-next{right:16px}
      #FridayProduct-{{ section.id }} .fp-pdp__lightbox-close{top:14px;right:14px;width:38px;height:38px}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar{position:fixed;left:0;right:0;bottom:0;z-index:2147481500;display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--fp-ink);background:var(--fp-pdp-bg);transform:translateY(115%);transition:transform .22s ease;box-shadow:0 -10px 28px rgba(23,18,15,.08)}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar.is-visible{transform:none}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar-meta{display:grid;gap:3px;font:700 9px/1.2 "Courier New",monospace;text-transform:uppercase}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar-meta span:last-child{font-weight:400;color:color-mix(in srgb,var(--fp-ink) 66%,transparent)}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar button{min-width:128px;height:44px;border:1px solid var(--fp-ink);background:var(--fp-ink);color:#fff;font:700 10px/1 "Courier New",monospace;text-transform:lowercase;cursor:pointer}
    }

    @media(max-width:350px){
      #FridayProduct-{{ section.id }} .fp-pdp__media{flex-basis:72%}
      #FridayProduct-{{ section.id }} .fp-pdp__details{padding-top:20px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{font-size:42px}
      #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar button{min-width:116px}
    }

    @media(prefers-reduced-motion:reduce){
      #FridayProduct-{{ section.id }} .fp-pdp__variant label,#FridayProduct-{{ section.id }} .fp-pdp__add,#FridayProduct-{{ section.id }} .fp-pdp-rec__media img,#FridayProduct-{{ section.id }} .fp-pdp__zoom-hint,#FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar{transition:none}
      #FridayProduct-{{ section.id }} .fp-pdp__variant label:hover,#FridayProduct-{{ section.id }} .fp-pdp__add:hover,#FridayProduct-{{ section.id }} .fp-pdp-rec:hover .fp-pdp-rec__media img{transform:none}
    }
  </style>

  <div class="fp-pdp__top">
    <div class="fp-pdp__gallery" aria-label="{{ product.title | escape }} artwork gallery">
      <a class="fp-pdp__back" href="{{ routes.all_products_collection_url }}">← all prints</a>
      <div class="fp-pdp__media-list" data-fp-media-list>
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <div class="fp-pdp__media" data-media-id="{{ media.id }}">
              {% case media.media_type %}
                {% when 'image' %}
                  {% assign media_alt = media.alt | default: product.title %}
                  {% assign media_loading = 'lazy' %}
                  {% if forloop.first %}{% assign media_loading = 'eager' %}{% endif %}
                  <button
                    type="button"
                    class="fp-pdp__media-button"
                    data-fp-lightbox-trigger
                    data-index="{{ forloop.index0 }}"
                    data-src="{{ media | image_url: width: 2400 }}"
                    data-alt="{{ media_alt | escape }}"
                    aria-label="Open {{ media_alt | escape }} full screen"
                  >
                    {{ media | image_url: width: 1800 | image_tag: loading: media_loading, widths: '480,720,960,1200,1500,1800', sizes: '(max-width: 749px) 78vw, (max-width: 899px) 90vw, (max-width: 1100px) 52vw, 62vw', alt: media_alt }}
                    <span class="fp-pdp__zoom-hint" aria-hidden="true">view artwork +</span>
                  </button>
                {% when 'video' %}
                  {{ media | video_tag: controls: true, preload: 'metadata' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag }}
                {% when 'model' %}
                  {{ media | model_viewer_tag }}
              {% endcase %}
            </div>
          {% endfor %}
        {% else %}
          <div class="fp-pdp__media">{{ 'product-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
    </div>

    <div class="fp-pdp__details">
      {% if section.settings.eyebrow != blank %}<p class="fp-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="fp-pdp__title">{{ product.title }}</h1>

      <div class="fp-pdp__price-row">
        <span class="fp-pdp__price" data-fp-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
        <span class="fp-pdp__edition" data-fp-edition>{{ fp_edition_label }}</span>
      </div>

      <div class="fp-pdp__size-line">
        <span data-fp-size>{% if fp_size_label != blank %}{{ fp_size_label }}{% else %}ART PRINT{% endif %}</span>
        <span data-fp-dimension>{% if fp_dimension_label != blank %}{{ fp_dimension_label }}{% else %}NUMBERED EDITION{% endif %}</span>
      </div>

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-quantity-default="1"
        id="ProductFormComponent-{{ section.id }}"
      >
        {% form 'product', product, id: product_form_id, class: 'fp-pdp__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ current_variant.id }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
          <input type="hidden" name="quantity" value="1">

          {% if fp_has_size_selector %}
            <div class="fp-pdp__variants">
              <div class="fp-pdp__variants-label"><span>{{ section.settings.variant_label }}</span><span data-fp-selected>{{ fp_size_label }}</span></div>
              <div class="fp-pdp__variant-grid" role="radiogroup" aria-label="{{ section.settings.variant_label | escape }}">
                {% for variant in product.variants %}
                  {% liquid
                    assign variant_size = blank
                    if fp_size_option_position == 1
                      assign variant_size = variant.option1
                    elsif fp_size_option_position == 2
                      assign variant_size = variant.option2
                    elsif fp_size_option_position == 3
                      assign variant_size = variant.option3
                    endif
                    if variant_size == blank
                      assign variant_size = variant.metafields.custom.print_size.value | default: product.metafields.custom.print_size.value
                    endif
                    if variant_size == blank and variant.title != 'Default Title'
                      assign variant_size = variant.title
                    endif
                    if variant_size == blank
                      if product.handle contains '-a3'
                        assign variant_size = 'A3'
                      elsif product.handle contains '-a4'
                        assign variant_size = 'A4'
                      elsif product.handle contains 'postcard'
                        assign variant_size = 'POSTCARD'
                      else
                        assign variant_size = 'ART PRINT'
                      endif
                    endif
                    assign variant_dimension = variant.metafields.custom.print_dimensions.value | default: product.metafields.custom.print_dimensions.value
                    assign variant_edition_total = variant.metafields.custom.edition_total.value | default: product.metafields.custom.edition_total.value
                    assign variant_size_key = variant_size | downcase
                    if variant_size_key contains 'a3'
                      assign variant_dimension = variant_dimension | default: '29.7 × 42 CM'
                      assign variant_edition_total = variant_edition_total | default: 100
                    elsif variant_size_key contains 'a4'
                      assign variant_dimension = variant_dimension | default: '21 × 29.7 CM'
                      assign variant_edition_total = variant_edition_total | default: 150
                    elsif variant_size_key contains 'postcard'
                      assign variant_edition_total = variant_edition_total | default: 250
                    endif
                    assign variant_edition_total = variant_edition_total | plus: 0
                    assign variant_next_edition = variant.metafields.custom.next_edition_number.value | default: product.metafields.custom.next_edition_number.value
                    if variant_next_edition == blank and variant_edition_total > 0 and variant.inventory_management != blank
                      assign variant_next_edition = variant_edition_total | minus: variant.inventory_quantity | plus: 1
                    endif
                    if variant_next_edition == blank and variant_edition_total > 0
                      assign variant_next_edition = 1
                    endif
                    assign variant_next_edition = variant_next_edition | plus: 0
                    if variant_next_edition < 1
                      assign variant_next_edition = 1
                    endif
                    if variant_edition_total > 0 and variant_next_edition > variant_edition_total
                      assign variant_next_edition = variant_edition_total
                    endif
                  %}
                  <div class="fp-pdp__variant">
                    <input
                      type="radio"
                      id="FridayVariant-{{ section.id }}-{{ variant.id }}"
                      name="friday_variant"
                      value="{{ variant.id }}"
                      data-fp-variant
                      data-title="{{ variant_size | escape }}"
                      data-price="{{ variant.price | money_without_trailing_zeros | escape }}"
                      data-available="{{ variant.available }}"
                      data-size="{{ variant_size | escape }}"
                      data-dimension="{{ variant_dimension | escape }}"
                      data-edition-total="{{ variant_edition_total }}"
                      data-next-edition="{{ variant_next_edition }}"
                      {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                      {% if variant.id == current_variant.id %}checked{% endif %}
                    >
                    <label for="FridayVariant-{{ section.id }}-{{ variant.id }}">
                      <span>{{ variant_size }}</span>
                      {% unless variant.available %}<small>sold out</small>{% endunless %}
                    </label>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <div class="fp-pdp__edition-preview" data-fp-edition-preview aria-live="polite" {% if fp_edition_total < 1 %}hidden{% endif %}>
            <span class="fp-pdp__edition-preview-copy">
              <strong>{{ section.settings.next_edition_label }}</strong>
              <small>{{ section.settings.next_edition_note }}</small>
            </span>
            <span class="fp-pdp__edition-number"><span data-fp-next-edition>{{ fp_next_edition_padded }}</span><small>/<span data-fp-edition-total>{{ fp_edition_total }}</span></small></span>
          </div>

          <div class="fp-pdp__buy" ref="productFormButtons">
            {% render 'add-to-cart-button',
              can_add_to_cart: can_add_cart,
              add_to_cart_text: add_to_cart_text,
              product: product,
              class: 'fp-pdp__add'
            %}
          </div>
          <div class="fp-pdp__live" ref="liveRegion" aria-live="polite" aria-atomic="true"></div>
          {% if section.settings.fineprint != blank %}<p class="fp-pdp__fineprint">{{ section.settings.fineprint }}</p>{% endif %}
        {% endform %}
      </product-form-component>

      <div class="fp-pdp__assurances" aria-label="Print assurances">
        <span class="fp-pdp__assurance">numbered<br>edition</span>
        <span class="fp-pdp__assurance">premium<br>matte</span>
        <span class="fp-pdp__assurance">made to<br>order</span>
      </div>
      {% if section.settings.payment_note != blank %}<p class="fp-pdp__payment">{{ section.settings.payment_note }}</p>{% endif %}
    </div>
  </div>

  <div class="fp-pdp__below">
    {% if description_plain != blank %}
      <section class="fp-pdp__about" aria-labelledby="FridayAbout-{{ section.id }}">
        <div>
          <p class="fp-pdp__section-label">01 · artwork</p>
          <h2 id="FridayAbout-{{ section.id }}">about this print</h2>
        </div>
        <div class="fp-pdp__about-copy">
          <p>{{ description_plain | truncatewords: 70 }}</p>
          {% if description_plain.size > 420 %}
            <details class="fp-pdp__full-notes">
              <summary>full print notes</summary>
              <div class="rte">{{ product.description }}</div>
            </details>
          {% endif %}
        </div>
      </section>
    {% endif %}

    <div class="fp-pdp__fact-band" aria-label="Print specifications">
      <div class="fp-pdp__fact"><small>edition</small><strong data-fp-fact-edition>{{ fp_edition_label }}</strong></div>
      <div class="fp-pdp__fact"><small>size</small><strong data-fp-fact-size>{% if fp_size_label != blank %}{{ fp_size_label }}{% else %}ART PRINT{% endif %}{% if fp_dimension_label != blank %}<br>{{ fp_dimension_label }}{% endif %}</strong></div>
      <div class="fp-pdp__fact"><small>paper</small><strong>premium matte</strong></div>
      <div class="fp-pdp__fact"><small>made</small><strong>to order<br>in Egypt</strong></div>
    </div>

    <section class="fp-pdp__info" aria-labelledby="FridayInfo-{{ section.id }}">
      <div>
        <p class="fp-pdp__section-label">02 · details</p>
        <h2 id="FridayInfo-{{ section.id }}" style="margin:8px 0 0;font:700 clamp(34px,3vw,48px)/.92 Georgia,'Times New Roman',serif;letter-spacing:-.04em;text-transform:lowercase">before it arrives</h2>
      </div>
      <div>
        <div class="fp-pdp__accordions">
          <details class="fp-pdp__accordion" open>
            <summary>{{ section.settings.print_heading }}</summary>
            <div class="fp-pdp__accordion-content">
              <p>{{ section.settings.print_copy }}</p>
              <p>{{ section.settings.mount_copy }}</p>
            </div>
          </details>
          <details class="fp-pdp__accordion">
            <summary>{{ section.settings.delivery_heading }}</summary>
            <div class="fp-pdp__accordion-content"><p>{{ section.settings.delivery_copy }}</p></div>
          </details>
          <details class="fp-pdp__accordion">
            <summary>{{ section.settings.returns_heading }}</summary>
            <div class="fp-pdp__accordion-content"><p>{{ section.settings.returns_copy }}</p></div>
          </details>
        </div>

        {% if section.settings.support_prefix != blank or section.settings.instagram_url != blank %}
          <p class="fp-pdp__support">
            {{ section.settings.support_prefix }}
            <a href="{{ routes.root_url }}pages/contact">{{ section.settings.contact_label }}</a>
            {% if section.settings.instagram_url != blank %} · {% endif %}
            {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>{% endif %}
          </p>
        {% endif %}
      </div>
    </section>
  </div>

  {% if fp_show_unboxing %}
    <section class="fp-pdp__unbox" aria-labelledby="FridayUnbox-{{ section.id }}">
      <div class="fp-pdp__unbox-copy">
        <p class="fp-pdp__section-label">03 · unbox friday</p>
        <h2 id="FridayUnbox-{{ section.id }}">{{ section.settings.unboxing_heading }}</h2>
        {% if section.settings.unboxing_text != blank %}<div class="fp-pdp__unbox-text">{{ section.settings.unboxing_text }}</div>{% endif %}
        {% if section.settings.unboxing_note != blank %}<p class="fp-pdp__unbox-note">{{ section.settings.unboxing_note }}</p>{% endif %}
      </div>
      <figure class="fp-pdp__unbox-media">
        <div class="fp-pdp__unbox-frame">
          <span class="fp-pdp__unbox-stamp" aria-hidden="true">from cairo<br>with care</span>
          {% if section.settings.unboxing_video != blank %}
            {{ section.settings.unboxing_video | video_tag: image_size: '900x', autoplay: false, loop: false, muted: false, controls: true, playsinline: true, preload: 'metadata', poster: fp_unboxing_poster_url }}
          {% else %}
            <video src="{{ 'friday-unboxing.mp4' | asset_url }}" poster="{% if section.settings.unboxing_poster != blank %}{{ section.settings.unboxing_poster | image_url: width: 900 }}{% else %}{{ 'friday-unboxing-poster.webp' | asset_url }}{% endif %}" controls playsinline preload="metadata"></video>
          {% endif %}
        </div>
        <figcaption class="fp-pdp__unbox-caption"><span>{{ section.settings.unboxing_caption }}</span><span>PLAY ↗</span></figcaption>
      </figure>
    </section>
  {% endif %}

  {% if section.settings.show_recommendations %}
    <section class="fp-pdp__recommend" aria-labelledby="FridayRecommend-{{ section.id }}">
      <div class="fp-pdp__recommend-head">
        <div>
          <p class="fp-pdp__section-label">04 · keep looking</p>
          <h2 id="FridayRecommend-{{ section.id }}">{{ section.settings.recommendations_heading }}</h2>
        </div>
        <a class="fp-pdp__recommend-all" href="{{ routes.all_products_collection_url }}">shop all prints →</a>
      </div>
      <div class="fp-pdp__recommend-grid">
        {% assign recommendation_count = 0 %}
        {% if section.settings.recommended_products != blank %}
          {% for recommended_product in section.settings.recommended_products limit: 4 %}
            {% unless recommended_product.id == product.id %}
              <a class="fp-pdp-rec" href="{{ recommended_product.url }}">
                <div class="fp-pdp-rec__media">
                  {% if recommended_product.featured_image %}
                    {{ recommended_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240,360,520,680,800', sizes: '(max-width: 749px) 68vw, (max-width: 899px) 33vw, 25vw', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% endif %}
                </div>
                <div class="fp-pdp-rec__meta"><span>{{ recommended_product.title }}</span><span class="fp-pdp-rec__price">{{ recommended_product.price | money_without_trailing_zeros }}</span></div>
              </a>
              {% assign recommendation_count = recommendation_count | plus: 1 %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {% for recommended_product in fallback_collection.products %}
            {% unless recommended_product.id == product.id %}
              <a class="fp-pdp-rec" href="{{ recommended_product.url }}">
                <div class="fp-pdp-rec__media">
                  {% if recommended_product.featured_image %}
                    {{ recommended_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240,360,520,680,800', sizes: '(max-width: 749px) 68vw, (max-width: 899px) 33vw, 25vw', alt: recommended_product.featured_image.alt | default: recommended_product.title }}
                  {% endif %}
                </div>
                <div class="fp-pdp-rec__meta"><span>{{ recommended_product.title }}</span><span class="fp-pdp-rec__price">{{ recommended_product.price | money_without_trailing_zeros }}</span></div>
              </a>
              {% assign recommendation_count = recommendation_count | plus: 1 %}
              {% if recommendation_count >= 4 %}{% break %}{% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}
      </div>
    </section>
  {% endif %}

  <dialog class="fp-pdp__lightbox" data-fp-lightbox aria-label="Artwork viewer">
    <div class="fp-pdp__lightbox-inner">
      <button class="fp-pdp__lightbox-close" type="button" data-fp-lightbox-close aria-label="Close artwork viewer">×</button>
      <button class="fp-pdp__lightbox-nav fp-pdp__lightbox-prev" type="button" data-fp-lightbox-prev aria-label="Previous artwork">←</button>
      <img data-fp-lightbox-image alt="">
      <button class="fp-pdp__lightbox-nav fp-pdp__lightbox-next" type="button" data-fp-lightbox-next aria-label="Next artwork">→</button>
    </div>
  </dialog>

  <div class="fp-pdp__mobile-buybar" data-fp-mobile-buybar aria-hidden="true">
    <div class="fp-pdp__mobile-buybar-meta"><span data-fp-sticky-size>{% if fp_size_label != blank %}{{ fp_size_label }}{% else %}PRINT{% endif %}</span><span data-fp-sticky-price>{{ current_variant.price | money_without_trailing_zeros }}</span></div>
    <button type="button" data-fp-sticky-add {% unless can_add_cart %}disabled{% endunless %}>{{ add_to_cart_text }}</button>
  </div>

  <script>
    (() => {
      const root = document.getElementById('FridayProduct-{{ section.id }}');
      if (!root || root.dataset.fpReady === 'true') return;
      root.dataset.fpReady = 'true';

      const variantId = root.querySelector('input[name="id"]');
      const price = root.querySelector('[data-fp-price]');
      const edition = root.querySelector('[data-fp-edition]');
      const size = root.querySelector('[data-fp-size]');
      const dimension = root.querySelector('[data-fp-dimension]');
      const factEdition = root.querySelector('[data-fp-fact-edition]');
      const factSize = root.querySelector('[data-fp-fact-size]');
      const selected = root.querySelector('[data-fp-selected]');
      const button = root.querySelector('[ref="addToCartButton"]');
      const buttonText = root.querySelector('[ref="addToCartText"]');
      const mediaList = root.querySelector('[data-fp-media-list]');
      const stickyBar = root.querySelector('[data-fp-mobile-buybar]');
      const stickyAdd = root.querySelector('[data-fp-sticky-add]');
      const stickyPrice = root.querySelector('[data-fp-sticky-price]');
      const stickySize = root.querySelector('[data-fp-sticky-size]');
      const editionPreview = root.querySelector('[data-fp-edition-preview]');
      const nextEdition = root.querySelector('[data-fp-next-edition]');
      const editionTotal = root.querySelector('[data-fp-edition-total]');
      const fallbackMeta = {
        size: {{ fp_size_label | json }},
        dimension: {{ fp_dimension_label | default: 'NUMBERED EDITION' | json }},
        editionTotal: {{ fp_edition_total | json }},
        nextEdition: {{ fp_next_edition | json }}
      };

      const metaFor = (source = {}) => {
        const editionTotalValue = Number.parseInt(source.editionTotal, 10) || 0;
        const nextEditionValue = Math.min(editionTotalValue || Infinity, Math.max(1, Number.parseInt(source.nextEdition, 10) || 1));
        return {
          size: source.size || source.title || 'ART PRINT',
          dimension: source.dimension || 'NUMBERED EDITION',
          editionTotal: editionTotalValue,
          nextEdition: nextEditionValue,
          edition: editionTotalValue > 0 ? `EDITION OF ${editionTotalValue}` : 'LIMITED NUMBERED EDITION'
        };
      };

      const setButtonState = (available) => {
        if (button) button.disabled = !available;
        if (buttonText) buttonText.textContent = available ? 'Add to cart' : 'Sold out';
        if (stickyAdd) {
          stickyAdd.disabled = !available;
          stickyAdd.textContent = available ? 'add to cart' : 'sold out';
        }
      };

      const updateMeta = (source = {}, variantPrice = '') => {
        const meta = metaFor(source);
        if (edition) edition.textContent = meta.edition;
        if (factEdition) factEdition.textContent = meta.edition;
        if (size) size.textContent = meta.size;
        if (dimension) dimension.textContent = meta.dimension;
        if (factSize) factSize.innerHTML = meta.dimension && meta.dimension !== 'NUMBERED EDITION' ? `${meta.size}<br>${meta.dimension}` : meta.size;
        if (stickySize) stickySize.textContent = meta.size;
        if (variantPrice && stickyPrice) stickyPrice.textContent = variantPrice;
        if (editionPreview) editionPreview.hidden = meta.editionTotal < 1;
        if (nextEdition) nextEdition.textContent = String(meta.nextEdition).padStart(3, '0');
        if (editionTotal) editionTotal.textContent = String(meta.editionTotal);
      };

      const applyVariant = (input) => {
        if (!input || !variantId) return;
        variantId.value = input.value;
        variantId.disabled = false;
        const variantUrl = new URL(window.location.href);
        variantUrl.searchParams.set('variant', input.value);
        window.history.replaceState({}, '', `${variantUrl.pathname}${variantUrl.search}${variantUrl.hash}`);
        if (price) price.textContent = input.dataset.price || '';
        if (selected) selected.textContent = input.dataset.title || '';
        const available = input.dataset.available === 'true';
        setButtonState(available);
        updateMeta({
          title: input.dataset.title,
          size: input.dataset.size,
          dimension: input.dataset.dimension,
          editionTotal: input.dataset.editionTotal,
          nextEdition: input.dataset.nextEdition
        }, input.dataset.price || '');
        const mediaId = input.dataset.mediaId;
        if (mediaId && mediaList) {
          const target = mediaList.querySelector(`[data-media-id="${mediaId}"]`);
          target?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      };

      root.querySelectorAll('[data-fp-variant]').forEach((input) => input.addEventListener('change', () => applyVariant(input)));
      const checkedVariant = root.querySelector('[data-fp-variant]:checked');
      if (checkedVariant) applyVariant(checkedVariant);
      else updateMeta(fallbackMeta, {{ current_variant.price | money_without_trailing_zeros | json }});

      const lightbox = root.querySelector('[data-fp-lightbox]');
      const lightboxImage = root.querySelector('[data-fp-lightbox-image]');
      const triggers = [...root.querySelectorAll('[data-fp-lightbox-trigger]')];
      let activeIndex = 0;
      const renderLightbox = (index) => {
        if (!triggers.length || !lightboxImage) return;
        activeIndex = (index + triggers.length) % triggers.length;
        const trigger = triggers[activeIndex];
        lightboxImage.src = trigger.dataset.src || '';
        lightboxImage.alt = trigger.dataset.alt || '';
        const showNav = triggers.length > 1;
        root.querySelector('[data-fp-lightbox-prev]')?.toggleAttribute('hidden', !showNav);
        root.querySelector('[data-fp-lightbox-next]')?.toggleAttribute('hidden', !showNav);
      };
      triggers.forEach((trigger, index) => trigger.addEventListener('click', () => {
        renderLightbox(index);
        lightbox?.showModal();
      }));
      root.querySelector('[data-fp-lightbox-close]')?.addEventListener('click', () => lightbox?.close());
      root.querySelector('[data-fp-lightbox-prev]')?.addEventListener('click', () => renderLightbox(activeIndex - 1));
      root.querySelector('[data-fp-lightbox-next]')?.addEventListener('click', () => renderLightbox(activeIndex + 1));
      lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
      lightbox?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') renderLightbox(activeIndex - 1);
        if (event.key === 'ArrowRight') renderLightbox(activeIndex + 1);
      });

      if (stickyBar && button) {
        let hasSeenMainCta = false;
        const updateSticky = () => {
          if (window.innerWidth > 749) {
            stickyBar.classList.remove('is-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
            return;
          }
          const rect = button.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) hasSeenMainCta = true;
          const visible = hasSeenMainCta && rect.bottom < 0;
          stickyBar.classList.toggle('is-visible', visible);
          stickyBar.setAttribute('aria-hidden', visible ? 'false' : 'true');
        };
        window.addEventListener('scroll', updateSticky, { passive: true });
        window.addEventListener('resize', updateSticky);
        updateSticky();
      }
      stickyAdd?.addEventListener('click', () => {
        if (!stickyAdd.disabled) button?.click();
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Friday product",
  "settings": [
    { "type": "header", "content": "Product presentation" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LIMITED EDITION ART PRINT" },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "choose your size" },
    { "type": "text", "id": "fineprint", "label": "Purchase note", "default": "Made to order in Egypt · edition number on the back" },
    { "type": "text", "id": "payment_note", "label": "Payment note", "default": "Instapay · Cash on delivery" },
    { "type": "text", "id": "next_edition_label", "label": "Next edition label", "default": "NEXT AVAILABLE EDITION" },
    { "type": "text", "id": "next_edition_note", "label": "Next edition note", "default": "Your exact number is confirmed when your order is placed." },
    { "type": "header", "content": "Print guide" },
    { "type": "text", "id": "print_heading", "label": "Print accordion heading", "default": "care & framing" },
    { "type": "textarea", "id": "print_copy", "label": "Print details", "default": "Printed on premium matte paper, chosen for its rich colours and soft finish. Every Friday print is part of a limited numbered edition, with the edition number on the back." },
    { "type": "textarea", "id": "mount_copy", "label": "Mount details", "default": "Your print comes with a removable cardboard mount. Remove it to reveal the tinted border around the artwork, or keep it on for a clean, classic look." },
    { "type": "text", "id": "delivery_heading", "label": "Delivery accordion heading", "default": "delivery" },
    { "type": "textarea", "id": "delivery_copy", "label": "Delivery copy", "default": "Delivery typically takes 3–7 working days once your print has been produced and is ready to ship." },
    { "type": "text", "id": "returns_heading", "label": "Returns accordion heading", "default": "returns" },
    { "type": "textarea", "id": "returns_copy", "label": "Returns copy", "default": "Friday Prints are produced to order in limited editions. We do not normally accept returns or exchanges for change of mind where permitted by applicable law. This does not affect rights under applicable consumer protection law. If your order arrives damaged, defective or incorrect, contact us with photos and your order number." },
    { "type": "header", "content": "Unboxing film" },
    { "type": "checkbox", "id": "show_unboxing", "label": "Show unboxing film", "default": true },
    { "type": "video", "id": "unboxing_video", "label": "Shopify-hosted unboxing video" },
    { "type": "image_picker", "id": "unboxing_poster", "label": "Poster image (optional)" },
    { "type": "checkbox", "id": "use_default_unboxing", "label": "Use the supplied film when no video is selected", "default": true },
    { "type": "text", "id": "unboxing_heading", "label": "Heading", "default": "a little friday, delivered" },
    { "type": "richtext", "id": "unboxing_text", "label": "Text", "default": "<p>Wrapped by hand in Cairo, with every limited-edition detail included. Open it slowly—the reveal is part of the story.</p>" },
    { "type": "text", "id": "unboxing_note", "label": "Small note", "default": "MADE TO ORDER · PACKED WITH CARE" },
    { "type": "text", "id": "unboxing_caption", "label": "Video caption", "default": "SEE WHAT ARRIVES" },
    { "type": "color", "id": "unboxing_background", "label": "Background", "default": "#E9A5B2" },
    { "type": "header", "content": "Recommendations" },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show more prints", "default": true },
    { "type": "text", "id": "recommendations_heading", "label": "Recommendations heading", "default": "more from GiGi" },
    { "type": "product_list", "id": "recommended_products", "label": "Recommended prints", "limit": 4, "info": "Optional. Leave blank to automatically use other prints from the same collection." },
    { "type": "header", "content": "Support" },
    { "type": "text", "id": "support_prefix", "label": "Support intro", "default": "Questions?" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "send us a note" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "Eldemirdsh@gmail.com" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "@fridayprints.art" },
    { "type": "header", "content": "Design-safe styling" },
    { "type": "color", "id": "background_color", "label": "Artwork background", "default": "#FBF1E4" },
    { "type": "color", "id": "panel_color", "label": "Purchase panel", "default": "#FBF1E4" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#E53F36" },
    { "type": "range", "id": "title_size_desktop", "label": "Title size — desktop", "min": 54, "max": 96, "step": 2, "unit": "px", "default": 68 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size — mobile", "min": 42, "max": 64, "step": 2, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Friday product" }]
}
{% endschema %}

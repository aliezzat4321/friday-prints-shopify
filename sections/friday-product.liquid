{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'FridayProductForm-' | append: section.id
  assign fp_size_option_position = 0
  assign fp_size_option_value_count = 0
  for option in product.options_with_values
    assign fp_option_name = option.name | downcase | strip
    if fp_option_name == 'size' or fp_option_name contains 'size'
      assign fp_size_option_position = option.position
      assign fp_size_option_value_count = option.values.size
      break
    endif
  endfor
  assign fp_has_size_selector = false
  if fp_size_option_position > 0 and fp_size_option_value_count > 1
    assign fp_has_size_selector = true
  endif
  assign can_add_cart = current_variant.available
  if current_variant == null
    assign can_add_cart = false
  endif
  assign add_to_cart_text = 'Add to cart'
  unless can_add_cart
    assign add_to_cart_text = 'Sold out'
  endunless

  assign description_plain = product.description | strip_html | strip
  assign fp_description_intro = description_plain | downcase | replace: '&nbsp;', ' ' | slice: 0, 180
  assign fp_show_unboxing = false
  if section.settings.show_unboxing
    if section.settings.unboxing_video != blank or section.settings.use_default_unboxing
      assign fp_show_unboxing = true
    endif
  endif
  assign fp_unboxing_poster_url = blank
  if section.settings.unboxing_poster != blank
    assign fp_unboxing_poster_url = section.settings.unboxing_poster | image_url: width: 900
  endif

  assign fp_size_label = blank
  if fp_size_option_position == 1
    assign fp_size_label = current_variant.option1
  elsif fp_size_option_position == 2
    assign fp_size_label = current_variant.option2
  elsif fp_size_option_position == 3
    assign fp_size_label = current_variant.option3
  endif
  if fp_size_label == blank
    assign fp_size_label = current_variant.metafields.custom.print_size.value | default: product.metafields.custom.print_size.value
  endif
  if fp_size_label == blank and current_variant.title != 'Default Title'
    assign fp_size_label = current_variant.title
  endif
  if fp_size_label == blank
    if product.handle contains '-a3'
      assign fp_size_label = 'A3'
    elsif product.handle contains '-a4'
      assign fp_size_label = 'A4'
    elsif product.handle contains 'postcard'
      assign fp_size_label = 'POSTCARD'
    elsif fp_size_option_position == 0 and fp_description_intro contains 'size: a3'
      assign fp_size_label = 'A3'
    elsif fp_size_option_position == 0 and fp_description_intro contains 'size: a4'
      assign fp_size_label = 'A4'
    else
      assign fp_size_label = 'ART PRINT'
    endif
  endif

  assign fp_dimension_label = current_variant.metafields.custom.print_dimensions.value | default: product.metafields.custom.print_dimensions.value
  assign fp_edition_total = current_variant.metafields.custom.edition_total.value | default: product.metafields.custom.edition_total.value
  assign fp_size_key = fp_size_label | downcase
  if fp_size_key contains 'a3'
    assign fp_dimension_label = fp_dimension_label | default: '29.7 × 42 CM'
    assign fp_edition_total = fp_edition_total | default: 100
  elsif fp_size_key contains 'a4'
    assign fp_dimension_label = fp_dimension_label | default: '21 × 29.7 CM'
    assign fp_edition_total = fp_edition_total | default: 150
  elsif fp_size_key contains 'postcard'
    assign fp_edition_total = fp_edition_total | default: 250
  endif
  assign fp_edition_total = fp_edition_total | plus: 0

  assign fp_next_edition = current_variant.metafields.custom.next_edition_number.value | default: product.metafields.custom.next_edition_number.value
  if fp_next_edition == blank and fp_edition_total > 0 and current_variant.inventory_management != blank
    assign fp_next_edition = fp_edition_total | minus: current_variant.inventory_quantity | plus: 1
  endif
  if fp_next_edition == blank and fp_edition_total > 0
    assign fp_next_edition = 1
  endif
  assign fp_next_edition = fp_next_edition | plus: 0
  if fp_next_edition < 1
    assign fp_next_edition = 1
  endif
  if fp_edition_total > 0 and fp_next_edition > fp_edition_total
    assign fp_next_edition = fp_edition_total
  endif
  assign fp_next_edition_padded = fp_next_edition | prepend: '00' | slice: -3, 3

  assign fp_edition_label = 'LIMITED NUMBERED EDITION'
  if fp_edition_total > 0
    assign fp_edition_label = 'EDITION OF ' | append: fp_edition_total
  endif

  assign fallback_collection = product.collections.first
  if fallback_collection == blank
    assign fallback_collection = collections['all']
  endif
%}

<section
  class="fp-pdp"
  id="FridayProduct-{{ section.id }}"
  style="--fp-pdp-bg:{{ section.settings.background_color }};--fp-pdp-panel:{{ section.settings.panel_color }};--fp-pdp-accent:{{ section.settings.accent_color }};--fp-pdp-unbox:{{ section.settings.unboxing_background }};--fp-pdp-title:{{ section.settings.title_size_desktop }}px;--fp-pdp-title-mobile:{{ section.settings.title_size_mobile }}px;"
>
  <style>
    #FridayProduct-{{ section.id }}{background:var(--fp-pdp-bg);color:var(--fp-ink);border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} *{box-sizing:border-box}
    body:has(#FridayProduct-{{ section.id }}) .fp-nav{height:96px}

    #FridayProduct-{{ section.id }} .fp-pdp__top{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(390px,.78fr);align-items:start;border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__gallery{min-width:0;padding:28px 34px 34px;border-right:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__back{display:inline-flex;align-items:center;gap:8px;margin:0 0 18px;color:inherit;text-decoration:none;font:700 10px/1 "Courier New",monospace;letter-spacing:.055em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__back:hover{text-decoration:underline;text-underline-offset:4px}
    #FridayProduct-{{ section.id }} .fp-pdp__media-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    #FridayProduct-{{ section.id }} .fp-pdp__media{position:relative;display:grid;place-items:center;min-width:0;overflow:hidden;background:transparent}
    #FridayProduct-{{ section.id }} .fp-pdp__media:first-child{grid-column:1/-1}
    #FridayProduct-{{ section.id }} .fp-pdp__media-button{position:relative;width:100%;min-height:0;padding:0;border:0;background:transparent;color:inherit;display:grid;place-items:center;cursor:zoom-in}
    #FridayProduct-{{ section.id }} .fp-pdp__media img,#FridayProduct-{{ section.id }} .fp-pdp__media svg{display:block;width:auto;max-width:100%;height:auto;max-height:min(70svh,760px);object-fit:contain}
    #FridayProduct-{{ section.id }} .fp-pdp__media:not(:first-child) img{max-height:500px}
    #FridayProduct-{{ section.id }} .fp-pdp__media video,#FridayProduct-{{ section.id }} .fp-pdp__media model-viewer{width:100%;height:auto;max-height:70svh}
    #FridayProduct-{{ section.id }} .fp-pdp__zoom-hint{position:absolute;right:10px;bottom:10px;padding:7px 9px;background:var(--fp-pdp-bg);border:1px solid var(--fp-ink);font:700 9px/1 "Courier New",monospace;text-transform:uppercase;letter-spacing:.05em;opacity:0;transform:translateY(5px);transition:opacity .18s ease,transform .18s ease}
    #FridayProduct-{{ section.id }} .fp-pdp__media-button:hover .fp-pdp__zoom-hint,#FridayProduct-{{ section.id }} .fp-pdp__media-button:focus-visible .fp-pdp__zoom-hint{opacity:1;transform:none}

    #FridayProduct-{{ section.id }} .fp-pdp__details{min-width:0;padding:46px 44px 42px;background:var(--fp-pdp-panel)}
    #FridayProduct-{{ section.id }} .fp-pdp__eyebrow{margin:0 0 15px;color:var(--fp-pdp-accent);font:700 10px/1 "Courier New",monospace;letter-spacing:.09em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__title{max-width:11ch;margin:0;font:700 clamp(52px,5vw,var(--fp-pdp-title))/.88 Georgia,"Times New Roman",serif;letter-spacing:-.052em;text-transform:lowercase;text-wrap:balance}
    #FridayProduct-{{ section.id }} .fp-pdp__price-row{display:flex;align-items:baseline;justify-content:space-between;gap:18px;margin:22px 0 0;padding-bottom:19px;border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__price{font:700 17px/1 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__edition{max-width:21ch;text-align:right;color:color-mix(in srgb,var(--fp-ink) 67%,transparent);font:10px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.045em}
    #FridayProduct-{{ section.id }} .fp-pdp__size-line{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--fp-line);font:700 10px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.045em}
    #FridayProduct-{{ section.id }} .fp-pdp__size-line span:last-child{text-align:right;color:color-mix(in srgb,var(--fp-ink) 65%,transparent)}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-preview{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;margin-top:18px;padding:15px 0 14px;border-top:1px solid var(--fp-ink);border-bottom:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-preview[hidden]{display:none}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-preview-copy{display:grid;gap:5px;min-width:0}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-preview-copy strong{font:700 9px/1.2 "Courier New",monospace;letter-spacing:.075em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-preview-copy small{max-width:34ch;color:color-mix(in srgb,var(--fp-ink) 63%,transparent);font:9px/1.35 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-number{display:flex;align-items:baseline;justify-content:flex-end;gap:4px;white-space:nowrap;font:700 34px/.9 Georgia,"Times New Roman",serif;letter-spacing:-.04em;color:var(--fp-pdp-accent)}
    #FridayProduct-{{ section.id }} .fp-pdp__edition-number small{font:700 13px/1 "Courier New",monospace;letter-spacing:0;color:var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__variants{margin-top:20px}
    #FridayProduct-{{ section.id }} .fp-pdp__variants-label{display:flex;justify-content:space-between;gap:16px;margin-bottom:10px;font:700 9px/1 "Courier New",monospace;letter-spacing:.065em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__variant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    #FridayProduct-{{ section.id }} .fp-pdp__variant{position:relative}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input{position:absolute;opacity:0;pointer-events:none}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label{min-height:46px;padding:9px 12px;border:1px solid var(--fp-ink);display:flex;align-items:center;justify-content:space-between;gap:10px;cursor:pointer;font:700 10px/1.2 "Courier New",monospace;text-transform:uppercase;transition:background .18s ease,color .18s ease,transform .18s ease}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label small{font-size:8px;opacity:.58}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input:checked+label{background:var(--fp-ink);color:#fff}
    #FridayProduct-{{ section.id }} .fp-pdp__variant input:focus-visible+label{outline:2px solid var(--fp-pdp-accent);outline-offset:3px}
    #FridayProduct-{{ section.id }} .fp-pdp__variant label:hover{transform:translateY(-1px)}
    #FridayProduct-{{ section.id }} .fp-pdp__buy{margin-top:12px}
    #FridayProduct-{{ section.id }} .fp-pdp__add{width:100%!important;min-height:56px!important;border:1px solid var(--fp-ink)!important;border-radius:0!important;background:var(--fp-ink)!important;color:#fff!important;box-shadow:none!important;font:700 12px/1 "Courier New",monospace!important;letter-spacing:.035em!important;text-transform:lowercase!important;transition:transform .18s ease,background-color .18s ease,color .18s ease!important}
    #FridayProduct-{{ section.id }} .fp-pdp__add:hover:not(:disabled){transform:translateY(-1px);background:var(--fp-pdp-accent)!important;border-color:var(--fp-pdp-accent)!important}
    #FridayProduct-{{ section.id }} .fp-pdp__add:disabled{background:color-mix(in srgb,var(--fp-ink) 30%,var(--fp-pdp-bg))!important;border-color:transparent!important;color:color-mix(in srgb,var(--fp-ink) 62%,#fff)!important;cursor:not-allowed}
    #FridayProduct-{{ section.id }} .fp-pdp__fineprint{margin:9px 0 0;text-align:center;font:9px/1.4 "Courier New",monospace;color:color-mix(in srgb,var(--fp-ink) 61%,transparent)}
    #FridayProduct-{{ section.id }} .fp-pdp__assurances{display:grid;grid-template-columns:repeat(3,1fr);margin-top:18px;border:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__assurance{min-height:53px;padding:10px 8px;display:grid;place-items:center;text-align:center;border-right:1px solid var(--fp-line);font:700 8.5px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.045em}
    #FridayProduct-{{ section.id }} .fp-pdp__assurance:last-child{border-right:0}
    #FridayProduct-{{ section.id }} .fp-pdp__payment{margin:11px 0 0;text-align:center;font:10px/1.4 "Courier New",monospace}

    #FridayProduct-{{ section.id }} .fp-pdp__below{border-top:0}
    #FridayProduct-{{ section.id }} .fp-pdp__about{display:grid;grid-template-columns:minmax(220px,.6fr) minmax(0,1.4fr);gap:72px;padding:54px 46px 50px;border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__section-label{margin:0;color:var(--fp-pdp-accent);font:700 10px/1 "Courier New",monospace;letter-spacing:.08em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__about h2,#FridayProduct-{{ section.id }} .fp-pdp__recommend h2{margin:8px 0 0;font:700 clamp(40px,4vw,58px)/.9 Georgia,"Times New Roman",serif;letter-spacing:-.045em;text-transform:lowercase}
    #FridayProduct-{{ section.id }} .fp-pdp__about-copy{max-width:70ch;font:14px/1.65 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__about-copy>p{margin:0}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes{margin-top:20px;border-top:1px solid var(--fp-ink);border-bottom:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes summary{min-height:46px;display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;list-style:none;font:700 9px/1 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes summary::-webkit-details-marker{display:none}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes summary:after{content:'+';font-size:15px;font-weight:400}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes[open] summary:after{content:'−'}
    #FridayProduct-{{ section.id }} .fp-pdp__full-notes .rte{padding:0 0 22px;font:12px/1.6 "Courier New",monospace}

    #FridayProduct-{{ section.id }} .fp-pdp__fact-band{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__fact{min-height:118px;padding:24px 26px;border-right:1px solid var(--fp-line);display:flex;flex-direction:column;justify-content:space-between;gap:16px}
    #FridayProduct-{{ section.id }} .fp-pdp__fact:last-child{border-right:0}
    #FridayProduct-{{ section.id }} .fp-pdp__fact small{font:700 9px/1 "Courier New",monospace;text-transform:uppercase;letter-spacing:.06em;color:color-mix(in srgb,var(--fp-ink) 60%,transparent)}
    #FridayProduct-{{ section.id }} .fp-pdp__fact strong{font:700 14px/1.35 "Courier New",monospace;text-transform:uppercase}

    #FridayProduct-{{ section.id }} .fp-pdp__info{display:grid;grid-template-columns:minmax(240px,.6fr) minmax(0,1.4fr);gap:72px;padding:46px;border-bottom:1px solid var(--fp-line)}
    #FridayProduct-{{ section.id }} .fp-pdp__accordions{border-top:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion{border-bottom:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary{min-height:50px;display:flex;align-items:center;justify-content:space-between;gap:15px;cursor:pointer;list-style:none;font:700 10px/1 "Courier New",monospace;letter-spacing:.06em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary::-webkit-details-marker{display:none}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion summary:after{content:'+';font-size:16px;font-weight:400}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion[open] summary:after{content:'−'}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content{padding:0 0 20px;max-width:70ch;font:12px/1.6 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content p{margin:0 0 8px}
    #FridayProduct-{{ section.id }} .fp-pdp__accordion-content p:last-child{margin-bottom:0}
    #FridayProduct-{{ section.id }} .fp-pdp__support{margin:20px 0 0;font:10px/1.5 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__support a{color:inherit;text-underline-offset:3px;overflow-wrap:anywhere}
    #FridayProduct-{{ section.id }} .fp-pdp__live{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

    #FridayProduct-{{ section.id }} .fp-pdp__unbox{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.55fr);gap:clamp(44px,7vw,110px);align-items:center;padding:clamp(54px,6vw,90px) clamp(30px,5vw,72px);overflow:hidden;background:var(--fp-pdp-unbox);border-top:1px solid var(--fp-ink);border-bottom:1px solid var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox:after{content:'✦';position:absolute;right:5vw;top:44px;color:var(--fp-pdp-accent);font:48px/1 Georgia,serif;transform:rotate(12deg)}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-copy{position:relative;z-index:1;max-width:650px}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox h2{max-width:8ch;margin:9px 0 0;font:700 clamp(54px,6.2vw,92px)/.84 Georgia,"Times New Roman",serif;letter-spacing:-.058em;text-transform:lowercase;text-wrap:balance}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-text{max-width:43ch;margin:27px 0 0;font:13px/1.65 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-note{display:flex;align-items:center;gap:11px;margin:31px 0 0;padding-top:16px;border-top:1px solid color-mix(in srgb,var(--fp-ink) 45%,transparent);font:700 9px/1.35 "Courier New",monospace;letter-spacing:.055em;text-transform:uppercase}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-note:before{content:'↘';color:var(--fp-pdp-accent);font-size:18px}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-media{position:relative;z-index:1;justify-self:end;width:min(100%,430px);margin:0}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-frame{position:relative;aspect-ratio:9/16;overflow:hidden;background:var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-frame video{display:block;width:100%;height:100%;object-fit:cover;background:var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-stamp{position:absolute;left:-35px;top:42px;z-index:2;display:grid;place-items:center;width:82px;height:82px;padding:10px;border-radius:50%;background:var(--fp-pdp-accent);color:#fff;text-align:center;font:700 9px/1.25 "Courier New",monospace;letter-spacing:.04em;text-transform:uppercase;transform:rotate(-9deg);pointer-events:none}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-caption{display:flex;justify-content:space-between;gap:18px;margin-top:10px;padding-top:12px;border-top:1px solid var(--fp-ink);font:700 9px/1.35 "Courier New",monospace;text-transform:uppercase;letter-spacing:.045em}
    #FridayProduct-{{ section.id }} .fp-pdp__unbox-caption span:last-child{color:var(--fp-pdp-accent)}

    #FridayProduct-{{ section.id }} .fp-pdp__recommend{padding:46px 46px 58px;background:var(--fp-pdp-panel)}
    #FridayProduct-{{ section.id }} .fp-pdp__recommend-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:26px}
    #FridayProduct-{{ section.id }} .fp-pdp__recommend-all{color:inherit;text-decoration:none;font:700 10px/1 "Courier New",monospace;text-transform:uppercase;letter-spacing:.055em}
    #FridayProduct-{{ section.id }} .fp-pdp__recommend-all:hover{text-decoration:underline;text-underline-offset:4px}
    #FridayProduct-{{ section.id }} .fp-pdp__recommend-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
    #FridayProduct-{{ section.id }} .fp-pdp-rec{color:inherit;text-decoration:none;min-width:0}
    #FridayProduct-{{ section.id }} .fp-pdp-rec__media{aspect-ratio:.707;display:grid;place-items:center;overflow:hidden}
    #FridayProduct-{{ section.id }} .fp-pdp-rec__media img{width:100%;height:100%;object-fit:contain;transition:transform .28s ease}
    #FridayProduct-{{ section.id }} .fp-pdp-rec:hover .fp-pdp-rec__media img{transform:scale(1.012)}
    #FridayProduct-{{ section.id }} .fp-pdp-rec__meta{display:flex;justify-content:space-between;gap:12px;padding-top:10px;font:700 10px/1.35 "Courier New",monospace;text-transform:lowercase}
    #FridayProduct-{{ section.id }} .fp-pdp-rec__price{font-weight:400;white-space:nowrap}

    #FridayProduct-{{ section.id }} .fp-pdp__lightbox{width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:var(--fp-pdp-bg);color:var(--fp-ink)}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox::backdrop{background:rgba(20,16,13,.66)}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox-inner{position:relative;width:100%;height:100%;display:grid;place-items:center;padding:48px 78px}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox img{display:block;max-width:100%;max-height:calc(100dvh - 96px);width:auto;height:auto;object-fit:contain}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox-close,#FridayProduct-{{ section.id }} .fp-pdp__lightbox-nav{position:absolute;z-index:2;border:1px solid var(--fp-ink);background:var(--fp-pdp-bg);color:inherit;width:42px;height:42px;display:grid;place-items:center;cursor:pointer;font:18px/1 "Courier New",monospace}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox-close{top:20px;right:20px}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox-prev{left:20px;top:50%;transform:translateY(-50%)}
    #FridayProduct-{{ section.id }} .fp-pdp__lightbox-next{right:20px;top:50%;transform:translateY(-50%)}

    #FridayProduct-{{ section.id }} .fp-pdp__mobile-buybar{display:none}

    @media(max-width:1100px) and (min-width:900px){
      #FridayProduct-{{ section.id }} .fp-pdp__top{grid-template-columns:minmax(0,1.05fr) minmax(390px,.95fr)}
      #FridayProduct-{{ section.id }} .fp-pdp__gallery{padding:24px 26px 30px}
      #FridayProduct-{{ section.id }} .fp-pdp__details{padding:36px 30px 34px}
      #FridayProduct-{{ section.id }} .fp-pdp__title{font-size:clamp(48px,5.4vw,62px)}

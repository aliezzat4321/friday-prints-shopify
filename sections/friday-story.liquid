<section class="fp-section fp-story" id="FridayStory-{{ section.id }}">
  <span class="fp-story__deco fp-story__deco--a" aria-hidden="true">✿</span><span class="fp-story__deco fp-story__deco--b" aria-hidden="true">✿</span><span class="fp-story__deco fp-story__deco--c" aria-hidden="true">✦</span>
  <div class="fp-shell fp-story__grid">
    <div class="fp-story__copy">
      <h2 class="fp-story__title">{{ section.settings.heading }}</h2>
      <div class="fp-story__text">{{ section.settings.story }}</div>
    </div>
    <div class="fp-story__mark">
      <div class="fp-story__oval"><img class="fp-story__gigi" src="{{ 'friday-gigi-nav.png' | asset_url }}" alt="GiGi" width="118" height="220" loading="lazy"></div>
      <div class="fp-story__handle">{{ section.settings.handle }}</div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Friday story","settings":[{"type":"text","id":"heading","label":"Heading","default":"the story"},{"type":"richtext","id":"story","label":"Story","default":"<p>friday prints began in Cairo on a quiet Friday night.</p><p>GiGi was created as a way to personify friends, their moods, quirks and adventures. Over time she became a character of her own, travelling through imagined worlds and collecting stories along the way.</p><p>Along the way she meets new friends, unexpected companions and curious characters, each bringing their own stories to the journey.</p><p>These prints are small fragments of that world.</p>"},{"type":"text","id":"handle","label":"Instagram handle","default":"@fridayprints.art"}],"presets":[{"name":"Friday story"}]}
{% endschema %}
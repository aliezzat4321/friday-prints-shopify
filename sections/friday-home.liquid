{{ 'friday-home.css' | asset_url | stylesheet_tag }}

{% assign fp_collection = section.settings.collection | default: collections.all %}
{% assign fp_first_product = fp_collection.products.first %}

<section class="fpw" id="FridayHome-{{ section.id }}">
  <div class="fpw-announcement">✦ {{ section.settings.announcement }} ✦</div>

  <header class="fpw-nav" aria-label="Friday Prints navigation">
    <a class="fpw-brand" href="{{ routes.root_url }}" aria-label="Friday Prints home">
      <span>friday</span><span>prints.art</span>
    </a>

    <nav class="fpw-nav__links" aria-label="Main navigation">
      <a class="is-active" href="{{ routes.root_url }}">home</a>
      <a href="{{ routes.all_products_collection_url }}">collections</a>
      <a href="/pages/about">about</a>
      <a href="/pages/info">info</a>
      <a href="/pages/faq">faq</a>
      <a href="/pages/contact">contact</a>
    </nav>

    <div class="fpw-nav__actions">
      <img class="fpw-nav__gigi" src="{{ 'friday-gigi-icon.svg' | asset_url }}" alt="" width="28" height="42">
      {% if section.settings.instagram_url != blank %}
        <a class="fpw-icon-link" href="{{ section.settings.instagram_url }}" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill"/></svg>
        </a>
      {% endif %}
      <a class="fpw-cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span>{{ cart.item_count }}</span>
      </a>
      <details class="fpw-mobile-menu">
        <summary aria-label="Open menu"><span></span><span></span></summary>
        <div class="fpw-mobile-menu__panel">
          <a href="{{ routes.all_products_collection_url }}">shop prints</a>
          <a href="{{ routes.collections_url }}">collections</a>
          <a href="/pages/about">about</a>
          <a href="/pages/info">info</a>
          <a href="/pages/faq">faq</a>
          <a href="/pages/contact">contact</a>
        </div>
      </details>
    </div>
  </header>

  <section class="fpw-hero">
    <div class="fpw-hero__copy">
      <p class="fpw-kicker">{{ section.settings.hero_kicker }}</p>
      <h1>{{ section.settings.hero_title_line_1 }}<br><em>{{ section.settings.hero_title_line_2 }}</em></h1>
      <p class="fpw-hero__sub">{{ section.settings.hero_subtitle }}</p>
      <div class="fpw-actions">
        <a class="fpw-button fpw-button--solid" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }}</a>
        <a class="fpw-button fpw-button--outline" href="{{ section.settings.collection_link | default: routes.collections_url }}">{{ section.settings.collection_label }}</a>
      </div>
    </div>

    <div class="fpw-hero__scene">
      <div class="fpw-frame">
        {% if section.settings.hero_artwork != blank %}
          {{ section.settings.hero_artwork | image_url: width: 1300 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1300', sizes: '(max-width: 749px) 74vw, 38vw', class: 'fpw-frame__image' }}
        {% elsif fp_first_product != blank and fp_first_product.featured_image != blank %}
          {{ fp_first_product.featured_image | image_url: width: 1300 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1300', sizes: '(max-width: 749px) 74vw, 38vw', class: 'fpw-frame__image' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'fpw-frame__placeholder' }}
        {% endif %}
      </div>

      {% if section.settings.vase_image != blank %}
        {{ section.settings.vase_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '240,360,480,720', sizes: '(max-width: 749px) 32vw, 18vw', class: 'fpw-vase' }}
      {% endif %}

      {% if section.settings.teabag_image != blank %}
        {{ section.settings.teabag_image | image_url: width: 380 | image_tag: loading: 'lazy', widths: '160,240,380', sizes: '11vw', class: 'fpw-teabag fpw-teabag--hero' }}
      {% endif %}

      <div class="fpw-limited-badge">LIMITED<br><span>✶</span><br>EDITIONS</div>
    </div>
  </section>

  <section class="fpw-story">
    <div class="fpw-story__copy">
      <p class="fpw-script">the story</p>
      <div class="fpw-story__text">{{ section.settings.story_text }}</div>
      <a class="fpw-text-link" href="/pages/about">read the full story →</a>
    </div>
    <div class="fpw-story__mark">
      <div class="fpw-story__oval"><img src="{{ 'friday-gigi-icon.svg' | asset_url }}" alt="GiGi" width="140" height="210"></div>
      <span>@fridayprints.art</span>
    </div>
    {% if section.settings.teabag_image != blank %}
      {{ section.settings.teabag_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,360,480', sizes: '(max-width: 749px) 28vw, 12vw', class: 'fpw-teabag fpw-teabag--story' }}
    {% endif %}
  </section>

  <section class="fpw-benefits" aria-label="Why Friday Prints">
    <article><div class="fpw-benefit-icon">✹</div><h3>LIMITED EDITIONS</h3><p>Each print is part of a limited numbered run.</p></article>
    <article><div class="fpw-benefit-icon">✌</div><h3>MADE TO ORDER</h3><p>Printed especially for you, with care.</p></article>
    <article><div class="fpw-benefit-icon">♥</div><h3>MADE IN EGYPT</h3><p>Locally printed. Thoughtfully packaged.</p></article>
    <article><div class="fpw-benefit-icon">▣</div><h3>MADE TO LAST</h3><p>Premium matte paper with a removable mount.</p></article>
  </section>

  <section class="fpw-collection">
    <div class="fpw-collection__heading">
      <span class="fpw-script">the collection</span>
      <h2>{{ section.settings.collection_heading }}</h2>
    </div>

    <div class="fpw-product-rail" data-fpw-rail>
      {% if fp_collection != blank and fp_collection.products_count > 0 %}
        {% for product in fp_collection.products limit: 8 %}
          <a class="fpw-product" href="{{ product.url }}">
            <div class="fpw-product__image">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240,360,540,720', sizes: '(max-width: 749px) 64vw, 16vw' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <h3>{{ product.title }}</h3>
            <p>{{ product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <div class="fpw-product fpw-product--placeholder">
            <div class="fpw-product__image">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <h3>Friday Print {{ i }}</h3><p>Coming soon</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="fpw-collection__actions">
      <a class="fpw-button fpw-button--green" href="{{ fp_collection.url | default: routes.all_products_collection_url }}">view all prints</a>
      <div class="fpw-rail-buttons"><button type="button" data-fpw-prev aria-label="Previous prints">←</button><button type="button" data-fpw-next aria-label="Next prints">→</button></div>
    </div>
  </section>

  <section class="fpw-service-row">
    <article><span>🚚</span><div><h3>DELIVERY ACROSS EGYPT</h3><p>Standard delivery across Egypt.</p></div></article>
    <article><span>🎁</span><div><h3>PERFECT FOR GIFTING</h3><p>Wrap happiness. It suits every wall.</p></div></article>
    <article><span>✉</span><div><h3>YOU'VE GOT MAIL</h3><p>Carefully packed prints, on their way to you.</p></div></article>
    <article><span>●</span><div><h3>HERE TO HELP</h3><p>Questions? Just send us a message.</p></div></article>
  </section>

  <section class="fpw-newsletter">
    <div><span>new drops, stories &amp; places</span><strong>GiGi’s been.</strong></div>
    {% form 'customer', class: 'fpw-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="your email" aria-label="Email address" required>
      <button type="submit">join the journey →</button>
    {% endform %}
  </section>

  <footer class="fpw-footer">
    <div class="fpw-footer__brand"><strong>friday<br>prints</strong><small>prints.art</small></div>
    <div><strong>shop</strong><a href="{{ routes.all_products_collection_url }}">all prints</a><a href="{{ routes.collections_url }}">collections</a></div>
    <div><strong>info</strong><a href="/pages/about">about</a><a href="/pages/info">print details</a><a href="/pages/faq">faq</a></div>
    <div><strong>help</strong><a href="/pages/contact">contact</a><a href="/pages/shipping">shipping &amp; delivery</a></div>
    <div class="fpw-footer__mark"><img src="{{ 'friday-gigi-icon.svg' | asset_url }}" alt="" width="34" height="52"><span>made in Cairo, Egypt</span></div>
  </footer>
</section>

<script>
  (() => {
    const root = document.getElementById('FridayHome-{{ section.id }}');
    if (!root) return;
    const rail = root.querySelector('[data-fpw-rail]');
    const prev = root.querySelector('[data-fpw-prev]');
    const next = root.querySelector('[data-fpw-next]');
    if (!rail || !prev || !next) return;
    const distance = () => Math.max(260, rail.clientWidth * 0.72);
    prev.addEventListener('click', () => rail.scrollBy({ left: -distance(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: distance(), behavior: 'smooth' }));
  })();
</script>

{% schema %}
{
  "name": "Friday Prints home",
  "tag": "section",
  "class": "fpw-shopify-section",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "LIMITED EDITION ART PRINTS, MADE TO ORDER IN EGYPT" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "hero_kicker", "label": "Hero kicker", "default": "welcome to" },
    { "type": "text", "id": "hero_title_line_1", "label": "Hero title line 1", "default": "GiGi’s" },
    { "type": "text", "id": "hero_title_line_2", "label": "Hero title line 2", "default": "journey" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle", "default": "Art prints made for long weekends & loud lines." },
    { "type": "text", "id": "shop_label", "label": "Shop button label", "default": "shop prints" },
    { "type": "url", "id": "shop_link", "label": "Shop button link" },
    { "type": "text", "id": "collection_label", "label": "Collection button label", "default": "explore the collection" },
    { "type": "url", "id": "collection_link", "label": "Collection button link" },
    { "type": "image_picker", "id": "hero_artwork", "label": "Hero framed artwork" },
    { "type": "image_picker", "id": "vase_image", "label": "Amina vase artwork / photo" },
    { "type": "image_picker", "id": "teabag_image", "label": "Amina tea bag artwork" },
    { "type": "richtext", "id": "story_text", "label": "Story", "default": "<p>Friday Prints began in Cairo on a quiet Friday night.</p><p>GiGi was created as a way to personify friends, their moods, quirks and adventures. Over time she became a character of her own, travelling through imagined worlds and collecting stories along the way.</p><p>These prints are small fragments of that world.</p>" },
    { "type": "collection", "id": "collection", "label": "Homepage collection" },
    { "type": "text", "id": "collection_heading", "label": "Collection heading", "default": "the collection" }
  ],
  "presets": [{ "name": "Friday Prints home" }]
}
{% endschema %}